{
  "name": "esphome-lvgl-editor",
  "version": "1.0.0",
  "description": "Visual GUI IDE for editing ESPHome LVGL YAML files",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "roundtrip:check": "tsc scripts/roundtrip-check.ts --module commonjs --target es2020 --esModuleInterop --skipLibCheck --outDir .tmp-roundtrip && node .tmp-roundtrip/scripts/roundtrip-check.js",
    "fixtures:check": "tsc scripts/test-fixtures.ts --module commonjs --target es2020 --esModuleInterop --skipLibCheck --outDir .tmp-fixtures && node .tmp-fixtures/scripts/test-fixtures.js",
    "backend:check": "node scripts/test-backend.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "js-yaml": "^4.1.0",
    "@monaco-editor/react": "^4.6.0",
    "lucide-react": "^0.294.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
