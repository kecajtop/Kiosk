def make_backup():
    import io
    import tarfile
    buf = io.BytesIO()
    fw = bool(qrun(["iptables", "-S", "OUTPUT"]).count("--match-set kiosk_"))
    manifest = {"version": pkg_version(), "host": os.uname().nodename,
                "date": time.strftime("%Y-%m-%d %H:%M:%S"), "firewall": fw}
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        data = json.dumps(manifest, ensure_ascii=False, indent=1).encode()
        ti = tarfile.TarInfo("manifest.json")
        ti.size, ti.mtime = len(data), int(time.time())
        tar.addfile(ti, io.BytesIO(data))
        for name in BACKUP_FILES:
            p = os.path.join(ETC, name)
            if os.path.isfile(p):
                tar.add(p, arcname=name)
    return buf.getvalue()


def restore_backup(blob):
    import io
    import tarfile
    try:
        tar = tarfile.open(fileobj=io.BytesIO(blob), mode="r:gz")
    except Exception:
        raise ValueError("to nie jest plik kopii kiosku (.tar.gz)")
    files, manifest = {}, {}
    for m in tar.getmembers():
        if not m.isfile() or "/" in m.name or m.size > 2_000_000:
            continue
        if m.name == "manifest.json":
            manifest = json.loads(tar.extractfile(m).read() or b"{}")
        elif m.name in BACKUP_FILES:
            files[m.name] = tar.extractfile(m).read()
    if "kiosk.conf" not in files:
        raise ValueError("w kopii brakuje kiosk.conf — to nie jest kopia ustawień kiosku")
    me = read_conf()["user"]
    restored = []
    for name, data in files.items():
        if name == "kiosk.conf":
            m = re.search(rb"^KIOSK_USER='?([A-Za-z0-9._-]+)'?$", data, re.M)
            if m and subprocess.run(["id", m.group(1).decode()], capture_output=True).returncode != 0 and me:
                data = re.sub(rb"^KIOSK_USER=.*$", ("KIOSK_USER=%s" % shlex.quote(me)).encode(), data, flags=re.M)
        path = os.path.join(ETC, name)
        mode = 0o600 if name.endswith(".json") and name not in ("ticker.json",) else 0o644
        if name in ("kiosk.conf", "second.conf"):
            mode = 0o640
        tmp = path + ".restore"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, mode)
        if mode == 0o640:
            try:
                import grp
                os.chown(tmp, 0, grp.getgrnam(read_conf()["user"] or me).gr_gid)
            except Exception:
                pass
        os.replace(tmp, path)
        restored.append(name)
    user = read_conf()["user"]
    steps = []
    if "session.conf" in files and user:
        sess = "desktop" if b"KIOSK_SESSION=desktop" in files["session.conf"] else "kiosk"
        steps.append("/usr/local/sbin/kiosk-session-mode %s %s" % (sess, shlex.quote(user)))
    if "boot.conf" in files:
        steps.append("/usr/local/sbin/kiosk-bootlogo %s" % ("off" if b"=off" in files["boot.conf"] else "on"))
    steps.append("/usr/local/sbin/kiosk-firewall %s" % ("on" if manifest.get("firewall") else "off"))
    steps.append(KIOSK_MODE + " reload")
    steps.append("systemctl restart kiosk-dlna kiosk-api")
    script = "sleep 2; " + "; ".join(s + " || true" for s in steps)
    subprocess.run(["systemd-run", "--unit", "kiosk-restore-%d" % int(time.time()), "--collect", "/bin/sh", "-c", script],
                   capture_output=True, timeout=20)
    return "Przywrócono %d plików (%s)%s. Panel uruchomi się ponownie za kilka sekund." % (
        len(restored), ", ".join(sorted(restored)),
        "; kopia z %s, %s" % (manifest.get("host", "?"), manifest.get("date", "?")) if manifest else "")


def read_updates():
    vals = {"UPDATE_URL": "", "UPDATE_AUTO": "no"}
    script = ". " + shlex.quote(UPDATES_CONF) + " >/dev/null 2>&1; printf '%s\\0%s' \"$UPDATE_URL\" \"$UPDATE_AUTO\""
    if os.path.exists(UPDATES_CONF):
        out = subprocess.run(["sh", "-c", script], capture_output=True, text=True, timeout=5).stdout.split("\0")
        if len(out) == 2:
            vals = {"UPDATE_URL": out[0], "UPDATE_AUTO": out[1] or "no"}
