def screenshot_jpeg(max_w=1280, quality=72):
    """Zrzut ekranu kiosku (w trybie z pulpitem tylko monitor kiosku — pulpit zostaje prywatny)."""
    user = read_conf()["user"]
    if not user:
        raise RuntimeError("brak KIOSK_USER")
    args = ["import", "-silent", "-window", "root"]
    if session_mode() == "desktop":
        area = display_areas().get("main_area", "")
        if not area:
            raise RuntimeError("monitor kiosku jest odłączony albo wyłączony")
        args += ["-crop", area, "+repage"]
    args += ["-resize", "%dx%d>" % (max_w, max_w), "-quality", str(quality), "jpg:-"]
    r = subprocess.run(["runuser", "-u", user, "--", "env", "DISPLAY=:0", "XAUTHORITY=%s/.Xauthority" % user_home()] + args,
                       capture_output=True, timeout=20)
    if r.returncode != 0 or not r.stdout:
        raise RuntimeError("zrzut ekranu: " + r.stderr.decode("utf-8", "replace").strip()[-200:])
    return r.stdout


