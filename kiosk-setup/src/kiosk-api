class Automation:
    """Wątek w tle: harmonogram (co 15 s), obecność z HA (co 3 s), tekst paska (co 60 s)."""

    def __init__(self):
        self.fired = set()
        self.last_seen = time.time()
        self.presence_off = False
        self.presence_state = ""
        self.presence_error = ""
        self.message = ""
        self.message_until = 0
        self.ticker_error = ""
        self.last_ticker = 0
        self.night_active = False
        self.night_force = None        # None = wg godzin, True/False = wymuszone (MQTT/HA)
        self.sun_last_pct = None
        self.sun_error = ""
        self.rot_idx = -1
        self.rot_next = 0
        self.agenda = []
        self.agenda_error = ""
        self.last_agenda = 0
        self.problems = {}
        self.last_watch = 0
        self.watch_count = {}
        self.wake = threading.Event()
        threading.Thread(target=self._loop, daemon=True).start()

    def info(self):
        return {"presence": {"state": self.presence_state, "screen_off_by_presence": self.presence_off,
                             "error": self.presence_error},
                "ticker": {"message": self.message if time.time() < self.message_until else "", "error": self.ticker_error,
                           "text": self._read_text()},
                "night": {"active": self.night_active, "forced": self.night_force},
                "sun": {"value": self.sun_last_pct, "error": self.sun_error},
                "agenda": {"events": self.agenda, "error": self.agenda_error},
                "problems": self.problems, "override": OVR.current()}

    @staticmethod
    def _read_text():
        try:
            with open(TICKER_TEXT) as f:
                return f.read().strip()
        except OSError:
            return ""

    def set_message(self, body):
        if isinstance(body, str):
            body = {"text": body}
        txt = str(body.get("text", "")).strip()
        if len(txt) > 300:
            raise ValueError("komunikat paska: do 300 znaków")
        minutes = to_int(body.get("minutes", 30), 1, 1440, "minutes")
        self.message, self.message_until = txt, (time.time() + minutes * 60 if txt else 0)
        self.last_ticker = 0
        self.wake.set()
        return ("Pasek: „%s” przez %d min" % (txt[:60], minutes)) if txt else "Pasek: komunikat usunięty"

    def presence_event(self, on):
        """Obecność z MQTT (presence/set ON/OFF) albo z encji HA."""
        if on:
            self.last_seen = time.time()
            if self.presence_off:
                self.presence_off = False
                try:
                    if OVR.photos:
                        OVR.photos = False
                        OVR.update()
                    else:
                        power("screen", "on")
                    log("obecność: ktoś jest — zwykły ekran")
                except Exception as e:
                    log("obecność: %s" % e)
        self.presence_state = "on" if on else "off"

    def _loop(self):
        while True:
            try:
                self._schedule()
            except Exception as e:
                log("harmonogram: %s" % e)
            try:
                self._presence()
            except Exception as e:
                self.presence_error = str(e)
            for step in (self._night, self._rotation, self._sun):
                try:
                    step()
                except Exception as e:
                    log("automatyka: %s" % e)
            if time.time() - self.last_agenda > 300:
                self.last_agenda = time.time()
                try:
                    self._agenda()
                except Exception as e:
                    self.agenda_error = str(e)
            if time.time() - self.last_watch > 60:
                self.last_watch = time.time()
                try:
                    self._watchdog()
                except Exception as e:
                    log("powiadomienia: %s" % e)
            if time.time() - self.last_ticker > 60:
                self.last_ticker = time.time()
                try:
                    self._ticker()
                except Exception as e:
                    self.ticker_error = str(e)
            self.wake.wait(3)
            self.wake.clear()

    def _night(self):
        n = read_night()
        want = self.night_force if self.night_force is not None else (n["enabled"] and in_window(n["from"], n["to"]))
        if want == self.night_active and OVR.night_clock == (want and n["clock_only"]):
            return
        self.night_active = want
        OVR.night_clock = bool(want and n["clock_only"])
        if want and OVR.photos:
            OVR.photos = False
        OVR.update()
        try:
            BRIGHT.set(n["brightness"] if want else read_bright()["day"])
        except Exception as e:
            log("noc: jasność: %s" % e)
        log("tryb nocny: " + ("włączony" if want else "wyłączony"))

    def _sun(self):
        s = read_sun()
        if not s["enabled"] or self.night_active or OVR.current():
            return
        try:
            el, src = current_sun_elevation()
            pct = sun_brightness_pct(el, s["min"], s["max"])
            self.sun_error = ""
        except Exception as e:
            if str(e) != self.sun_error:
                log("jasność wg słońca: %s" % e)
            self.sun_error = str(e)
            return
        if self.sun_last_pct is None or abs(pct - self.sun_last_pct) >= 3:
            try:
                BRIGHT.set(pct)
                self.sun_last_pct = pct
            except Exception as e:
                log("jasność wg słońca: %s" % e)

    def _rotation(self):
        r = read_rotation()
        views = [v for v in r["views"] if v in read_views()]
        if not r["enabled"] or not views or OVR.current() or self.presence_off:
            return
        if time.time() < self.rot_next:
            return
        self.rot_next = time.time() + max(10, r["seconds"])
        self.rot_idx = (self.rot_idx + 1) % len(views)
        apply_view(views[self.rot_idx])

    def _agenda(self):
        cfg = read_calendar()
        if not cfg["enabled"] or not (cfg["entities"] or cfg["ics_urls"]):
            self.agenda = []
            if os.path.exists(AGENDA_JSON):
                os.unlink(AGENDA_JSON)
            return
        self.agenda = fetch_agenda(cfg)
        self.agenda_error = ""
        tmp = AGENDA_JSON + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"events": self.agenda, "updated": hm_now()}, f, ensure_ascii=False)
        os.chmod(tmp, 0o644)
        os.replace(tmp, AGENDA_JSON)
        self.last_ticker = 0

    def _watchdog(self):
        cfg = read_notify()
        if not cfg["enabled"] and not cfg["temp_limit"]:
            self.problems = {}
            return
        c = read_conf()
        sens = system_sensors()
        checks = {
            "x": (not bool(pids("Xorg") or pids("X")), "ekran kiosku (serwer X) nie działa"),
            "cams": (c["mode"] in ("rtsp", "mix") and not OVR.current() and len(pids("mpv")) < len(c["cameras"]),
                     "nie wszystkie kamery są na ekranie (%d z %d)" % (len(pids("mpv")), len(c["cameras"]))),
            "disk": ((sens.get("disk_free_gb") or 99) < 1, "mało miejsca na dysku: %s GB" % sens.get("disk_free_gb")),
            "mem": ((sens.get("mem_free_mb") or 9999) < 150, "mało wolnej pamięci: %s MB" % sens.get("mem_free_mb")),
            "temp": (bool(cfg["temp_limit"]) and (sens.get("cpu_temp") or 0) >= cfg["temp_limit"],
                     "temperatura %s°C (limit %d°C)" % (sens.get("cpu_temp"), cfg["temp_limit"] or 0)),
            "mqtt": (read_mqtt_conf()["enabled"] and BRIDGE is not None and not BRIDGE.connected, "brak połączenia MQTT z HA"),
        }
        for key, (bad, msg) in checks.items():
            n = self.watch_count.get(key, 0) + 1 if bad else 0
            self.watch_count[key] = n
            if n >= 3 and key not in self.problems:          # 3 minuty z rzędu
                self.problems[key] = msg
                log("problem: " + msg)
                if cfg["enabled"]:
                    try:
                        ha_notify("⚠ Kiosk %s" % kiosk_name(), msg)
                    except Exception as e:
                        log("powiadomienie: %s" % e)
                if key == "temp" and cfg["temp_limit"]:
                    log("przegrzanie — wyłączam komputer")
                    try:
                        power("shutdown", "0")
                    except Exception as e:
                        log("przegrzanie: %s" % e)
            elif n == 0 and key in self.problems:
                del self.problems[key]
                if cfg["enabled"]:
                    try:
                        ha_notify("✓ Kiosk %s" % kiosk_name(), "w porządku: " + msg.split(":")[0])
                    except Exception as e:
                        log("powiadomienie: %s" % e)

    def _schedule(self):
        s = read_schedule()
        if not s["enabled"]:
            return
        t = time.localtime()
        hm, day, today = time.strftime("%H:%M", t), t.tm_wday, time.strftime("%Y-%m-%d", t)
        for i, it in enumerate(s["items"]):
            key = "%s %s %d %s" % (today, hm, i, it.get("action"))
            if it.get("time") == hm and day in it.get("days", []) and key not in self.fired:
                self.fired.add(key)
                try:
                    out = run_schedule_item(it)
                    log("harmonogram %s: %s" % (hm, str(out)[:120]))
                except Exception as e:
                    log("harmonogram %s: %s" % (hm, e))
        if len(self.fired) > 500:
            self.fired = {k for k in self.fired if k.startswith(today)}

    def _presence(self):
        p = read_presence()
        if not p["enabled"]:
            self.presence_error = ""
            return
        if p["entity"]:
            st = ha_state(p["entity"]).get("state", "")
            self.presence_error = ""
            self.presence_event(st in ("on", "home", "detected", "occupied", "true"))
        if not self.presence_off and time.time() - self.last_seen > p["off_minutes"] * 60:
            self.presence_off = True
            try:
                if p["on_absence"] == "photos" and list_photos() and not self.night_active:
                    OVR.photos = True
                    OVR.update()
                    log("obecność: nikogo od %d min — zdjęcia" % p["off_minutes"])
                else:
                    power("screen", "off")
                    log("obecność: nikogo od %d min — ekran wyłączony" % p["off_minutes"])
            except Exception as e:
                log("obecność: %s" % e)

    def _ticker(self):
        cfg = read_ticker()
        if not cfg["enabled"]:
            return
        parts = []
        if self.message and time.time() < self.message_until:
            parts.append("⚠ " + self.message)
        parts += cfg["items"]
        if read_calendar()["ticker"]:
            for e in self.agenda[:4]:
                parts.append("📅 %s%s %s" % (e["when"], (" " + e["time"]) if e["time"] else "", e["summary"]))
        if cfg["weather"] and WEATHER and WEATHER.current and WEATHER.current.get("temp") is not None:
            w = WEATHER.current
            parts.append("Pogoda: %d°C, %s" % (round(w["temp"]), w.get("text", "")))
        err = ""
        for e in cfg["entities"]:
            try:
                s = ha_state(e)
                a = s.get("attributes", {})
                parts.append("%s: %s%s" % (a.get("friendly_name", e), s.get("state", "?"),
                                           (" " + a["unit_of_measurement"]) if a.get("unit_of_measurement") else ""))
            except Exception as ex:
                err = "encje HA: %s" % ex
        self.ticker_error = err
        text = "     •     ".join(x.strip() for x in parts if x.strip()) or time.strftime("%H:%M")
        if text != self._read_text():
            tmp = TICKER_TEXT + ".tmp"
            with open(tmp, "w") as f:
                f.write(text + "\n")
            os.chmod(tmp, 0o644)
            os.replace(tmp, TICKER_TEXT)


