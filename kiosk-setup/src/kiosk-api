CONF_KEYS = ("KIOSK_USER", "KIOSK_MODE", "KIOSK_URL", "KIOSK_RTSP_URLS", "KIOSK_USB_DEVICE",
             "KIOSK_WEB_PERCENT", "KIOSK_SCREEN_OFF_MIN", "KIOSK_SHUTDOWN_MIN",
             "KIOSK_CLOCK", "KIOSK_CLOCK_POS", "KIOSK_CLOCK_SIZE")


def read_conf():
    """kiosk.conf czytany przez sh (to on rozumie cytowanie), nigdy wykonywany tutaj."""
    script = ". " + shlex.quote(CONF) + " >/dev/null 2>&1; " + "; ".join(
        'printf "%s\\0" "${' + k + '}"' for k in CONF_KEYS)
    try:
        out = subprocess.run(["sh", "-c", script], capture_output=True, timeout=5).stdout.decode()
    except Exception:
        out = ""
    vals = out.split("\0")
    c = {k: (vals[i] if i < len(vals) else "") for i, k in enumerate(CONF_KEYS)}

    def num(v, d):
        return int(v) if v.isdigit() else d
    return {
        "user": c["KIOSK_USER"],
        "mode": c["KIOSK_MODE"] or "web",
        "url": c["KIOSK_URL"],
        "cameras": [x for x in re.split(r"[,\s]+", c["KIOSK_RTSP_URLS"]) if x],
        "usb_device": c["KIOSK_USB_DEVICE"] or "/dev/video0",
        "web_percent": num(c["KIOSK_WEB_PERCENT"], 50),
        "screen_off_minutes": num(c["KIOSK_SCREEN_OFF_MIN"], 0),
        "shutdown_after_minutes": num(c["KIOSK_SHUTDOWN_MIN"], 0),
        "clock": c["KIOSK_CLOCK"] if c["KIOSK_CLOCK"] in CLOCKS else "off",
        "clock_position": c["KIOSK_CLOCK_POS"] if c["KIOSK_CLOCK_POS"] in CLOCK_POS else "tr",
        "clock_size": c["KIOSK_CLOCK_SIZE"] if c["KIOSK_CLOCK_SIZE"] in CLOCK_SIZES else "m",
    }


def run_cmd(args, env_extra=None, timeout=120):
    env = dict(os.environ)
    env.update(env_extra or {})
    r = subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=env)
    return r.returncode, mask((r.stdout + r.stderr).strip())


def apply_mode(body):
    """Zmiana trybu i/lub zawartości. Pola pominięte zostają bez zmian."""
    cur = read_conf()
    mode = body.get("mode") or cur["mode"]
    if mode not in MODES:
        raise ValueError("mode musi być jednym z: " + ", ".join(MODES))
    env = {"KM_MODE": mode}
    url = cur["url"]
    if "url" in body and body["url"] is not None:
        url = str(body["url"]).strip()
        env["KM_URL"] = url
    cams = cur["cameras"]
    if "cameras" in body and body["cameras"] is not None:
        cams = body["cameras"]
        if isinstance(cams, str):
            cams = re.split(r"[,\s]+", cams)
        cams = [str(c).strip() for c in cams if c and str(c).strip()]
        env["KM_CAMS"] = ",".join(cams)
    if "usb_device" in body and body["usb_device"]:
        dev = str(body["usb_device"]).strip()
        if not DEV_RE.match(dev):
            raise ValueError("usb_device musi mieć postać /dev/videoN")
        env["KM_USB"] = dev
    if "web_percent" in body and body["web_percent"] is not None:
        env["KM_PCT"] = str(to_int(body["web_percent"], 10, 90, "web_percent"))
    for key, envk, allowed in (("clock", "KM_CLOCK", CLOCKS), ("clock_position", "KM_CLOCK_POS", CLOCK_POS),
                               ("clock_size", "KM_CLOCK_SIZE", CLOCK_SIZES)):
        if body.get(key) not in (None, ""):
            if body[key] not in allowed:
                raise ValueError("%s musi być jednym z: %s" % (key, ", ".join(allowed)))
            env[envk] = body[key]
    if ("KM_URL" in env or mode in ("web", "mix")) and not URL_RE.match(url):
        raise ValueError("url musi zaczynać się od http:// lub https:// i nie zawierać spacji, przecinków ani cudzysłowów")
    clock = env.get("KM_CLOCK", cur["clock"])
    if mode in ("rtsp", "mix") or "KM_CAMS" in env:
        if mode in ("rtsp", "mix") and not cams and not (mode == "rtsp" and clock != "off"):
            raise ValueError("podaj co najmniej jedną kamerę (cameras)")
        if len(cams) > 16:
            raise ValueError("maksymalnie 16 kamer")
        for c in cams:
            if not RTSP_RE.match(c):
                raise ValueError("adres kamery musi zaczynać się od rtsp:// i nie zawierać spacji, przecinków ani cudzysłowów: " + mask(c))
    code, out = run_cmd([KIOSK_MODE, "apply"], env)
    if code != 0:
        raise RuntimeError(out)
    return out


# ---------------------------------------------------------------- widoki

def read_views():
    try:
        with open(VIEWS_FILE) as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except FileNotFoundError:
        return {}
    except Exception as e:
        log("views.json: %s" % e)
        return {}


def write_views(views):
    tmp = VIEWS_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(views, f, ensure_ascii=False, indent=1)
    os.replace(tmp, VIEWS_FILE)


VIEW_FIELDS = ("mode", "url", "cameras", "usb_device", "web_percent", "clock", "clock_position", "clock_size")


def view_from(src):
    v = {k: src.get(k) for k in VIEW_FIELDS if src.get(k) not in (None, "")}
    if v.get("mode") not in MODES:
        raise ValueError("widok musi mieć mode: " + ", ".join(MODES))
    return v


def current_view(conf=None):
    c = conf or read_conf()
    for name, v in read_views().items():
        m = v.get("mode")
        if m != c["mode"]:
            continue
        if m in ("web", "mix") and v.get("url", c["url"]) != c["url"]:
            continue
        if m in ("rtsp", "mix") and v.get("cameras", c["cameras"]) != c["cameras"]:
            continue
        if m == "mix" and int(v.get("web_percent", c["web_percent"])) != c["web_percent"]:
            continue
        if m == "usb" and v.get("usb_device", c["usb_device"]) != c["usb_device"]:
            continue
        if v.get("clock", c["clock"]) != c["clock"]:
            continue
        return name
    return ""


def apply_view(name):
    views = read_views()
    if name not in views:
        raise ValueError("nie ma widoku: " + name)
    return apply_mode(views[name])


