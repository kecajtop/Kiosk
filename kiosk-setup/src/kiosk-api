class UpdateWatch:
    """Encja „Aktualizacja” w Home Assistant: wersja zainstalowana / dostępna, postęp, instalacja z HA."""
    CHECK_EVERY = 6 * 3600

    def __init__(self):
        self.latest, self.notes, self.checked, self.err = None, "", 0, ""
        self.pub, self.conn = None, None
        self.wake = threading.Event()
        threading.Thread(target=self._loop, daemon=True).start()

    def check(self):
        cfg = read_updates()
        try:
            if cfg["url"]:
                r = subprocess.run(["/usr/local/sbin/kiosk-update", "latest"], capture_output=True, text=True, timeout=120)
                m = re.search(r"^Dostępna: (\S+)", r.stdout, re.M)
                if not m or m.group(1) == "?":
                    raise RuntimeError((r.stdout.strip().splitlines() or ["brak odpowiedzi"])[-1][:200])
                self.latest = m.group(1)
                n = re.search(r"^Opis: (.*)$", r.stdout, re.M)
                self.notes = n.group(1).strip() if n else ""
            else:   # bez adresu: wydania z GitHuba dla tej edycji
                m = http_json("https://raw.githubusercontent.com/kecajtop/Kiosk/main/%s" %
                              ("update-light.json" if LIGHT else "update.json"), timeout=20)
                self.latest, self.notes = str(m.get("version") or "") or None, str(m.get("notes") or "")
            self.err = ""
        except Exception as e:
            self.err = str(e)[:200]
            log("aktualizacje: nie udało się sprawdzić dostępnej wersji: %s" % self.err)
        self.checked = time.time()

    def state(self):
        cfg = read_updates()
        inst = pkg_version()
        st = {"installed_version": inst, "latest_version": self.latest or inst,
              "title": "kiosk-setup-light" if LIGHT else "kiosk-setup",
              "release_url": "https://github.com/kecajtop/Kiosk/blob/main/CHANGELOG.md",
              "release_summary": (self.notes or "")[:250], "in_progress": cfg["running"]}
        pr = cfg["progress"] or {}
        if cfg["running"] and isinstance(pr.get("percent"), (int, float)):
            st["update_percentage"] = int(pr["percent"])
        return st, ("ON" if cfg["auto"] else "OFF")

    def publish(self, force=False):
        if not BRIDGE or not BRIDGE.connected:
            return
        conn = id(BRIDGE.client)
        st = self.state()
        if force or st != self.pub or conn != self.conn:
            self.pub, self.conn = st, conn
            BRIDGE.publish_raw("update/state", json.dumps(st[0], ensure_ascii=False))
            BRIDGE.publish_raw("update/auto", st[1])

    def _loop(self):
        time.sleep(60)
        while True:
            try:
                if time.time() - self.checked > self.CHECK_EVERY:
                    self.check()
                self.publish()
            except Exception as e:
                log("aktualizacje (HA): %s" % e)
            if self.wake.wait(10):
                self.wake.clear()

    def install(self):
        out = start_update("check" if read_updates()["url"] else "github")
        self.wake.set()
        return out


