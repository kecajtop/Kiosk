  let cur='dark'; try{ cur=localStorage.getItem(KEY)||'dark'; }catch(e){}
  applyTheme(cur);
  $('theme').onclick=()=>{ cur=order[(order.indexOf(cur)+1)%order.length]; try{ localStorage.setItem(KEY,cur); }catch(e){} applyTheme(cur); };
