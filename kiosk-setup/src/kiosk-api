def pl_number(n):
    """1-59 słownie."""
    if n < 10:
        return PL_UNITS[n]
    if n < 20:
        return PL_TEENS[n - 10]
    return (PL_TENS[n // 10] + (" " + PL_UNITS[n % 10] if n % 10 else "")).strip()


def pl_minutes(m):
    """1 -> "jedna minuta", 2-4/22-24… -> "minuty", reszta -> "minut"."""
    if m == 1:
        return "jedna minuta"
    if m % 10 in (2, 3, 4) and m % 100 not in (12, 13, 14):
        w = pl_number(m)
        if m % 10 == 2:
            w = w[:-3] + "dwie" if w.endswith("dwa") else w  # dwie minuty
        return w + " minuty"
    return pl_number(m) + " minut"


def pl_day(d):
    if d <= 20:
        return PL_DAY_ORD[d]
    if d < 30:
        return "dwudziesty " + PL_DAY_ORD[d - 20]
    return "trzydziesty" + (" pierwszy" if d == 31 else "")


def time_text(t, with_date=False, english=False):
    if english:
        h12 = t.tm_hour % 12 or 12
        s = "The time is %d:%02d %s." % (h12, t.tm_min, "AM" if t.tm_hour < 12 else "PM")
        if with_date:
            s += " Today is %s." % time.strftime("%A, %B %d", t).replace(" 0", " ")
        return s
    h, m = t.tm_hour, t.tm_min
    # "i N minut" zamiast samej liczby: "dwudziesta druga dwadzieścia trzy" syntezator
    # potrafi zlać w "dwudziesta druga dwudziesta trzy".
    if m == 0 and h == 0:
        s = "Jest północ."
    elif m == 0 and h == 12:
        s = "Jest południe."
    elif m == 0:
        s = "Jest godzina %s." % PL_HOURS[h]
    elif h == 0:
        s = "Jest %s po północy." % ("minuta" if m == 1 else pl_minutes(m))
    else:
        s = "Jest godzina %s i %s." % (PL_HOURS[h], pl_minutes(m))
    if with_date:
        s += " Dziś jest %s, %s %s." % (PL_DAYS[t.tm_wday], pl_day(t.tm_mday), PL_MONTHS[t.tm_mon - 1])
    return s


def say_time(body=None):
    body = body if isinstance(body, dict) else {}
    t = time.localtime()
    voice = body.get("voice") or default_voice()
    text = time_text(t, bool(body.get("date")), english=(voice == "jarvis-en"))
    if body.get("weather") and voice != "jarvis-en":
        text += " " + weather_text()
    out = say(text, voice)
