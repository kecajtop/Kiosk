def scan_kiosks():
    first, rest = lan_hosts()
    me = set(qrun(["hostname", "-I"]).split())
    found = []
    lock = threading.Lock()

    def probe(chunk):
        import urllib.request
        for h in chunk:
            if h in me:
                continue
            try:
                socket.create_connection((h, PORT), 0.4).close()
                with urllib.request.urlopen("http://%s:%d/api/ping" % (h, PORT), timeout=2) as r:
                    d = json.loads(r.read().decode())
                if d.get("kecaj"):
                    with lock:
                        found.append({"host": h, "name": d.get("name", ""), "version": d.get("version", "")})
            except Exception:
                pass
    hosts = first + rest
    ts = [threading.Thread(target=probe, args=(hosts[i::48],), daemon=True) for i in range(48)]
    for t in ts:
        t.start()
    for t in ts:
        t.join(30)
    return sorted(found, key=lambda x: [int(p) for p in x["host"].split(".")])


