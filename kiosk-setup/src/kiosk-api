def sun_elevation(lat, lon, t=None):
    """Przybliżona wysokość słońca nad horyzontem w stopniach (uproszczony wzór NOAA, bez zależności)."""
    t = t or time.gmtime()
    n = t.tm_yday
    hour = t.tm_hour + t.tm_min / 60.0 + t.tm_sec / 3600.0
    decl = 23.45 * math.sin(math.radians(360.0 / 365.0 * (284 + n)))
    b = math.radians(360.0 * (n - 81) / 364.0)
    eot = 9.87 * math.sin(2 * b) - 7.53 * math.cos(b) - 1.5 * math.sin(b)
    solar_time = hour + (4.0 * lon + eot) / 60.0
    hour_angle = 15.0 * (solar_time - 12.0)
    lat_r, decl_r, ha_r = math.radians(lat), math.radians(decl), math.radians(hour_angle)
    sin_el = math.sin(lat_r) * math.sin(decl_r) + math.cos(lat_r) * math.cos(decl_r) * math.cos(ha_r)
    return math.degrees(math.asin(max(-1.0, min(1.0, sin_el))))


def current_sun_elevation():
