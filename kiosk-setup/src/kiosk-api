CHIME_FILE = TTS_DIR + "/gong-v1.wav"
DLNA_PORT = 49494


def make_chime(path):
    """Gong jak na lotnisku: trzy rosnące dźwięki dzwonka (G4-H4-D5), ok. 2,3 s."""
    sr = 44100
    notes = [(0.0, 392.00), (0.42, 493.88), (0.84, 587.33)]
    partials = [(1.0, 1.0), (2.0, 0.42), (3.0, 0.18), (4.16, 0.07), (5.43, 0.03)]
    n = int(sr * 2.3)
    buf = [0.0] * n
    for start, f in notes:
        s0 = int(start * sr)
        for i in range(n - s0):
            t = i / sr
            env = (min(1.0, t / 0.006)) * math.exp(-t * 2.6)
            if t > 0.1 and env < 1e-4:
                break
            v = 0.0
            for mult, amp in partials:
                v += amp * math.exp(-t * (mult - 1) * 1.1) * math.sin(2 * math.pi * f * mult * t)
            buf[s0 + i] += env * v
    peak = max(abs(x) for x in buf) or 1.0
    scale = 0.6 * 32767 / peak            # ok. -4,4 dBFS — wyraźnie, ale nie głośniej niż mowa
    tail = int(sr * 0.08)
    frames = bytearray()
    for i, x in enumerate(buf):
        if i > n - tail:
            x *= (n - i) / tail
        v = int(max(-32767, min(32767, x * scale)))
        frames += struct.pack("<hh", v, v)
    tmp = path + ".tmp"
    with wave.open(tmp, "wb") as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(sr)
        w.writeframes(bytes(frames))
    os.replace(tmp, path)


def ensure_chime():
    if not os.path.exists(CHIME_FILE):
        os.makedirs(TTS_DIR, exist_ok=True)
        make_chime(CHIME_FILE)
        os.chmod(CHIME_FILE, 0o644)
    return CHIME_FILE


def _soap(svc, ctl, action, args=""):
    body = ('<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" '
            's:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body>'
            '<u:%s xmlns:u="urn:schemas-upnp-org:service:%s:1"><InstanceID>0</InstanceID>%s</u:%s>'
            '</s:Body></s:Envelope>') % (action, svc, args, action)
    import urllib.request
    last = None
    for host in (local_ip(), "127.0.0.1"):
        try:
            req = urllib.request.Request("http://%s:%d/upnp/control/%s" % (host, DLNA_PORT, ctl), body.encode(),
                                         {"Content-Type": 'text/xml; charset="utf-8"',
                                          "SOAPACTION": '"urn:schemas-upnp-org:service:%s:1#%s"' % (svc, action)})
            return urllib.request.urlopen(req, timeout=1.5).read().decode("utf-8", "replace")
        except Exception as e:
            last = e
    raise RuntimeError(last)


def dlna_state():
    """(głośność, czy_gra) odtwarzacza DLNA albo None, gdy nie działa."""
    try:
        v = re.search(r"<CurrentVolume>(\d+)", _soap("RenderingControl", "rendercontrol1", "GetVolume",
                                                     "<Channel>Master</Channel>"))
        st = re.search(r"<CurrentTransportState>(\w+)", _soap("AVTransport", "rendertransport1", "GetTransportInfo"))
        if v:
            return int(v.group(1)), bool(st and st.group(1) == "PLAYING")
    except Exception:
        pass
    return None


def dlna_volume(n):
    try:
        _soap("RenderingControl", "rendercontrol1", "SetVolume",
              "<Channel>Master</Channel><DesiredVolume>%d</DesiredVolume>" % n)
    except Exception as e:
        log("DLNA głośność: %s" % e)


def fade(setter, a, b, steps=5, pause=0.06):
    for i in range(1, steps + 1):
        setter(round(a + (b - a) * i / steps))
        time.sleep(pause)


