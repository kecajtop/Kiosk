def _xml_tag(xml, *names):
    for n in names:
        m = re.search(r"<%s[^>]*>(.*?)</%s>" % (re.escape(n), re.escape(n)), xml, re.S)
        if m and m.group(1).strip():
            return html.unescape(m.group(1).strip())
    return ""


def mpd_now():
    """Co gra odtwarzacz kiosku (MPD): radio z ulubionych, inny strumień albo plik z adresu."""
    code, out = mpc("-f", "%file%\t%name%\t%title%\t%artist%", "status")
    if code != 0:
        return None
    lines = out.splitlines()
    st = next((m.group(1) for m in (re.match(r"^\[(playing|paused)\]", ln) for ln in lines) if m), "stopped")
    if st != "playing" or not lines or lines[0].startswith("["):
        return None
    f, name, title, artist = (lines[0].split("\t") + ["", "", "", ""])[:4]
    r = read_radio()
    station = next((x["name"] for x in r["stations"] if x["url"] == f), "")
    if station or name or r.get("playing") == f:
        np = {"kind": "radio", "source": "Radio", "station": station or name or "Radio internetowe"}
    else:
        import urllib.parse
        base = urllib.parse.unquote(f.split("?")[0].rstrip("/").rsplit("/", 1)[-1]) or f
        np = {"kind": "url", "source": "Z adresu", "station": ""}
        title = title or base
    np.update({"state": "playing", "title": title, "artist": artist, "art": False})
    return np


def dlna_now():
    """Co gra odtwarzacz DLNA (muzyka i radio wysłane z Home Assistant)."""
    try:
        st = re.search(r"<CurrentTransportState>(\w+)", _soap("AVTransport", "rendertransport1", "GetTransportInfo"))
        if not st or st.group(1) != "PLAYING":
            return None
        mi = _soap("AVTransport", "rendertransport1", "GetMediaInfo")
    except Exception:
        return None
    uri = _xml_tag(mi, "CurrentURI")
    if "tts_proxy" in uri or "/api/tts" in uri:
        return None     # komunikat głosowy z HA — to nie muzyka
    meta = _xml_tag(mi, "CurrentURIMetaData")
    title = _xml_tag(meta, "dc:title")
    artist = _xml_tag(meta, "upnp:artist", "dc:creator")
    art_url = _xml_tag(meta, "upnp:albumArtURI")
    if not title:
        import urllib.parse
        title = urllib.parse.unquote(uri.split("?")[0].rsplit("/", 1)[-1]) or "Muzyka"
    art = False
    if art_url.startswith(("http://", "https://")):
        if art_url != _NOWP_ART_URL["url"]:
            _NOWP_ART_URL.update(url=art_url, ok=False)
            try:
                import urllib.request
                with urllib.request.urlopen(art_url, timeout=4) as r:
                    data = r.read(3_000_001)
                if 0 < len(data) <= 3_000_000:
                    with open(NOWP_ART + ".tmp", "wb") as f:
                        f.write(data)
                    os.chmod(NOWP_ART + ".tmp", 0o644)
                    os.replace(NOWP_ART + ".tmp", NOWP_ART)
                    _NOWP_ART_URL["ok"] = True
            except Exception as e:
                log("okładka: %s" % e)
        art = _NOWP_ART_URL["ok"]
    return {"state": "playing", "kind": "dlna", "source": "Home Assistant", "station": "", "title": title,
            "artist": artist, "art": art}


