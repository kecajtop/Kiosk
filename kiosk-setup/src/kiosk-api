# ---------------------------------------------------------------- czujniki systemu

_RAPL = {"e": None, "t": None, "w": None}


def system_sensors():
    s = {}
    temps = []
    try:
        for z in os.listdir("/sys/class/thermal"):
            try:
                with open("/sys/class/thermal/%s/temp" % z) as f:
                    temps.append(int(f.read()) / 1000.0)
            except Exception:
                pass
    except OSError:
        pass
    s["cpu_temp"] = round(max(temps), 1) if temps else None
    try:
        with open("/proc/loadavg") as f:
            s["load"] = float(f.read().split()[0])
        mem = {}
        with open("/proc/meminfo") as f:
            for l in f:
                k = l.split(":")[0]
                if k in ("MemTotal", "MemAvailable"):
                    mem[k] = int(l.split()[1])
        s["mem_free_mb"] = mem.get("MemAvailable", 0) // 1024
        st = os.statvfs("/")
        s["disk_free_gb"] = round(st.f_bavail * st.f_frsize / 1e9, 1)
    except Exception:
        pass
    try:
        with open("/sys/class/powercap/intel-rapl:0/energy_uj") as f:
            e = int(f.read())
        t = time.time()
        if _RAPL["e"] is not None and t - _RAPL["t"] > 2 and e >= _RAPL["e"]:
            _RAPL["w"] = round((e - _RAPL["e"]) / 1e6 / (t - _RAPL["t"]), 1)
        if _RAPL["t"] is None or t - _RAPL["t"] > 2:
            _RAPL["e"], _RAPL["t"] = e, t
    except Exception:
        pass
    s["power_w"] = _RAPL["w"]
    return s


