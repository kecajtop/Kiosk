class RoSaver:
    """Gdy dysk jest tylko do odczytu: co 10 s sprawdza, czy zmieniły się ustawienia kiosku
    (z panelu, MQTT, Home Assistant albo terminala); gdy przestaną się zmieniać, zapisuje je
    na dysk (kiosk-ro save: chwilowo rw, potem z powrotem ro)."""

    def __init__(self):
        self.lock = threading.Lock()
        self.saved = None
        self.pending = None
        self.last = ""
        threading.Thread(target=self._loop, daemon=True).start()

    @staticmethod
    def signature():
        sig = []
        for top in RO_WATCH + (("/var/lib/kiosk-clips",) if ro_keep_clips() else ()):
            if os.path.isdir(top):
                walk = os.walk(top)
            else:
                walk = [(os.path.dirname(top), [], [os.path.basename(top)])]
            for dp, dns, fns in walk:
                for n in fns + dns:
                    p = os.path.join(dp, n)
                    try:
                        st = os.lstat(p)
                        sig.append((p, st.st_size, int(st.st_mtime), st.st_mode))
                    except OSError:
                        pass
        return hash(tuple(sorted(sig)))

    def _loop(self):
        while True:
            time.sleep(10)
            try:
                self.tick()
            except Exception as e:
                log("zapis na dysk (ro): %s" % e)

    def tick(self):
        if not ro_active():
            return
        sig = self.signature()
        if sig == self.saved:
            return
        if sig != self.pending:      # zmienia się — poczekaj, aż się ustabilizuje
            self.pending = sig
            return
        self.save(sig)

    def save(self, sig=None):
        with self.lock:
            sig = sig if sig is not None else self.signature()
            code, out = run_cmd([KIOSK_RO, "save"], timeout=600)
            tail = (out.strip().splitlines() or [""])[-1]
            self.last = time.strftime("%Y-%m-%d %H:%M:%S") + " — " + tail
            if code == 0:
                self.saved = sig
            else:
                log("kiosk-ro save: " + out)
                raise RuntimeError(out or "zapis na dysk nie powiódł się")
            return tail


RO = None


def ro_info():
    info = {"available": os.path.exists(KIOSK_RO), "active": ro_active(), "next": ro_next(),
            "package": bool(shutil.which("overlayroot-chroot")), "last_save": RO.last if RO else ""}
    if info["active"]:
        try:
            st = os.statvfs("/media/root-rw")
            info["ram_used_mb"] = int((st.f_blocks - st.f_bfree) * st.f_frsize / 1048576)
            info["ram_total_mb"] = int(st.f_blocks * st.f_frsize / 1048576)
        except OSError:
            pass
    info["keep_clips"] = ro_keep_clips()
    return info


def ro_action(body):
    a = body.get("action")
    if "keep_clips" in body:
        with open(ETC + "/ro.conf", "w") as f:
            f.write("# Ustawienia kiosk-ro (dysk tylko do odczytu)\nKEEP_CLIPS=%s\n" % ("yes" if body["keep_clips"] else "no"))
        if not a:
            return "Zapisano."
    if a == "save":
        if not ro_active():
            return "Dysk jest w zwykłym trybie zapisu — nie trzeba nic zapisywać."
        return RO.save() if RO else "brak"
    if a in ("on", "off"):
        code, out = run_cmd([KIOSK_RO, a], timeout=900)
        if code != 0:
            raise RuntimeError(out)
        return out
    raise ValueError("action: on, off albo save")


class MqttBridge:
    def __init__(self):
        self.lock = threading.Lock()
        self.client = None
        self.cfg = read_mqtt_conf()
        self.connected = False
        self.last_error = ""
        self.last_state = None
        self.views_published = None
        self.disc_topics = set()
        threading.Thread(target=self._ticker, daemon=True).start()
        threading.Thread(target=self._screens, daemon=True).start()

    def info(self):
        return {"connected": self.connected, "error": self.last_error}

    def device_id(self):
        return device_id()

    def forget(self, clear_discovery=False):
        """Przed zmianą tematów / urządzenia: usuń zachowane wiadomości ze starych tematów,
        a z clear_discovery także encje starego urządzenia w Home Assistant."""
        c = self.client
        if c is None or not self.connected:
            return
        p = self.cfg["prefix"]
        try:
            for sub in ("/availability", "/state", "/screen/image"):
                c.publish(p + sub, "", qos=1, retain=True)
            if clear_discovery:
                for t in list(self.disc_topics):
                    c.publish(t, "", qos=1, retain=True)
                self.disc_topics.clear()
            time.sleep(1)
        except Exception as e:
            log("MQTT forget: %s" % e)

    def start(self):
        with self.lock:
            self._stop_locked()
            cfg = read_mqtt_conf()
            self.cfg = cfg
            self.connected = False
            self.last_error = ""
            if not cfg["enabled"] or not cfg["host"]:
                return
            try:
                import paho.mqtt.client as mqtt
            except ImportError:
                self.last_error = "brak biblioteki paho-mqtt (sudo apt install python3-paho-mqtt)"
                log("MQTT: " + self.last_error)
                return
            cid = self.device_id() + "_" + str(os.getpid())
            try:
                c = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id=cid)
            except AttributeError:
                c = mqtt.Client(client_id=cid)  # paho-mqtt 1.x
            if cfg["user"]:
                c.username_pw_set(cfg["user"], cfg["password"] or None)
            c.will_set(cfg["prefix"] + "/availability", "offline", qos=1, retain=True)
            c.on_connect = self._on_connect
            c.on_disconnect = self._on_disconnect
            c.on_message = self._on_message
            c.reconnect_delay_set(min_delay=2, max_delay=60)
            try:
                c.connect_async(cfg["host"], int(cfg["port"]), keepalive=60)
                c.loop_start()
            except Exception as e:
                self.last_error = str(e)
                log("MQTT: %s" % e)
                return
            self.client = c
            log("MQTT: łączenie z %s:%s, prefiks %s" % (cfg["host"], cfg["port"], cfg["prefix"]))

    def _stop_locked(self):
        c, self.client = self.client, None
        if c is not None:
            try:
                c.publish(self.cfg["prefix"] + "/availability", "offline", qos=1, retain=True)
                c.disconnect()
                c.loop_stop()
            except Exception:
                pass

    @staticmethod
    def _rc(args):
        # paho 1.x: (client, userdata, flags, rc); 2.x: (client, userdata, flags, reason_code, properties)
        rc = args[3] if len(args) > 3 else 0
        try:
            return int(getattr(rc, "value", rc))
        except Exception:
            return 0 if str(rc) == "Success" else 1

    def _on_connect(self, client, *args):
        rc = self._rc((client,) + args)
        if rc != 0:
            self.connected = False
            self.last_error = "broker odrzucił połączenie (kod %s) — sprawdź użytkownika i hasło" % rc
            log("MQTT: " + self.last_error)
            return
        self.connected = True
        self.last_error = ""
        p = self.cfg["prefix"]
        log("MQTT: połączono")
        client.subscribe([(p + "/set", 1), (p + "/+/set", 1), ("homeassistant/status", 1)])
        client.publish(p + "/availability", "online", qos=1, retain=True)
        # Błąd tutaj nie może zabić wątku MQTT (paho) — kiosk zostałby bez MQTT.
        try:
            self.views_published = None
            if self.cfg.get("discovery", True):
                self.publish_discovery()
            self.last_state = None
            self.publish_state(force=True)
        except Exception as e:
            log("MQTT: ogłoszenie encji/stanu: %s" % e)

    def _rediscover(self):
        time.sleep(2)
        try:
            self.views_published = None
            self.publish_discovery()
            self.last_state = None
            self.publish_state(force=True)
        except Exception as e:
            log("MQTT: ponowne ogłoszenie: %s" % e)

    def _on_disconnect(self, client, *args):
        if self.connected:
            log("MQTT: rozłączono, ponawiam")
        self.connected = False

    def _on_message(self, client, userdata, msg):
        mqtt_trace("←", msg.topic, msg.payload)
        if msg.topic == "homeassistant/status":
            # HA po restarcie wysyła "online" — od razu ponowne ogłoszenie encji i stanu.
            if msg.payload.decode("utf-8", "replace").strip() == "online" and self.cfg.get("discovery", True):
                log("MQTT: Home Assistant wystartował — ponowne ogłoszenie encji")
                threading.Thread(target=self._rediscover, daemon=True).start()
            return
        p = self.cfg["prefix"]
        cmd = msg.topic[len(p) + 1:]
        payload = msg.payload.decode("utf-8", "replace").strip()
        threading.Thread(target=self._handle, args=(cmd, payload), daemon=True).start()

    def _handle(self, cmd, payload):
        try:
            out = handle_command(cmd, payload)
            self.result(True, cmd, out)
        except Exception as e:
            self.result(False, cmd, str(e))
        time.sleep(3)
        self.publish_state(force=True)

    def result(self, ok, cmd, out):
        c = self.client
        if c is not None:
            msg = json.dumps({"ok": ok, "command": cmd, "output": mask(str(out)),
                              "time": time.strftime("%Y-%m-%d %H:%M:%S")}, ensure_ascii=False)
            mqtt_trace("→", self.cfg["prefix"] + "/result", msg)
            c.publish(self.cfg["prefix"] + "/result", msg, qos=1)

    def publish_state(self, force=False):
        c = self.client
        if c is None or not self.connected:
            return
        st = status()
        key = {k: v for k, v in st.items() if k not in ("uptime_s", "time")}
        if not force and key == self.last_state:
            return
        self.last_state = key
        c.publish(self.cfg["prefix"] + "/state", json.dumps(st, ensure_ascii=False), qos=1, retain=True)
        names = sorted(read_views())
        if self.cfg.get("discovery", True) and names != self.views_published:
            self.publish_discovery(views_only=True)

    def _ticker(self):
        n = 0
        while True:
            time.sleep(5)
            n += 1
            try:
                self.publish_state(force=(n % 6 == 0))  # zmiany od razu, pełny stan co 30 s
            except Exception as e:
                log("MQTT stan: %s" % e)

    def publish_raw(self, sub, payload, retain=True):
        c = self.client
        if c is not None and self.connected:
            t = self.cfg["prefix"] + "/" + sub
            mqtt_trace("→", t, payload)
            c.publish(t, payload, qos=1, retain=retain)

    def _screens(self):
        """Zrzut ekranu kiosku jako kamera MQTT w Home Assistant (co N s, 0 = wyłączone)."""
        while True:
            n = int(self.cfg.get("screenshot", 60) or 0)
            time.sleep(max(n, 30) if n else 30)
            c = self.client
            if not n or c is None or not self.connected:
                continue
            try:
                img = screenshot_jpeg(max_w=960, quality=65)
                c.publish(self.cfg["prefix"] + "/screen/image", img, qos=0, retain=True)
            except Exception as e:
                log("MQTT zrzut ekranu: %s" % e)

    def publish_discovery(self, views_only=False):
        c = self.client
        if c is None:
            return
        p = self.cfg["prefix"]
        did = self.device_id()
        dev = {"identifiers": [did], "name": "Kiosk " + kiosk_name(), "manufacturer": "kiosk-setup",
               "model": "kiosk-setup", "configuration_url": "http://%s:%d/" % (local_ip(), PORT)}
        st = {"state_topic": p + "/state"}
        names = sorted(read_views())
        view_ent = ("select", "view", dict(st, name="Widok", icon="mdi:view-dashboard-variant",
                                            command_topic=p + "/view/set", options=names,
                                            value_template="{{ value_json.view if value_json.view in %s else None }}" % json.dumps(names)))
        second_ent = ("select", "second_view", dict(st, name="Widok na drugim ekranie", icon="mdi:monitor-multiple",
                                                     command_topic=p + "/second_view/set", options=["brak"] + names,
                                                     value_template="{{ value_json.second_view or 'brak' }}"))
        ents = [view_ent, second_ent] if views_only else [second_ent,
            ("select", "mode", dict(st, name="Tryb", icon="mdi:monitor-dashboard", command_topic=p + "/mode/set",
                                    value_template="{{ value_json.mode }}", options=list(MODES))),
            view_ent,
            ("select", "clock", dict(st, name="Zegar", icon="mdi:clock-outline", command_topic=p + "/clock/set",
                                     options=list(CLOCKS), value_template="{{ value_json.clock }}")),
            ("select", "clock_position", dict(st, name="Pozycja zegara", icon="mdi:arrow-top-right",
                                              command_topic=p + "/clock_position/set", options=list(CLOCK_POS),
                                              value_template="{{ value_json.clock_position }}")),
            ("text", "url", dict(st, name="Adres strony", icon="mdi:web", command_topic=p + "/url/set", max=255,
                                 value_template="{{ value_json.url }}")),
            ("number", "web_percent", dict(st, name="Szerokość strony (mix)", icon="mdi:arrow-split-vertical",
