                    self.send(404, {"error": "brak podglądu — jeszcze nie wykryto twarzy"})
                else:
                    self.send_file(f, "image/jpeg")
            elif path.startswith("/api/faces/img/"):
                parts = unquote(path[15:]).split("/")
                f = os.path.join(FACES_DIR, person_name(parts[0]), os.path.basename(parts[-1])) if len(parts) == 2 else ""
                if not f or not os.path.isfile(f):
                    self.send(404, {"error": "nie ma zdjęcia"})
                else:
                    ext = f.lower().rsplit(".", 1)[-1]
                    self.send_file(f, {"png": "image/png", "webp": "image/webp", "bmp": "image/bmp"}.get(ext, "image/jpeg"))
            elif path == "/api/clips":
                self.send(200, {"clips": CLIPS.list()})
            elif path.startswith("/api/clips/"):
                f = os.path.join(CLIP_DIR, os.path.basename(unquote(path[11:])))
                if not os.path.isfile(f):
                    self.send(404, {"error": "nie ma nagrania"})
                else:
                    self.send_file(f, "video/mp4")
            elif path == "/api/radio":
                self.send(200, read_radio())
            elif path == "/api/radio/search":
                self.send(200, {"results": radio_search(q.get("q", [""])[0])})
            elif path == "/api/users":
                self.send(200, {"users": [{"name": k, "role": v.get("role", "user")} for k, v in sorted(read_users().items())]})
            elif path == "/api/peers":
                out = []
                for pe in read_peers():
                    try:
                        st = peer_call(pe, "/api/status", timeout=4)
                        out.append({"host": pe["host"], "name": st.get("hostname", ""), "ok": True,
                                    "mode": st.get("mode"), "version": st.get("version", "")})
                    except Exception as e:
                        out.append({"host": pe["host"], "ok": False, "error": str(e)[:120]})
                self.send(200, {"peers": out})
            elif path == "/api/peers/scan":
                self.send(200, {"found": scan_kiosks()})
            elif path == "/api/listen":
                data = listen(q.get("seconds", ["10"])[0])
                self.send(200, data, "audio/wav")
            else:
                return False
        except ValueError as e:
            self.send(400, {"error": str(e)})
        except Exception as e:
            log("GET %s: %s" % (path, e))
            self.send(500, {"error": str(e)})
        return True

