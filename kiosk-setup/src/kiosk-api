def _rd(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def _tcp(host, port, timeout=3):
    try:
        socket.create_connection((host, port), timeout).close()
        return True
    except OSError:
        return False


def _wifi_quality(iface):
    for ln in _rd("/proc/net/wireless").splitlines()[2:]:
        p = ln.split()
        if p and p[0].rstrip(":") == iface and len(p) > 2:
            try:
                return max(0, min(100, int(float(p[2].rstrip(".")) * 100 / 70)))
            except ValueError:
                return None
    return None


def net_check():
    """Stan połączeń: ok / warn / bad (brak klucza = nie dotyczy)."""
    out = {"ts": time.time()}
    lan, wifi = [], []
    try:
        names = sorted(os.listdir("/sys/class/net"))
    except OSError:
        names = []
    for n in names:
        base = "/sys/class/net/" + n
        if n == "lo" or not os.path.exists(base + "/device"):
            continue        # tylko karty fizyczne (bez docker/veth/mostków)
        up = _rd(base + "/operstate") == "up" and _rd(base + "/carrier") == "1"
        if os.path.isdir(base + "/wireless") or os.path.isdir(base + "/phy80211"):
            wifi.append((n, up))
        else:
            lan.append((n, up))
    any_up = any(u for _, u in lan + wifi)
    # Pokazujemy rodzaje połączeń, które działają; gdy nic nie działa — wszystkie jako brak.
    if lan and (any(u for _, u in lan) or not any_up):
        up = [n for n, u in lan if u]
        out["lan"] = {"state": "ok" if up else "bad", "iface": (up or [lan[0][0]])[0]}
    if wifi and (any(u for _, u in wifi) or not any_up):
        up = [n for n, u in wifi if u]
        if up:
            q = _wifi_quality(up[0])
            lvl = 3 if q is None or q >= 60 else (2 if q >= 35 else 1)
            ssid = ""
            if shutil.which("iw"):
                m = re.search(r"SSID: (.+)", qrun(["iw", "dev", up[0], "link"], timeout=3))
                ssid = m.group(1).strip() if m else ""
            out["wifi"] = {"state": "ok" if lvl >= 2 else "warn", "iface": up[0], "quality": q, "level": lvl,
                           "ssid": ssid}
        else:
            out["wifi"] = {"state": "bad", "iface": wifi[0][0]}
    out["internet"] = {"state": "ok" if any(_tcp(h, p) for h, p in INTERNET_PROBES) else "bad"}
    url = ""
    try:
        url = (read_weather_conf().get("ha_url") or "").strip()
    except Exception:
        pass
    if not url:
        u = read_conf().get("url") or ""
        url = u if ":8123" in u else ""
    if url:
        import urllib.parse
        pu = urllib.parse.urlparse(url)
        if pu.hostname:
            try:
                port = pu.port or (443 if pu.scheme == "https" else 80)
            except ValueError:
                port = 8123
            out["ha"] = {"state": "ok" if _tcp(pu.hostname, port) else "bad", "host": pu.hostname}
    mc = read_mqtt_conf()
    if mc["enabled"] and mc["host"]:
        out["mqtt"] = {"state": "ok" if BRIDGE and BRIDGE.connected else "bad", "host": mc["host"]}
    return out


