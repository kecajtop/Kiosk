def mask(text):
    return re.sub(r"//[^:@/\s]+:[^@/\s]+@", "//***:***@", text or "")


def to_int(v, lo, hi, name):
    try:
        n = int(v)
    except (TypeError, ValueError):
        raise ValueError(name + ": podaj liczbę")
    if not lo <= n <= hi:
        raise ValueError("%s: dozwolony zakres %d-%d" % (name, lo, hi))
    return n


