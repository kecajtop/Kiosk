  ['Pn','Wt','Śr','Cz','Pt','So','Nd'].forEach((d,i)=>{ const l=document.createElement('label'); l.className='check'; l.style.margin='0'; const c=document.createElement('input'); c.type='checkbox'; c.value=i; c.checked=(it.days||[]).includes(i); l.append(c,d); days.append(l); });
  const a=document.createElement('select'); a.className='sca'; Object.entries(ACTIONS).forEach(([k,v])=>a.append(opt(k,v))); a.value=it.action; a.style.width='auto';
  const v=document.createElement('select'); v.className='scv'; (AUTOD?AUTOD.views:[]).forEach(n=>v.append(opt(n,n))); if(it.view) v.value=it.view; v.style.width='auto';
