def handle_command(cmd, payload):
    """Wspólna obsługa komend MQTT (temat <prefix>/<cmd>)."""
    v = parse_payload(payload)
    if cmd == "set":
        if not isinstance(v, dict):
            raise ValueError("oczekiwany obiekt JSON, np. {\"mode\":\"rtsp\",\"cameras\":[...]}")
        return apply_mode(v)
    if cmd == "mode/set":
        return apply_mode({"mode": str(payload).lower()})
    if cmd == "view/set":
        return apply_view(str(payload))
    if cmd == "url/set":
        return apply_mode({"url": str(payload)})
    if cmd == "cameras/set":
        return apply_mode({"cameras": v if isinstance(v, list) else str(payload)})
    if cmd == "clock/set":
        if isinstance(v, dict):
            return apply_mode({"clock": v.get("clock") or v.get("mode"), "clock_position": v.get("position"),
                               "clock_size": v.get("size")})
        return apply_mode({"clock": str(payload).lower()})
    if cmd == "clock_position/set":
        return apply_mode({"clock_position": str(payload).lower()})
    if cmd == "split/set":
        return apply_mode({"web_percent": int(float(payload))})
    if cmd == "screen/set":
        on = str(payload).upper() in ("ON", "1", "TRUE", "WŁĄCZ")
        return power("screen", "on" if on else "off")
    if cmd == "screen_timeout/set":
        return set_power_settings({"screen_off_minutes": int(float(payload))})
    if cmd == "shutdown_after/set":
        return set_power_settings({"shutdown_after_minutes": int(float(payload))})
    if cmd == "shutdown/set":
        if str(payload).upper() in ("CANCEL", "ANULUJ"):
            return power("cancel")
        return power("shutdown", str(to_int(payload or 0, 0, 10080, "minuty")))
    if cmd == "restart/set":
        return run_cmd([KIOSK_MODE, "reload"])[1]
    if cmd == "reboot/set":
        subprocess.Popen(["/bin/sh", "-c", "sleep 3; /sbin/reboot"])
        return "Restart urządzenia za 3 s"
    if cmd == "bubble/set":
        if v in ("", None) or (isinstance(v, str) and v.upper() in ("OFF", "HIDE")):
            return BUBBLE.hide()
        return BUBBLE.show(v if isinstance(v, dict) else {"text": str(payload)})
    if cmd == "brightness/set":
        return BRIGHT.set(int(float(payload)))
    if cmd == "night/set":
        u = str(payload).strip().upper()
        AUTO.night_force = True if u == "ON" else False if u == "OFF" else None
        AUTO.wake.set()
        return "Tryb nocny: " + {"ON": "włączony", "OFF": "wyłączony"}.get(u, "wg godzin")
    if cmd == "rotation/set":
        r = read_rotation()
        r["enabled"] = str(payload).strip().upper() in ("ON", "1", "TRUE")
        write_json(ROTATION_FILE, r, 0o644)
        AUTO.rot_next = 0
        return "Rotacja widoków: " + ("włączona" if r["enabled"] else "wyłączona")
    if cmd == "radio/set":
        return radio_play(v.get("station") if isinstance(v, dict) else str(payload), fade_in=isinstance(v, dict) and bool(v.get("fade")))
    if cmd == "photos/set":
        OVR.photos = str(payload).strip().upper() in ("ON", "1", "TRUE")
        OVR.update()
        return "Zdjęcia: " + ("tak" if OVR.photos else "nie")
    if cmd == "alert/set":
        if str(payload).strip().upper() in ("", "OFF", "STOP", "0"):
            return ALERT.end()
        return ALERT.start(v if isinstance(v, dict) else str(payload).strip())
    if cmd == "presence/set":
        on = str(payload).strip().upper() in ("ON", "1", "TRUE", "HOME", "DETECTED")
        AUTO.presence_event(on)
        return "Obecność: " + ("ktoś jest" if on else "brak")
    if cmd == "ticker/set":
        return AUTO.set_message(v if isinstance(v, dict) else str(payload))
    if cmd == "message/set":
        url = v.get("url") if isinstance(v, dict) else str(payload).strip()
        if not AUDIO_RE.match(str(url or "")):
            raise ValueError("message/set: adres nagrania http(s)://…")
        return announce_audio(url, v.get("chime", True) if isinstance(v, dict) else True)
    if cmd == "say/set":
        if isinstance(v, dict):
            return say(v.get("text"), v.get("voice"), v.get("speed", 150), v.get("chime"))
        return say(payload)
    if cmd == "second_view/set":
        name = "" if str(payload).strip().lower() in ("", "off", "brak", "none") else str(payload).strip()
        body = {"second_view": name}
        if name:
            body["others"] = "extend"
        return apply_displays(body)
    if cmd == "weather/set":
        return say_weather(v if isinstance(v, dict) else {})
    if cmd == "time/set":
        if isinstance(v, dict):
            return say_time(v)
        return say_time({"date": str(payload).lower() in ("date", "data", "1", "true", "on")})
    if cmd == "voice/set":
        return set_default_voice(str(payload))
    if cmd == "play/set":
        return audio_play(v.get("url") if isinstance(v, dict) else payload)
    if cmd == "radio_next/set":
        return radio_step(1)
    if cmd == "radio_prev/set":
        return radio_step(-1)
    if cmd == "update/set":
        if str(payload).strip().lower() not in ("install", "on", "1", "{}"):
            raise ValueError("update/set: install")
        return UPDWATCH.install() if UPDWATCH else start_update("github")
    if cmd == "update_check/set":
        if UPDWATCH:
            UPDWATCH.checked = 0
            UPDWATCH.wake.set()
        return "Sprawdzam dostępną wersję"
    if cmd == "auto_update/set":
        on = str(payload).strip().upper() in ("ON", "1", "TRUE", "YES")
        write_updates({"auto": on})
        if UPDWATCH:
            UPDWATCH.wake.set()
        return "Automatyczne aktualizacje: " + ("włączone" if on else "wyłączone")
    if cmd == "stop/set":
        return audio_stop()
    if cmd == "volume/set":
        return audio_volume(int(float(payload)))
    if cmd == "volume/step":
        return audio_volume_step(int(float(payload)))
    raise ValueError("nieznana komenda: " + cmd)


