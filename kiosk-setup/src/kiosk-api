def read_mqtt_conf():
    cfg = dict(MQTT_DEFAULTS)
    try:
        with open(MQTT_FILE) as f:
            data = json.load(f)
        if isinstance(data, dict):
            cfg.update({k: data[k] for k in MQTT_DEFAULTS if k in data})
    except FileNotFoundError:
        pass
    except Exception as e:
        log("mqtt.json: %s" % e)
    return cfg


def write_mqtt_conf(cfg):
    tmp = MQTT_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=1)
    os.replace(tmp, MQTT_FILE)
    lines = [
        "kiosk-setup kiosk-setup/mqtt_host string " + (cfg["host"] if cfg["enabled"] else ""),
        "kiosk-setup kiosk-setup/mqtt_port string %d" % cfg["port"],
        "kiosk-setup kiosk-setup/mqtt_user string " + cfg["user"],
        "kiosk-setup kiosk-setup/mqtt_password password " + cfg["password"],
        "kiosk-setup kiosk-setup/mqtt_prefix string " + cfg["prefix"],
    ]
    try:
        subprocess.run(["debconf-set-selections"], input="\n".join(lines) + "\n",
                       text=True, capture_output=True, timeout=20)
    except Exception:
        pass


def validate_mqtt(body, current):
    cfg = dict(current)
    if "enabled" in body:
        cfg["enabled"] = bool(body["enabled"])
    if "discovery" in body:
        cfg["discovery"] = bool(body["discovery"])
    if body.get("screenshot") not in (None, ""):
        cfg["screenshot"] = to_int(body["screenshot"], 0, 3600, "screenshot")
        if 0 < cfg["screenshot"] < 10:
            raise ValueError("screenshot: co najmniej 10 s (0 = wyłączone)")
    if "host" in body:
        h = str(body["host"] or "").strip()
        if h and not HOST_RE.match(h):
            raise ValueError("host: podaj adres IP lub nazwę brokera, np. 192.168.0.1")
        cfg["host"] = h
    if body.get("port") not in (None, ""):
        cfg["port"] = to_int(body["port"], 1, 65535, "port")
    for k in ("user", "password"):
        if body.get(k) is not None:
            v = str(body[k])
            if k == "password" and v == "":
                continue  # puste pole hasła = bez zmian
            if "\n" in v or "\r" in v or len(v) > 200:
                raise ValueError(k + ": niedozwolone znaki lub za długie")
            cfg[k] = v
    if body.get("clear_password"):
        cfg["password"] = ""
    if "prefix" in body:
        pf = str(body["prefix"] or "").strip().strip("/")
        if not PREFIX_RE.match(pf) or len(pf) > 100:
            raise ValueError("prefix: litery, cyfry, _ i -, poziomy oddzielone /, np. kecaj/kiosk")
        cfg["prefix"] = pf
    if cfg["enabled"] and not cfg["host"]:
        raise ValueError("podaj adres brokera MQTT, żeby włączyć MQTT")
    return cfg


def parse_payload(payload):
    """Treść MQTT: JSON (obiekt) albo zwykły tekst."""
    try:
        v = json.loads(payload)
        return v
    except (json.JSONDecodeError, ValueError):
        return payload


# ---------------------------------------------------------------- wykrywanie brokera

def mqtt_probe(host, port=1883, timeout=0.6):
    """None = port zamknięty; 'open' = MQTT bez logowania; 'auth' = MQTT z logowaniem;
    'mqtt' = MQTT, inny błąd; 'other' = port otwarty, ale to nie MQTT."""
    try:
        s = socket.create_connection((host, port), timeout)
    except OSError:
        return None
    try:
        s.settimeout(1.5)
        cid = b"kecaj-probe"
        rem = b"\x00\x04MQTT\x04\x02\x00\x1e" + struct.pack("!H", len(cid)) + cid
        s.sendall(b"\x10" + bytes([len(rem)]) + rem)
        r = s.recv(4)
        if len(r) >= 4 and r[0] == 0x20:
            if r[3] == 0:
                try:
                    s.sendall(b"\xe0\x00")
                except OSError:
                    pass
                return "open"
            return "auth" if r[3] in (4, 5) else "mqtt"
        return "other"
    except OSError:
        return "other"
    finally:
        s.close()


def lan_hosts():
    """Adresy do sprawdzenia: najpierw Home Assistant (z adresu strony kiosku i homeassistant.local),
    potem cała sieć /24, w której jest kiosk."""
    first, rest = [], []
    url = read_conf().get("url") or ""
    m = re.match(r"^[a-zA-Z]+://(?:[^@/]*@)?([^/:]+)", url)
    for name in ([m.group(1)] if m else []) + ["homeassistant.local", "homeassistant"]:
        try:
            ip = socket.gethostbyname(name)
            if ip not in first and not ip.startswith("127."):
                first.append(ip)
        except OSError:
            pass
    try:
        ips = subprocess.run(["hostname", "-I"], capture_output=True, text=True, timeout=5).stdout.split()
    except Exception:
        ips = []
    for ip in ips:
        if not re.match(r"^(10|172\.(1[6-9]|2\d|3[01])|192\.168)\.", ip):
            continue
        base = ip.rsplit(".", 1)[0]
        for i in range(1, 255):
            h = "%s.%d" % (base, i)
            if h != ip and h not in first and h not in rest:
                rest.append(h)
    return first, rest


def detect_mqtt(port=1883):
    first, rest = lan_hosts()
    found = {}
    lock = threading.Lock()
    hosts = first + rest

    def worker(chunk):
        for h in chunk:
            r = mqtt_probe(h, port)
            if r in ("open", "auth", "mqtt"):
                with lock:
                    found[h] = r
    n = 64
    threads = [threading.Thread(target=worker, args=(hosts[i::n],), daemon=True) for i in range(n)]
    for t in threads:
        t.start()
    for t in threads:
        t.join(30)
    out = []
    for h in sorted(found, key=lambda x: (x not in first, [int(p) for p in x.split(".")])):
        out.append({"host": h, "port": port, "login": found[h] != "open",
                    "home_assistant": h in first,
                    "note": ("Home Assistant" if h in first else "broker MQTT") +
                            (" — wymaga loginu" if found[h] == "auth" else " — bez logowania" if found[h] == "open" else "")})
    return {"brokers": out, "scanned": len(hosts)}


# ---------------------------------------------------------------- nazwa kiosku

NAME_FILE = ETC + "/name.json"
DEVICE_ID_FILE = ETC + "/device-id"
DLNA_ENV = ETC + "/dlna.env"
SATELLITE_CONF = ETC + "/satellite.conf"
SATELLITE_UNIT = "/etc/systemd/system/kiosk-satellite.service"
_PL = str.maketrans("ąćęłńóśźżĄĆĘŁŃÓŚŹŻ", "acelnoszzACELNOSZZ")
NAME_BAD = set('"\\$`\n\r\'')


def slugify(text):
    t = re.sub(r"[^a-z0-9]+", "-", str(text).translate(_PL).lower()).strip("-")
    return t[:40].strip("-") or "kiosk"


def kiosk_name():
    n = read_json(NAME_FILE, {}).get("name")
    return n if isinstance(n, str) and n.strip() else os.uname().nodename


def device_id():
    """Identyfikator urządzenia w Home Assistant — stały, niezależny od nazwy komputera,
    żeby zmiana nazwy nie tworzyła nowego urządzenia (chyba że o to poprosisz)."""
    try:
        with open(DEVICE_ID_FILE) as f:
            v = f.read().strip()
        if re.fullmatch(r"[A-Za-z0-9_]{1,64}", v):
            return v
    except OSError:
        pass
    v = "kecaj_" + re.sub(r"[^A-Za-z0-9_]", "_", os.uname().nodename)
    try:
        with open(DEVICE_ID_FILE, "w") as f:
            f.write(v + "\n")
    except OSError:
        pass
    return v


def name_info():
    slug = slugify(kiosk_name())
    return {"name": kiosk_name(), "hostname": os.uname().nodename, "prefix": read_mqtt_conf()["prefix"],
            "device_id": device_id(), "device_id_new": "kiosk_" + slug.replace("-", "_"),
            "suggest_prefix": "kiosk/" + slug}


def _set_env_line(path, key, value, quote=False):
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    val = '"%s"' % value if quote else value
    out, done = [], False
    for ln in lines:
        if re.match(r"\s*%s=" % re.escape(key), ln):
            if not done:
                out.append("%s=%s" % (key, val))
                done = True
            continue
        out.append(ln)
    if not done:
        out.append("%s=%s" % (key, val))
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(out) + "\n")
    os.replace(tmp, path)


def set_hostname(hn):
    old = os.uname().nodename
    code, out = run_cmd(["hostnamectl", "set-hostname", hn], timeout=30)
    if code != 0:
        with open("/etc/hostname", "w") as f:
            f.write(hn + "\n")
        code, out = run_cmd(["hostname", hn], timeout=10)
        if code != 0:
            raise RuntimeError("hostname: " + out)
    try:
        with open("/etc/hosts") as f:
            lines = f.read().splitlines()
        out_l, done = [], False
        for ln in lines:
            parts = ln.split()
            if parts and parts[0] == "127.0.1.1":
                if not done:
                    out_l.append("127.0.1.1\t" + hn)
                    done = True
                continue
            if parts and parts[0] not in ("127.0.0.1", "::1") and old in parts[1:] and parts[0].startswith("127."):
                continue
            out_l.append(ln)
        if not done:
            out_l.insert(1 if out_l else 0, "127.0.1.1\t" + hn)
        with open("/etc/hosts.tmp", "w") as f:
            f.write("\n".join(out_l) + "\n")
        os.replace("/etc/hosts.tmp", "/etc/hosts")
    except OSError as e:
        log("/etc/hosts: %s" % e)


def set_kiosk_name(body):
    name = str(body.get("name") or "").strip()
    if not name or len(name) > 40 or NAME_BAD & set(name):
        raise ValueError("nazwa: 1–40 znaków bez cudzysłowów, np. Salon, Kuchnia")
    slug = slugify(name)
    hn = str(body.get("hostname") or slug).strip().lower()
    if not re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", hn):
        raise ValueError("nazwa komputera: małe litery bez polskich znaków, cyfry i -, np. salon albo kiosk-kuchnia")
    old = read_mqtt_conf()
    prefix = str(body.get("prefix") or old["prefix"]).strip()
    cfg = validate_mqtt({"prefix": prefix}, old)
    new_dev = bool(body.get("new_device"))
    out = []
    # Najpierw sprzątanie zachowanych wiadomości ze starych tematów / starego urządzenia w HA.
    if BRIDGE and (cfg["prefix"] != old["prefix"] or new_dev):
        BRIDGE.forget(clear_discovery=new_dev)
    write_json(NAME_FILE, {"name": name}, 0o644)
    out.append("Nazwa: Kiosk " + name)
    if new_dev:
        with open(DEVICE_ID_FILE, "w") as f:
            f.write("kiosk_" + slug.replace("-", "_") + "\n")
        out.append("Nowe urządzenie w HA: " + device_id())
    if cfg["prefix"] != old["prefix"]:
        write_mqtt_conf(cfg)
        out.append("Tematy MQTT: %s/…" % cfg["prefix"])
    # Odtwarzacz DLNA i asystent głosowy ogłaszają się pod nową nazwą.
    try:
        _set_env_line(DLNA_ENV, "DLNA_NAME", "Kiosk " + name)
        if qrun(["systemctl", "is-active", "kiosk-dlna"]).strip() == "active":
            run_cmd(["systemctl", "restart", "kiosk-dlna"], timeout=30)
    except OSError as e:
        out.append("DLNA: %s" % e)
    try:
        _set_env_line(SATELLITE_CONF, "NAME", "Kiosk " + name, quote=True)
        if os.path.exists(SATELLITE_UNIT):
            with open(SATELLITE_UNIT) as f:
                u = f.read()
            u2 = re.sub(r'--name "[^"]*"', '--name "Kiosk %s"' % name, u)
            if u2 != u:
                with open(SATELLITE_UNIT, "w") as f:
                    f.write(u2)
                run_cmd(["systemctl", "daemon-reload"], timeout=30)
                run_cmd(["systemctl", "try-restart", "kiosk-satellite"], timeout=30)
    except OSError as e:
        out.append("Asystent: %s" % e)
    if hn != os.uname().nodename:
        set_hostname(hn)
        out.append("Nazwa komputera: " + hn)
    if BRIDGE:
        BRIDGE.start()
    return "\n".join(out)


