def ro_keep_clips():
    try:
        with open(ETC + "/ro.conf") as f:
            return "KEEP_CLIPS=yes" in f.read()
    except OSError:
        return False


def ro_next():
    """Czy tylko do odczytu będzie włączone po następnym uruchomieniu (wg overlayroot.conf na dysku)."""
    base = "/media/root-ro" if ro_active() else ""
    val = ""
    for fn in ("/etc/overlayroot.conf", "/etc/overlayroot.local.conf"):
        try:
            with open(base + fn) as f:
