def cli():
    """Polecenia dla sudo kiosk-mode (menu w terminalu)."""
    if sys.argv[1] == "--detect-mqtt":
        r = detect_mqtt()
        for b in r["brokers"]:
            print("%s\t%d\t%s" % (b["host"], b["port"], b["note"]))
        return 0 if r["brokers"] else 1
    if sys.argv[1] == "--set-mqtt":
        body = json.load(sys.stdin)
        cfg = validate_mqtt(body, read_mqtt_conf())
        write_mqtt_conf(cfg)
        print("MQTT " + ("włączone: %s:%s" % (cfg["host"], cfg["port"]) if cfg["enabled"] else "wyłączone"))
        return 0
    if sys.argv[1] == "--set-name" and len(sys.argv) > 2:
        print(set_kiosk_name({"name": sys.argv[2], "hostname": sys.argv[3] if len(sys.argv) > 3 else "",
                              "prefix": sys.argv[4] if len(sys.argv) > 4 else ""}))
        return 0
    if sys.argv[1] == "--report":
        sys.stdout.write(debug_report())
        return 0
    if sys.argv[1] == "--mqtt-info":
        c = read_mqtt_conf()
        print("%s\t%s\t%s\t%s" % ("1" if c["enabled"] else "0", c["host"], c["port"], c["user"]))
        return 0
    print("kiosk-api [--detect-mqtt | --set-mqtt < json | --mqtt-info | --set-name NAZWA [HOSTNAME] [PREFIKS]]", file=sys.stderr)
    return 2


def main():
    global BRIDGE, WEATHER, ANNOUNCER, AUTO, MOTION, FACES, UPDWATCH, PKG_VERSION, RO
    if len(sys.argv) > 1:
        sys.exit(cli())
    if not os.path.exists(TOKEN_FILE):
        sys.exit("Brak " + TOKEN_FILE)
    WEATHER = Weather()
    ANNOUNCER = Announcer()
    AUTO = Automation()
    MOTION = Motion()
    FACES = Faces()
    UPDWATCH = UpdateWatch()
    PKG_VERSION = pkg_version()
    try:
        with open(OVERLAY_CONF) as f:
            has_icons = "KIOSK_NOWPLAYING=" in f.read()
    except OSError:
        has_icons = False
    if not has_icons:
        write_overlay()
    try:
        b = read_bright()["day"]
        if b != 100:
            threading.Timer(20, BRIGHT.set, args=(b,)).start()
    except Exception:
        pass
    cert, key = TLS_DIR + "/cert.pem", TLS_DIR + "/key.pem"
    if os.path.exists(cert) and os.path.exists(key):
        import ssl
        try:
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
            ctx.load_cert_chain(cert, key)
            srv2 = ThreadingHTTPServer(("0.0.0.0", HTTPS_PORT), Handler)
            srv2.socket = ctx.wrap_socket(srv2.socket, server_side=True)
            threading.Thread(target=srv2.serve_forever, daemon=True).start()
            log("kiosk-api HTTPS na porcie %d" % HTTPS_PORT)
        except Exception as e:
            log("HTTPS: %s" % e)
    if not os.path.exists(TICKER_CONF):
        write_ticker(read_ticker())
    BRIDGE = MqttBridge()
    BRIDGE.start()
    RO = RoSaver()
    threading.Thread(target=net_loop, daemon=True).start()
    threading.Thread(target=nowplaying_loop, daemon=True).start()
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    log("kiosk-api nasłuchuje na porcie %d" % PORT)
    srv.serve_forever()


if __name__ == "__main__":
    main()
