function sigTxt(d){ if(d==null) return ''; const q=d>=-55?'bardzo dobry':d>=-67?'dobry':d>=-75?'słaby':'bardzo słaby'; return d+' dBm ('+q+')'; }
async function loadWifi(){ const r=await api('api/wifi');
  let st = r.ifaces.length ? '' : 'Brak karty Wi-Fi w tym komputerze — kiosk działa przez kabel.';
  if(r.ifaces.length && !r.wpa_supplicant) st='Brak programu wpasupplicant — Wi-Fi się nie połączy. Zainstaluj nową wersję pakietu albo: sudo apt install wpasupplicant';
  $('wfst').textContent = st || ('Adres panelu: '+r.ip);
  $('wfifs').replaceChildren(...r.ifaces.map(i=>{ const d=document.createElement('p'); d.className='hint';
    d.textContent=i.name+': '+(i.connected?('połączono z „'+i.ssid+'”, sygnał '+sigTxt(i.signal_dbm)+', adres '+(i.address||'brak')):'nie połączono')+' · oszczędzanie energii: '+(i.power_save==='on'?'WŁĄCZONE (kiosk bywa nieosiągalny)':i.power_save==='off'?'wyłączone':'?'); return d; }));
  const sel=$('wfiface'), cur=sel.value; sel.replaceChildren(...r.ifaces.map(i=>{ const o=document.createElement('option'); o.value=o.textContent=i.name; return o; })); if(cur) sel.value=cur;
  $('wff').hidden=!r.ifaces.length;
  const sv=r.saved||{}; if(!WFT){ if(sv.iface) sel.value=sv.iface; if(sv.ssid && !$('wfssid').value) $('wfssid').value=sv.ssid; $('wfmode').value=sv.mode||'dhcp';
    if(sv.address) $('wfaddr').value=sv.address; if(sv.gateway) $('wfgw').value=sv.gateway; if(sv.dns) $('wfdns').value=sv.dns; $('wfstatic').hidden=$('wfmode').value!=='static'; }
  $('wfpend').hidden=!r.pending; if(r.pending){ $('wfpendt').textContent='Nowe ustawienia Wi-Fi działają? Zostało '+r.pending+' s — potem wrócą poprzednie.'; if(!WFT) WFT=setInterval(()=>loadWifi().catch(()=>{}), 2000); }
  else if(WFT){ clearInterval(WFT); WFT=null; }
  return r; }
