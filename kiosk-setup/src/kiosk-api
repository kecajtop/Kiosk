                         "text": "%s, %d %s" % (PL_DAYS[t.tm_wday], t.tm_mday, PL_MONTHS[t.tm_mon - 1]),
                         "level": "info", "seconds": to_int(body.get("seconds", 8), 0, 3600, "seconds")})
        except Exception as e:
            out += " (bez dymku: %s)" % e
    return out


