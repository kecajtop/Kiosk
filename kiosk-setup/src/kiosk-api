(function(){
  const LONG=170;
  function wrapDetails(p, label){
    if(p.closest('details.more')) return;
    const d=document.createElement('details'); d.className='more';
    const s=document.createElement('summary'); s.textContent=label||'Więcej informacji';
    p.replaceWith(d); d.append(s, p);
  }
  function wrapLong(p){ if(p.textContent.trim().length>=LONG) wrapDetails(p); }
  document.querySelectorAll('.pane:not([data-noblock])').forEach(pane=>{
    const kids=[...pane.children]; let block=null, first=true;
    kids.forEach(el=>{
      if(el.tagName==='H2'){ return; }
      if(first && el.classList.contains('lead') && !block){ wrapDetails(el, 'Co to jest'); first=false; return; }
      const startsWithH3 = el.tagName==='H3' || (el.firstElementChild && el.firstElementChild.tagName==='H3' && el.classList.contains('adm'));
      if(startsWithH3 || !block){ block=document.createElement('div'); block.className='block'; el.before(block); }
      first=false;
      block.append(el);
      if(el.classList.contains('adm')){ block.classList.add('adm'); if(el.hidden) block.hidden=true; }
    });
    pane.querySelectorAll('.block p.hint, .block p.lead').forEach(wrapLong);
  });
  // Motyw: auto (jak w systemie) → jasny → ciemny
  const KEY='kiosk-theme2', order=['dark','light','auto'], names={auto:'Motyw: auto',light:'Motyw: jasny',dark:'Motyw: ciemny'};
