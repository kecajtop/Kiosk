class Faces:
    """Procesy rozpoznawania (jeden na kamerę) i reakcje: czujniki w HA, powitanie, alarm, nagranie."""
    HOLD = 10   # s — osoba jest „przy kamerze” jeszcze tyle po ostatnim wykryciu

    def __init__(self):
        self.procs, self.sig, self.died = {}, None, {}
        self.seen, self.pub, self.last = {}, {}, {}
        self.greeted, self.unknown_cd = {}, {}
        self.gallery, self.error = {}, ""
        self.lock = threading.Lock()
        threading.Thread(target=self._watch, daemon=True).start()

    def info(self):
        with self.lock:
            last = {str(n): {"time": time.strftime("%H:%M:%S", time.localtime(v["time"])), "names": v["names"]}
                    for n, v in self.last.items()}
            now = time.time()
            present = {str(n): sorted(k for k, t in s.items() if now - t <= self.HOLD) for n, s in self.seen.items()}
        return {"running": sorted(n for n, p in self.procs.items() if p.poll() is None), "last": last,
                "present": present, "error": self.error}

    def stop_all(self):
        for p in self.procs.values():
            try:
                p.terminate()
            except Exception:
                pass
        self.procs = {}

    def _watch(self):
        while True:
            try:
                cfg = read_faces()
                cams = read_conf()["cameras"]
                want = {n: cams[n - 1] for n in cfg["cameras"]
                        if cfg["enabled"] and faces_installed() and 1 <= n <= len(cams)}
                sig = (tuple(sorted(want.items())), cfg["fps"], cfg["size"], cfg["threshold"])
                if sig != self.sig:
                    self.sig = sig
                    self.stop_all()
                    self.died = {}
                for n, url in want.items():
                    p = self.procs.get(n)
                    if p is None or p.poll() is not None:
                        if p is not None and n not in self.died:
                            self.died[n] = time.time()
                        if time.time() - self.died.get(n, 0) < 30:
                            continue   # po awarii (np. kamera niedostępna) — ponowna próba za 30 s
                        self.died.pop(n, None)
                        self.procs[n] = self._spawn(n, url, cfg)
                self._expire()
            except Exception as e:
                log("twarze: %s" % e)
            time.sleep(2)

    def _spawn(self, n, url, cfg):
        p = subprocess.Popen([FACES_PY, FACES_WORKER, "watch", "--camera", str(n), "--url", url,
                              "--fps", str(cfg["fps"]), "--size", str(cfg["size"]), "--threshold", str(cfg["threshold"])],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, errors="replace", env=faces_env())
        threading.Thread(target=self._read, args=(n, p), daemon=True).start()
        threading.Thread(target=self._stderr, args=(n, p), daemon=True).start()
        log("twarze: kamera %d — rozpoznawanie (%g kl./s, %d px)" % (n, cfg["fps"], cfg["size"]))
        self.pub.pop(n, None)
        self._publish(n)      # stan początkowy w HA: 0 / „brak”
        return p

    def _stderr(self, n, p):
        for line in p.stderr:
            line = line.strip()
            if line and "WARN" not in line:
                log("twarze %d: %s" % (n, mask(line)[-200:]))

    def _read(self, n, p):
        for line in p.stdout:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            kind = ev.get("ev")
            if kind in ("ready", "gallery"):
                self.gallery = ev.get("gallery") or {}
                self.error = ""
            elif kind == "error":
                self.error = mask(str(ev.get("msg", "")))
                log("twarze: " + self.error)
            elif kind == "log":
                log("twarze: " + str(ev.get("msg", "")))
            elif kind == "faces":
                try:
                    self.on_faces(n, ev.get("faces") or [])
                except Exception as e:
                    log("twarze → reakcja: %s" % e)

    def on_faces(self, n, faces):
        now = time.time()
        new = []
        with self.lock:
            seen = self.seen.setdefault(n, {})
            for f in faces:
                key = f.get("name") or "?"
                if now - seen.get(key, 0) > self.HOLD:
                    new.append(f)
                seen[key] = now
            if faces:
                self.last[n] = {"time": now, "names": [f.get("name") or "nieznana" for f in faces]}
        self._publish(n)
        for f in new:
            self.appeared(n, f)

    def _expire(self):
        now = time.time()
        with self.lock:
            changed = []
            for n, s in self.seen.items():
                old = [k for k, t in s.items() if now - t > self.HOLD]
                for k in old:
                    del s[k]
                if old:
                    changed.append(n)
        for n in changed:
            self._publish(n)

    def _publish(self, n):
        with self.lock:
            keys = list(self.seen.get(n, {}))
        known = sorted(k for k in keys if k != "?")
        person = ", ".join(known) if known else ("nieznana" if keys else "brak")
        state = (len(keys), person)
        if self.pub.get(n) == state or not BRIDGE:
            return
        self.pub[n] = state
        BRIDGE.publish_raw("faces/%d" % n, str(len(keys)))
        BRIDGE.publish_raw("person/%d" % n, person)

    def appeared(self, n, f):
        cfg = read_faces()
        name, now = f.get("name"), time.time()
        log("twarz na kamerze %d: %s (podobieństwo %.2f)" % (n, name or "nieznana", f.get("sim") or 0))
        if BRIDGE:
            BRIDGE.publish_raw("face/event", json.dumps({"event_type": "rozpoznana" if name else "nieznana",
                                                         "osoba": name or "", "kamera": n,
                                                         "podobienstwo": f.get("sim") or 0}, ensure_ascii=False),
                               retain=False)
        if name:
            if cfg["greet"] and not LIGHT and now - self.greeted.get(name, 0) > cfg["greet_minutes"] * 60:
                self.greeted[name] = now
                text = cfg["greet_text"].replace("{imie}", name).replace("{imię}", name)
                threading.Thread(target=self._say, args=(text,), daemon=True).start()
            return
        if now - self.unknown_cd.get(n, 0) < 60:
            return
        self.unknown_cd[n] = now
        if cfg["unknown_action"] == "alert" and not ALERT.status()["active"]:
            try:
                ALERT.start({"camera": n, "seconds": cfg["alert_seconds"], "title": "Nieznana osoba",
                             "text": "Kamera %d" % n, "chime": True, "record": False})
            except Exception as e:
                log("twarze → alarm: %s" % e)
        if cfg["record_unknown"]:
            try:
                CLIPS.record(n, 20, "nieznana-osoba")
            except Exception as e:
                log("twarze → nagranie: %s" % e)

    @staticmethod
    def _say(text):
        try:
            say(text)
        except Exception as e:
            log("twarze → powitanie: %s" % e)


