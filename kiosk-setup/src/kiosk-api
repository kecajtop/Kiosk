def tail_file(path, n):
    if not path or not os.path.exists(path):
        return "(brak pliku %s)" % path
    r = subprocess.run(["tail", "-n", str(n), path], capture_output=True, text=True, errors="replace", timeout=10)
    return r.stdout or "(pusty plik)"


def journal(args, n):
    try:
        r = subprocess.run(["journalctl", "--no-pager", "-o", "short-iso", "-n", str(n)] + args,
                           capture_output=True, text=True, errors="replace", timeout=15)
        return (r.stdout or r.stderr or "(brak wpisów)")
    except Exception as e:
        return "(journalctl: %s)" % e


