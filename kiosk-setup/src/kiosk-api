        if not isinstance(it, dict):
            raise ValueError("pozycja %d: zły format" % i)
        t = str(it.get("time", ""))
        if not TIME_RE.match(t):
            raise ValueError("pozycja %d: godzina GG:MM" % i)
        days = sorted({int(d) for d in (it.get("days") or range(7)) if str(d).isdigit() and 0 <= int(d) <= 6})
        if not days:
            raise ValueError("pozycja %d: wybierz dni" % i)
        act = it.get("action")
        if act not in SCHEDULE_ACTIONS:
            raise ValueError("pozycja %d: akcja %s" % (i, ", ".join(SCHEDULE_ACTIONS)))
        e = {"time": t, "days": days, "action": act}
        if act == "view":
            if it.get("view") not in views:
                raise ValueError("pozycja %d: wybierz zapisany widok" % i)
            e["view"] = it["view"]
        if act == "radio":
            if not any(x["name"] == it.get("station") for x in read_radio()["stations"]):
                raise ValueError("pozycja %d: wybierz stację z ulubionych (zakładka Dźwięk → Radio)" % i)
            e["station"] = it["station"]
            e["fade"] = bool(it.get("fade", True))
        if act == "say":
            txt = str(it.get("text", "")).strip()
            if not txt or len(txt) > 300:
                raise ValueError("pozycja %d: tekst do przeczytania (do 300 znaków)" % i)
            e["text"] = txt
        items.append(e)
    if len(items) > 50:
        raise ValueError("najwyżej 50 pozycji harmonogramu")
    return {"enabled": bool(body.get("enabled", True)), "items": sorted(items, key=lambda x: x["time"])}


def run_schedule_item(it):
    a = it["action"]
    if a == "view":
        return apply_view(it["view"])
    if a == "screen_on":
        return power("screen", "on")
    if a == "screen_off":
        return power("screen", "off")
    if a == "say":
        return say(it["text"])
    if a == "reload":
        return run_cmd([KIOSK_MODE, "reload"])[1]
    if a == "radio":
        return radio_play(it["station"], fade_in=it.get("fade", True))
    if a == "stop":
        return radio_play("OFF")


