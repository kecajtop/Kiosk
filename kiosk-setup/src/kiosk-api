    def do_DELETE(self):
        if not self.authorized():
            return self.deny()
        path = self.path.split("?")[0]
        if not self.allowed("DELETE", path):
            return self.send(403, {"error": "brak uprawnień (konto domownika)"})
        from urllib.parse import unquote
        m = re.match(r"^/api/(photos|clips|users|peers)/(.+)$", path)
        if m:
            kind, name = m.group(1), unquote(m.group(2))
            try:
                if kind in ("photos", "clips"):
                    d = PHOTO_DIR if kind == "photos" else CLIP_DIR
                    f = os.path.join(d, os.path.basename(name))
                    if not os.path.isfile(f):
                        return self.send(404, {"error": "nie ma pliku"})
                    os.unlink(f)
                elif kind == "users":
                    u = read_users()
                    u.pop(name, None)
                    write_json(USERS_FILE, u, 0o600)
                    _LOGIN_CACHE.clear()
                else:
                    write_json(PEERS_FILE, [x for x in read_peers() if x["host"] != name], 0o600)
                return self.send(200, {"ok": True, "output": "Usunięto: " + name})
            except Exception as e:
                return self.send(400, {"error": str(e)})
        m = re.match(r"^/api/views/(.+)$", path)
        if not m:
            return self.send(404, {"error": "nie ma takiego adresu"})
        from urllib.parse import unquote
        name = unquote(m.group(1))
        views = read_views()
        if name not in views:
            return self.send(404, {"error": "nie ma widoku: " + name})
        del views[name]
        write_views(views)
        if read_displays()["second_view"] == name:
            d = read_displays(); d["second_view"] = ""
            write_displays(d); materialize_second(d); run_cmd([KIOSK_MODE, "reload"])
        after_change()
        return self.send(200, {"ok": True, "views": sorted(views)})

    def do_POST(self):
        if self.path.split("?")[0] == "/api/pair/claim":
            return self.pair()
        if not self.authorized():
            return self.deny()
        if not self.allowed("POST", self.path.split("?")[0]):
            return self.send(403, {"error": "brak uprawnień (konto domownika)"})
        # Tylko ta sama strona dla żądań z przeglądarki (ochrona CSRF); klienci API nie wysyłają Origin.
        origin = self.headers.get("Origin")
        if origin and origin.split("://", 1)[-1] != self.headers.get("Host", ""):
            return self.send(403, {"error": "żądanie z innej strony odrzucone"})
        path = self.path.split("?")[0]
        if path in UPLOADS:
            return self.upload(path)
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if n > 65536:
                return self.send(413, {"error": "za duże żądanie"})
            if not n and self.chunked():
                raw = self.read_chunked(65536)
            else:
                raw = self.rfile.read(n) if n else b""
            body = json.loads(raw or b"{}")
            if not isinstance(body, dict):
                raise ValueError("oczekiwany obiekt JSON")
            out = self.route(path, body)
            if out is None:
                return self.send(404, {"error": "nie ma takiego adresu"})
            after_change()
            return self.send(200, {"ok": True, "output": out})
        except (ValueError, TypeError, json.JSONDecodeError) as e:
            return self.send(400, {"error": str(e)})
        except Exception as e:
            return self.send(500, {"error": str(e)})

    def screen_live(self):
        """GET /api/screen/live?w=960&fps=10 — ekran kiosku na żywo (multipart MJPEG do <img>)."""
        from urllib.parse import parse_qs
        q = parse_qs(self.path.partition("?")[2])
        try:
            w = max(320, min(1920, int(q.get("w", ["960"])[0])))
            fps = max(1, min(20, int(q.get("fps", ["10"])[0])))
        except ValueError:
            w, fps = 960, 10
        with _LIVE_LOCK:
            if _LIVE["n"] >= 3:
                return self.send(429, {"error": "za dużo podglądów naraz (najwyżej 3)"})
            _LIVE["n"] += 1
        p = None
        try:
            p = subprocess.Popen(screen_live_cmd(w, fps), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            first = p.stdout.read1(65536)
            if not first:
                err = p.stderr.read().decode("utf-8", "replace").strip()[-200:]
                return self.send(500, {"error": "podgląd ekranu: " + (err or "ffmpeg nie ruszył")})
            self.send_response(200)
            self.send_header("Content-Type", "multipart/x-mixed-replace;boundary=kioskframe")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "close")
            self.end_headers()
            self.close_connection = True
            self.connection.settimeout(30)
            self.wfile.write(first)
            end = time.time() + 900          # najwyżej 15 min — panel łączy się ponownie
            while time.time() < end:
                data = p.stdout.read1(65536) if hasattr(p.stdout, "read1") else p.stdout.read(65536)
                if not data:
                    break
                self.wfile.write(data)
        except (OSError, ValueError):
            pass                              # przeglądarka zamknęła podgląd
        except RuntimeError as e:
            return self.send(409, {"error": str(e)})
        finally:
            if p:
                try:
                    p.kill()
                    p.wait(timeout=5)
                except Exception:
                    pass
            with _LIVE_LOCK:
                _LIVE["n"] -= 1

    def vnc_ws(self):
        """WebSocket (RFC 6455) ↔ TCP 127.0.0.1:5900 — dla noVNC w panelu."""
        from urllib.parse import parse_qs
        t = parse_qs(self.path.partition("?")[2]).get("t", [""])[0]
        if not t or _VNC_TICKETS.pop(t, 0) < time.time():
            return self.send(403, {"error": "bilet VNC nieważny"})
        key = self.headers.get("Sec-WebSocket-Key")
        if not key or "websocket" not in (self.headers.get("Upgrade") or "").lower():
            return self.send(400, {"error": "oczekiwane połączenie WebSocket"})
        import hashlib
        try:
            vnc = socket.create_connection(("127.0.0.1", VNC_PORT), timeout=5)
        except OSError as e:
            return self.send(502, {"error": "VNC: %s" % e})
        vnc.settimeout(None)
        acc = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", acc)
        proto = (self.headers.get("Sec-WebSocket-Protocol") or "").split(",")[0].strip()
        if proto:
            self.send_header("Sec-WebSocket-Protocol", proto)
        self.end_headers()
        self.wfile.flush()
        self.close_connection = True
        self.connection.settimeout(None)
        lock, done = threading.Lock(), threading.Event()
        log("VNC: podgląd ekranu z %s" % self.client_address[0])

        def send_frame(op, data):
            n = len(data)
            hdr = bytes([0x80 | op]) + (bytes([n]) if n < 126 else
                                         (bytes([126]) + struct.pack(">H", n) if n < 65536 else bytes([127]) + struct.pack(">Q", n)))
            with lock:
                self.wfile.write(hdr + data)
                self.wfile.flush()

        def vnc_to_ws():
            try:
                while not done.is_set():
                    data = vnc.recv(65536)
                    if not data:
                        break
                    send_frame(2, data)
            except OSError:
                pass
            done.set()
            try:
                send_frame(8, b"")
            except Exception:
                pass

        threading.Thread(target=vnc_to_ws, daemon=True).start()
        rf = self.rfile
        try:
            while not done.is_set():
                h = rf.read(2)
                if len(h) < 2:
                    break
                op, ln = h[0] & 0x0F, h[1] & 0x7F
                if ln == 126:
                    ln = struct.unpack(">H", rf.read(2))[0]
                elif ln == 127:
                    ln = struct.unpack(">Q", rf.read(8))[0]
                if ln > 16 * 1024 * 1024:
                    break
                mask = rf.read(4) if h[1] & 0x80 else b""
                data = rf.read(ln)
                if mask:
                    data = bytes(b ^ mask[i & 3] for i, b in enumerate(data))
                if op == 8:
                    break
                if op == 9:
                    send_frame(10, data)
                elif op in (0, 1, 2):
                    vnc.sendall(data)
        except (OSError, ValueError, struct.error):
            pass
        done.set()
        try:
            vnc.close()
        except OSError:
            pass

    def send_file(self, path, ctype):
        """Plik z obsługą Range (przewijanie nagrań w przeglądarce)."""
        size = os.path.getsize(path)
        start, end = 0, size - 1
        m = re.match(r"bytes=(\d*)-(\d*)", self.headers.get("Range", ""))
        if m and (m.group(1) or m.group(2)):
            if m.group(1):
                start = int(m.group(1))
                end = int(m.group(2)) if m.group(2) else size - 1
            else:
                start = max(0, size - int(m.group(2)))
            end = min(end, size - 1)
            self.send_response(206)
            self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end, size))
        else:
            self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(end - start + 1))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        with open(path, "rb") as f:
            f.seek(start)
            left = end - start + 1
            while left > 0:
                b = f.read(min(left, 1 << 16))
                if not b:
                    break
                self.wfile.write(b)
                left -= len(b)

