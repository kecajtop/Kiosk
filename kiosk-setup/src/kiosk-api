        return sorted(n for n in os.listdir("/sys/class/net") if os.path.isdir("/sys/class/net/%s/wireless" % n))
    except OSError:
        return []


def wifi_link(iface):
    out = qrun(["iw", "dev", iface, "link"], timeout=5)
    info = {"connected": "Connected to" in out}
    m = re.search(r"SSID: (.*)", out)
    info["ssid"] = m.group(1).strip() if m else ""
    m = re.search(r"signal: (-?\d+)", out)
    info["signal_dbm"] = int(m.group(1)) if m else None
    m = re.search(r"freq: (\d+)", out)
    info["freq"] = int(m.group(1)) if m else None
    ps = qrun(["iw", "dev", iface, "get", "power_save"], timeout=5)
    info["power_save"] = "on" if "on" in ps.lower() else ("off" if "off" in ps.lower() else "?")
    addr = qrun(["ip", "-4", "-o", "addr", "show", "dev", iface], timeout=5)
    m = re.search(r"inet (\S+)", addr)
    info["address"] = m.group(1) if m else ""
    return info


def wifi_saved():
    """Zapisana konfiguracja z netplan (bez hasła)."""
    try:
        with open(WIFI_NETPLAN) as f:
            t = f.read()
    except OSError:
        return {}
    out = {}
    m = re.search(r"^\s{4}(\S+):\s*$", t, re.M)
    if m and "wifis:" in t:
        out["iface"] = m.group(1)
    m = re.search(r'access-points:\s*\n\s*"((?:[^"\\]|\\.)*)":', t)
    if m:
        out["ssid"] = json.loads('"%s"' % m.group(1)) if m.group(1) else ""
    out["mode"] = "static" if re.search(r"dhcp4:\s*(no|false)", t) else "dhcp"
    m = re.search(r"addresses:\s*\[([^\]]*)\]", t)
    if m and out["mode"] == "static":
        out["address"] = m.group(1).strip().strip('"')
    m = re.search(r"via:\s*(\S+)", t)
    if m:
        out["gateway"] = m.group(1).strip('"')
    m = re.search(r"nameservers:\s*\n\s*addresses:\s*\[([^\]]*)\]", t)
    if m:
        out["dns"] = ",".join(x.strip().strip('"') for x in m.group(1).split(","))
    return out


def wifi_info():
    with WIFI_LOCK:
        pend = dict(WIFI_PENDING)
    left = int(pend["deadline"] - time.time()) if pend else 0
    return {"ifaces": [dict(wifi_link(i), name=i) for i in wifi_ifaces()],
            "wpa_supplicant": bool(shutil.which("wpa_supplicant")), "iw": bool(shutil.which("iw")),
            "saved": wifi_saved(), "pending": max(0, left) if pend else 0, "ip": local_ip()}


def wifi_scan(body):
    iface = str(body.get("iface") or (wifi_ifaces() or [""])[0])
    if iface not in wifi_ifaces():
        raise ValueError("brak karty Wi-Fi")
    qrun(["ip", "link", "set", iface, "up"], timeout=5)
    out = qrun(["iw", "dev", iface, "scan"], timeout=25)
    nets = {}
    for block in re.split(r"\nBSS ", "\n" + out):
        m = re.search(r"\n\s*SSID: (.+)", block)
        if not m or not m.group(1).strip() or "\\x00" in m.group(1):
            continue
        ssid = m.group(1).strip()
        sg = re.search(r"signal: (-?\d+)", block)
        sig = int(sg.group(1)) if sg else -100
        sec = bool(re.search(r"\n\s*(RSN|WPA):", block))
        if ssid not in nets or sig > nets[ssid]["signal_dbm"]:
            nets[ssid] = {"ssid": ssid, "signal_dbm": sig, "secured": sec}
    if not nets and not out.strip():
        raise RuntimeError("skanowanie nie zwróciło wyników (karta wyłączona albo brak programu iw)")
    return {"networks": sorted(nets.values(), key=lambda n: -n["signal_dbm"])[:40]}


def _yq(v):
    return json.dumps(str(v), ensure_ascii=False)        # cudzysłów JSON = poprawny napis YAML


def wifi_apply(body):
    if not shutil.which("netplan"):
        raise RuntimeError("brak netplan na tym systemie")
    if not shutil.which("wpa_supplicant"):
        raise RuntimeError("brak wpasupplicant — zainstaluj: sudo apt install wpasupplicant")
    iface = str(body.get("iface") or "")
    if iface not in wifi_ifaces():
        raise ValueError("wybierz kartę Wi-Fi")
    ssid = str(body.get("ssid") or "")
    if not 1 <= len(ssid.encode()) <= 32 or "\n" in ssid:
        raise ValueError("nazwa sieci (SSID): 1–32 znaki")
    pw = str(body.get("password") or "")
    # puste hasło przy tej samej sieci = bez zmiany; przy innej sieci = sieć otwarta
    keep = bool(body.get("keep_password")) and not pw and wifi_saved().get("ssid") == ssid
    if keep:
        try:
            m = re.search(r'password:\s*(".*")\s*$', open(WIFI_NETPLAN).read(), re.M)
            pw = json.loads(m.group(1)) if m else ""
        except (OSError, ValueError):
            pw = ""
    if pw and not 8 <= len(pw) <= 63:
        raise ValueError("hasło Wi-Fi: 8–63 znaki (puste = sieć otwarta)")
    mode = "static" if body.get("mode") == "static" else "dhcp"
    lines = ["# Wi-Fi kiosku — zmieniaj w panelu WWW (Połączenia → Wi-Fi i sieć) albo: sudo kiosk-netconfig.sh",
             "network:", "  version: 2", "  wifis:", "    %s:" % iface]
    if mode == "static":
        addr, gw = str(body.get("address") or "").strip(), str(body.get("gateway") or "").strip()
        dns = [d.strip() for d in str(body.get("dns") or gw).split(",") if d.strip()]
        if not IPV4_CIDR.match(addr):
            raise ValueError("adres z maską, np. 192.168.0.214/24")
        if not IPV4.match(gw):
            raise ValueError("brama, np. 192.168.0.1")
        if not dns or not all(IPV4.match(d) for d in dns):
            raise ValueError("serwery DNS, np. 192.168.0.1,1.1.1.1")
        lines += ["      dhcp4: false", "      addresses: [%s]" % _yq(addr),
                  "      routes:", "        - to: default", "          via: %s" % _yq(gw),
                  "      nameservers:", "        addresses: [%s]" % ", ".join(_yq(d) for d in dns)]
    else:
        lines += ["      dhcp4: true"]
    lines += ["      access-points:", "        %s:" % _yq(ssid)]
    lines += ["          password: %s" % _yq(pw)] if pw else ["          {}"]
    new = "\n".join(lines) + "\n"
    if lines[-1].strip() == "{}":
        new = new.replace("        %s:\n          {}\n" % _yq(ssid), "        %s: {}\n" % _yq(ssid))
    with WIFI_LOCK:
        if WIFI_PENDING:
            raise ValueError("poprzednia zmiana czeka na potwierdzenie")
        old = None
        try:
            with open(WIFI_NETPLAN) as f:
                old = f.read()
        except OSError:
            pass
        fd = os.open(WIFI_NETPLAN + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(new)
        os.replace(WIFI_NETPLAN + ".tmp", WIFI_NETPLAN)
        r = subprocess.run(["netplan", "generate"], capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            _wifi_restore(old)
            raise ValueError("netplan odrzucił ustawienia: " + (r.stderr or r.stdout).strip()[-300:])
        WIFI_PENDING.update({"deadline": time.time() + WIFI_ROLLBACK_S, "old": old})
    threading.Thread(target=_wifi_apply_bg, daemon=True).start()
    return ("Łączę z „%s” (%s). Potwierdź w ciągu %d s, że kiosk działa — inaczej wrócą poprzednie ustawienia."
            % (ssid, "stały adres" if mode == "static" else "DHCP", WIFI_ROLLBACK_S))


def _wifi_restore(old):
    try:
        if old is None:
            os.unlink(WIFI_NETPLAN)
        else:
            fd = os.open(WIFI_NETPLAN, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(old)
    except OSError as e:
        log("wifi: przywracanie: %s" % e)


def _wifi_apply_bg():
    time.sleep(1.5)                                   # odpowiedź zdąży dojść do przeglądarki
    r = subprocess.run(["netplan", "apply"], capture_output=True, text=True, timeout=90)
    if r.returncode != 0:
        log("wifi: netplan apply: " + (r.stderr or r.stdout).strip()[-300:])
    while True:
        time.sleep(1)
        with WIFI_LOCK:
            if not WIFI_PENDING:
                return
            if time.time() < WIFI_PENDING["deadline"]:
                continue
            old = WIFI_PENDING.get("old")
            WIFI_PENDING.clear()
        log("wifi: brak potwierdzenia — przywracam poprzednie ustawienia sieci")
        _wifi_restore(old)
        subprocess.run(["netplan", "apply"], capture_output=True, text=True, timeout=90)
        return


def wifi_confirm():
    with WIFI_LOCK:
        if not WIFI_PENDING:
            return "Nic nie czeka na potwierdzenie"
        WIFI_PENDING.clear()
    if ro_active() and os.path.exists(KIOSK_RO):
        qrun([KIOSK_RO, "save", "/etc/netplan"], timeout=60)
    return "Ustawienia Wi-Fi zachowane"


