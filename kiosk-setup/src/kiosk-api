function watchUpdate(){ clearInterval(UPT); const t0=Date.now(); let seen=false; const v0=($('upver').textContent||'');
  UPT=setInterval(async()=>{ try{ const r=await loadUpdate(); const pg=r.progress||{};
    if(r.running){ seen=true; return; }
    if(!(seen||Date.now()-t0>20000)) return;
    clearInterval(UPT);
    if(pg.state==='error') toast('Aktualizacja nieudana: '+(pg.step||'szczegóły w dzienniku poniżej'),'err');
    else if(pg.state==='idle' && !pg.step) toast('Brak nowszej wersji — zainstalowana: '+r.version,'okm');
    else { toast('Aktualizacja zakończona: '+r.version,'okm'); if(!v0.includes(r.version)) setTimeout(()=>location.reload(),3000); }
  }catch(e){ /* panel restartuje się podczas instalacji */ } }, 3000); }
