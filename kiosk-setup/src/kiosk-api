def pl_degrees(t):
    n = int(round(t))
    a = abs(n)
    words = "zero" if a == 0 else (pl_number(a) if a < 60 else str(a))
    if a == 1:
        unit = "stopień"
    elif a % 10 in (2, 3, 4) and a % 100 not in (12, 13, 14):
        unit = "stopnie"
    else:
        unit = "stopni"
    return ("minus " if n < 0 else "") + words + " " + unit


