def validate_weather(body, cur):
    cfg = dict(cur)
    if "source" in body:
        if body["source"] not in WEATHER_SOURCES:
            raise ValueError("source musi być jednym z: " + ", ".join(WEATHER_SOURCES))
        cfg["source"] = body["source"]
    if body.get("ha_url") is not None:
        u = str(body["ha_url"]).strip().rstrip("/")
        if u and not URL_RE.match(u):
            raise ValueError("ha_url: np. http://192.168.0.1:8123")
        cfg["ha_url"] = u
    if body.get("ha_token"):
        tkn = str(body["ha_token"]).strip()
        if len(tkn) > 600 or re.search(r"\s", tkn):
            raise ValueError("ha_token: wklej token bez spacji i nowych linii")
        cfg["ha_token"] = tkn
    if body.get("entity") is not None:
        e = str(body["entity"]).strip()
        if e and not ENTITY_RE.match(e):
            raise ValueError("entity: np. weather.forecast_dom")
        cfg["entity"] = e
    for k, lim in (("lat", 90), ("lon", 180)):
        if body.get(k) not in (None, ""):
            try:
                v = float(str(body[k]).replace(",", "."))
            except ValueError:
                raise ValueError(k + ": podaj liczbę, np. 52.23")
            if not -lim <= v <= lim:
                raise ValueError("%s poza zakresem" % k)
            cfg[k] = round(v, 4)
    if cfg["source"] == "ha" and not (cfg["ha_url"] and cfg["entity"] and cfg["ha_token"]):
        raise ValueError("Home Assistant: podaj adres, encję pogody i token")
    if cfg["source"] == "open-meteo" and (cfg["lat"] is None or cfg["lon"] is None):
        raise ValueError("Open-Meteo: podaj szerokość i długość geograficzną")
    return cfg


def http_json(url, headers=None, timeout=15):
    import urllib.request
    req = urllib.request.Request(url, headers=dict(headers or {}, **{"User-Agent": "kecaj-kiosk"}))
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))


def http_text(url, timeout=15):
    import urllib.request
    req = urllib.request.Request(url, headers={"User-Agent": "kecaj-kiosk"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read()
    for enc in ("utf-8", "cp1250", "latin-1"):
        try:
            return raw.decode(enc)
        except UnicodeDecodeError:
            continue
    return raw.decode("utf-8", "replace")


def fetch_weather(cfg):
    if cfg["source"] == "ha":
        d = http_json("%s/api/states/%s" % (cfg["ha_url"], cfg["entity"]),
                      {"Authorization": "Bearer " + cfg["ha_token"]})
        cond = d.get("state", "")
        at = d.get("attributes", {})
        icon, text = HA_COND.get(cond, ("☁", cond or "brak danych"))
        temp = at.get("temperature")
        return {"temp": float(temp) if temp is not None else None, "condition": cond, "icon": icon, "text": text,
                "humidity": at.get("humidity"), "wind": at.get("wind_speed")}
    if cfg["source"] == "open-meteo":
        d = http_json("https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s"
                      "&current=temperature_2m,weather_code,is_day,relative_humidity_2m,wind_speed_10m&timezone=auto"
                      % (cfg["lat"], cfg["lon"]))
        c = d.get("current", {})
        cond, text = WMO.get(int(c.get("weather_code", 3)), ("cloudy", "pochmurno"))
        if cond == "sunny" and not c.get("is_day", 1):
            cond, text = "clear-night", "bezchmurnie" if text == "bezchmurnie" else "przeważnie bezchmurnie"
        return {"temp": float(c["temperature_2m"]), "condition": cond, "icon": HA_COND[cond][0], "text": text,
                "humidity": c.get("relative_humidity_2m"), "wind": c.get("wind_speed_10m")}
    return None


class Weather:
    def __init__(self):
        self.current = None
        self.error = ""
        self.wake = threading.Event()
        threading.Thread(target=self._loop, daemon=True).start()

    def refresh(self):
        self.wake.set()

    def _loop(self):
        while True:
            cfg = read_weather_conf()
            if cfg["source"] == "off":
                self.current, self.error = None, ""
                self._write(None)
            else:
                try:
                    w = fetch_weather(cfg)
                    w["updated"] = time.strftime("%H:%M")
                    w["source"] = cfg["source"]
                    self.current, self.error = w, ""
                    self._write(w)
                except Exception as e:
                    self.error = "nie udało się pobrać pogody: %s" % e
                    log("pogoda: %s" % e)
            self.wake.wait(600)
            self.wake.clear()

    @staticmethod
    def _write(w):
        try:
            if w is None:
                if os.path.exists(WEATHER_CACHE):
                    os.unlink(WEATHER_CACHE)
                return
            tmp = WEATHER_CACHE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(w, f, ensure_ascii=False)
            os.chmod(tmp, 0o644)
            os.replace(tmp, WEATHER_CACHE)
        except Exception as e:
            log("pogoda cache: %s" % e)


