    return [{"name": s.get("name", "").strip()[:80], "url": s.get("url_resolved") or s.get("url"),
             "country": s.get("countrycode", ""), "codec": s.get("codec", ""), "bitrate": s.get("bitrate", 0)}
            for s in res if AUDIO_RE.match(str(s.get("url_resolved") or s.get("url") or ""))]


def radio_play(name_or_url, fade_in=False):
    r = read_radio()
    s = str(name_or_url or "").strip()
    if s.upper() in ("OFF", "STOP", "", "WYŁĄCZONE"):
        audio_stop()
        write_json(RADIO_FILE, {"stations": r["stations"], "playing": "", "last": r.get("last") or r.get("playing", "")}, 0o644)
        return "Radio wyłączone"
    st = next((x for x in r["stations"] if x["name"].lower() == s.lower()), None)
    url = st["url"] if st else s
    if not AUDIO_RE.match(url):
        raise ValueError("nie ma stacji „%s” na liście ulubionych" % s)
    target = audio_status().get("volume") or 50
    if fade_in:
        mpc("volume", "5")
    out = audio_play(url)
    write_json(RADIO_FILE, {"stations": r["stations"], "playing": st["name"] if st else url,
                            "last": st["name"] if st else r.get("last", "")}, 0o644)
    if fade_in:
        threading.Thread(target=fade, args=(lambda x: mpc("volume", str(x)), 5, target, 30, 2.0), daemon=True).start()
    return out.replace("Odtwarzam:", "Radio:") if not st else "Radio: " + st["name"]


def radio_step(d):
    """Poprzednia / następna stacja z ulubionych (odtwarzacz w telefonie, pilot)."""
    r = read_radio()
    names = [x["name"] for x in r["stations"]]
    if not names:
        raise ValueError("brak ulubionych stacji")
    cur = r.get("playing") or r.get("last") or ""
