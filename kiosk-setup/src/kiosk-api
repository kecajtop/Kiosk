def synth(text, voice, speed, path):
    """Tworzy plik WAV. Zwraca opis użytego silnika."""
    p = PRESETS.get(voice)
    raw = path + ".raw.wav"
    used = ""
    if p and model_ok(p["model"]):
        model = os.path.join(VOICE_DIR, p["model"] + ".onnx")
        length = p.get("length", 1.0) * 150.0 / max(speed, 1)
        r = subprocess.run([PIPER, "--model", model, "--output_file", raw, "--length_scale", "%.3f" % length,
                            "--sentence_silence", str(p.get("silence", 0.25))],
                           input=text, text=True, capture_output=True, timeout=120,
                           env=dict(os.environ, LD_LIBRARY_PATH=os.path.dirname(PIPER)))
        if r.returncode == 0 and os.path.exists(raw):
            used = "Piper " + p["model"]
        else:
            log("piper: " + (r.stderr or "")[-300:])
    if not used:
        lang = (p or {}).get("espeak", "pl") if p else voice
        if not VOICE_RE.match(lang):
            lang = "pl"
        r = subprocess.run(["espeak-ng", "-v", lang, "-s", str(speed), "-w", raw, "--stdin"],
                           input=text, text=True, capture_output=True, timeout=60)
        if r.returncode != 0 or not os.path.exists(raw):
            raise RuntimeError("synteza mowy: " + (r.stderr.strip() or "błąd"))
        used = "espeak-ng " + lang + (" (brak głosu Piper: sudo kiosk-voice install)" if p and p.get("model") else "")
    fx = FX.get((p or {}).get("fx", "clean"), FX["clean"])
    try:
        sr = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "stream=sample_rate", "-of", "csv=p=0", raw],
                            capture_output=True, text=True, timeout=10).stdout.strip() or "22050"
        r = subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", raw, "-af", fx.format(sr=int(sr)),
                            "-ar", "44100", "-ac", "2", path], capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            raise RuntimeError(r.stderr[-200:])
        os.unlink(raw)
    except Exception as e:
        log("efekty głosu pominięte: %s" % e)
        os.replace(raw, path)
    return used


def say(text, voice=None, speed=150, chime=None):
    if LIGHT:
        return "Pominięto: wersja light nie ma mowy (tekst: %s)" % str(text or "").strip()[:80]
    text = str(text or "").strip()
    if not text:
        raise ValueError("podaj tekst do przeczytania")
    if len(text) > 1000:
        raise ValueError("tekst może mieć najwyżej 1000 znaków")
    voice = str(voice or default_voice())
    if voice not in PRESETS and not VOICE_RE.match(voice):
        raise ValueError("voice: jeden z %s albo kod języka espeak (np. pl, en)" % ", ".join(PRESETS))
    speed = to_int(speed, 80, 400, "speed")
    os.makedirs(TTS_DIR, exist_ok=True)
    now = time.time()
    for f in os.listdir(TTS_DIR):
        fp = os.path.join(TTS_DIR, f)
        if f.startswith("say-") and now - os.path.getmtime(fp) > 600:
            os.unlink(fp)
    path = os.path.join(TTS_DIR, "say-%d.wav" % int(now * 1000))
    used = synth(text, voice, speed, path)
    os.chmod(path, 0o644)
    if chime is None:
        chime = audio_prefs()["chime"]
    ANNOUNCER.put(path, bool(chime), text)
    return "Czytam (%s%s): %s" % (used, ", z gongiem" if chime else "", text[:80])


