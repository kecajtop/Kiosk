def mpc(*args, timeout=20):
    env = {"MPD_HOST": read_token() + "@" + MPD_SOCKET}
    return run_cmd(["mpc"] + list(args), env, timeout=timeout)


def audio_status():
    code, out = mpc("status")
    if code != 0:
        return {"available": False, "state": "unknown", "volume": None, "title": ""}
    lines = out.splitlines()
    st, title, vol = "stopped", "", None
    for ln in lines:
        m = re.match(r"^\[(playing|paused)\]", ln)
        if m:
            st = m.group(1)
        m = re.search(r"volume:\s*(\d+)%", ln)
        if m:
            vol = int(m.group(1))
    if st != "stopped" and lines and not lines[0].startswith("["):
        title = lines[0]
    return {"available": True, "state": st, "volume": vol, "title": mask(title)}


def audio_play(url):
    url = str(url or "").strip()
    if not AUDIO_RE.match(url):
        raise ValueError("url dźwięku musi zaczynać się od http(s):// lub rtsp://")
    for args in (("clear",), ("add", url), ("play",)):
        code, out = mpc(*args)
        if code != 0:
            raise RuntimeError(out or "mpc: błąd")
    return "Odtwarzam: " + mask(url)


def audio_volume(n):
    n = to_int(n, 0, 100, "volume")
    code, out = mpc("volume", str(n))
    if code != 0:
        raise RuntimeError(out or "mpc: błąd")
    return "Głośność: %d%%" % n


