def camera_url(n):
    cams = read_conf()["cameras"]
    if not 1 <= n <= len(cams):
        raise ValueError("kamera: numer 1-%d" % len(cams))
    return cams[n - 1]


class Clips:
    MAX_FILES, MAX_BYTES = 200, 3 * 10 ** 9

    def record(self, n, seconds=20, why="alarm"):
        url = camera_url(n)
        os.makedirs(CLIP_DIR, exist_ok=True)
        name = "%s-kamera%d-%s.mp4" % (time.strftime("%Y%m%d-%H%M%S"), n, why)
        path = os.path.join(CLIP_DIR, name)

        def run():
            r = subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-rtsp_transport", "tcp", "-i", url, "-t", str(seconds),
                                "-map", "0:v:0", "-map", "0:a?", "-c", "copy", "-movflags", "+faststart", "-y", path],
                               capture_output=True, text=True, timeout=seconds + 60)
            if r.returncode != 0:
                log("nagranie kamery %d: %s" % (n, mask(r.stderr.strip())[-200:]))
                try:
                    os.unlink(path)
                except OSError:
                    pass
            else:
                os.chmod(path, 0o644)
                log("nagranie: %s" % name)
            self.prune()
        threading.Thread(target=run, daemon=True).start()
        return name

    def list(self):
        try:
            fs = [f for f in os.listdir(CLIP_DIR) if f.endswith(".mp4")]
        except OSError:
            return []
        out = []
        for f in sorted(fs, reverse=True):
            st = os.stat(os.path.join(CLIP_DIR, f))
            out.append({"name": f, "size_kb": st.st_size // 1024, "time": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(st.st_mtime))})
        return out

    def prune(self):
        items = self.list()
        total = 0
        for i, c in enumerate(items):
            total += c["size_kb"] * 1024
            if i >= self.MAX_FILES or total > self.MAX_BYTES:
                try:
                    os.unlink(os.path.join(CLIP_DIR, c["name"]))
                except OSError:
                    pass


