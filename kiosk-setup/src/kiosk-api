    server_version = "kecaj-kiosk"
    sys_version = ""

    def log_message(self, fmt, *args):
        line = fmt % args
        # Odpytywanie co kilka sekund (stan, konsola debug) zaśmiecałoby dziennik.
        if ("GET /api/debug" in line or "GET /api/status" in line) and '" 200 ' in line:
            return
        log("%s %s" % (self.client_address[0], line))

    def authorized(self):
        """Token (Bearer albo hasło w Basic) = administrator; konta z users.json = administrator/domownik."""
        self.role = None
        token = read_token()
        h = self.headers.get("Authorization", "")
        if h.startswith("Bearer "):
            self.role = "admin" if hmac.compare_digest(h[7:].strip(), token) else None
        elif h.startswith("Basic "):
            try:
                user, _, pw = base64.b64decode(h[6:]).decode().partition(":")
            except Exception:
                return False
            if hmac.compare_digest(pw, token):
                self.role = "admin"
            else:
                self.role = cached_login(user.strip().lower(), pw)
        return self.role is not None

    def allowed(self, method, path):
        if self.role == "admin" or (method == "GET" and path.startswith("/font/")):
            return True
        if method == "GET":
            return path in USER_GET
        if method == "POST":
            return path in USER_POST
        return False

    def send(self, code, body, ctype="application/json; charset=utf-8"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body, ensure_ascii=False)
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.end_headers()
        self.wfile.write(body)

    def deny(self):
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Basic realm="kiosk", charset="UTF-8"')
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.end_headers()
        self.wfile.write("Wymagane logowanie: hasło = token z: sudo kiosk-mode api-token\n".encode())

    def pair(self):
        """POST /api/pair/claim — bez logowania, tylko gdy administrator otworzył parowanie (pair_open)."""
        if self.headers.get("Origin"):   # tylko programy (dodatek HA), nie strony w przeglądarce
            return self.send(403, {"error": "parowanie tylko z dodatku Kioski"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if n > 4096:
                return self.send(413, {"error": "za duże żądanie"})
            body = json.loads(self.rfile.read(n) or b"{}") if n else {}
            if not isinstance(body, dict):
                raise ValueError("oczekiwany obiekt JSON")
            return self.send(200, pair_claim(self.client_address[0], body))
        except (ValueError, TypeError) as e:
            return self.send(403, {"error": str(e)})

