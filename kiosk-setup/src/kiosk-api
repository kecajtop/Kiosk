X11VNC_UNIT = "/etc/systemd/system/x11vnc.service"
VNC_PORT = 5900
_VNC_TICKETS = {}


def vnc_password():
    """Hasło x11vnc z usługi (-passwd X) albo z pliku -rfbauth (stały klucz DES protokołu VNC)."""
    try:
        unit = open(X11VNC_UNIT).read()
    except OSError:
        return None
    m = re.search(r"-passwd\s+(\S+)", unit)
    if m:
        return m.group(1)
    m = re.search(r"-rfbauth\s+(\S+)", unit)
    if m and os.path.exists(m.group(1)):
        for extra in ([], ["-provider", "legacy", "-provider", "default"]):
            r = subprocess.run(["openssl", "enc", "-d", "-des-ecb", "-nopad", "-nosalt", "-K", "e84ad660c4721ae0"] + extra,
                               input=open(m.group(1), "rb").read()[:8], capture_output=True, timeout=5)
            if r.returncode == 0 and r.stdout:
                return r.stdout.rstrip(b"\0").decode("latin-1")
    return None


def vnc_ticket():
    if not tcp_ok("127.0.0.1", VNC_PORT, 1.5)[0]:
        raise RuntimeError("VNC kiosku nie działa (usługa x11vnc) — sprawdź Diagnostykę")
    now = time.time()
    for k in [k for k, t in _VNC_TICKETS.items() if t < now]:
        _VNC_TICKETS.pop(k, None)
    t = base64.urlsafe_b64encode(os.urandom(24)).decode().rstrip("=")
    _VNC_TICKETS[t] = now + 60
    return {"ticket": t, "password": vnc_password() or ""}


