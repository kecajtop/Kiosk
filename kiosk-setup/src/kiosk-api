def materialize_second(cfg=None):
    """Widok drugiego ekranu -> second.conf (czyta go kiosk-layout jako użytkownik kiosku)."""
    cfg = cfg or read_displays()
    view = read_views().get(cfg["second_view"]) if cfg["others"] == "extend" else None
    if not view:
        if os.path.exists(SECOND_CONF):
            os.unlink(SECOND_CONF)
        return
    cams = view.get("cameras") or []
    if isinstance(cams, str):
        cams = re.split(r"[,\s]+", cams)
    vals = {"KIOSK_MODE": view.get("mode", "web"), "KIOSK_URL": view.get("url", ""),
            "KIOSK_RTSP_URLS": ",".join(c for c in cams if c), "KIOSK_USB_DEVICE": view.get("usb_device", "/dev/video0"),
            "KIOSK_WEB_PERCENT": str(view.get("web_percent", 50)), "KIOSK_CLOCK": view.get("clock", "off"),
            "KIOSK_CLOCK_POS": view.get("clock_position", "tr"), "KIOSK_CLOCK_SIZE": view.get("clock_size", "m")}
    tmp = SECOND_CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write("# Drugi monitor: widok „%s” (generowane przez kiosk-api)\n" % cfg["second_view"])
        for k, v in vals.items():
            f.write("%s=%s\n" % (k, shlex.quote(str(v))))
    user = read_conf()["user"]
    os.chmod(tmp, 0o640)
    try:
        import grp
        os.chown(tmp, 0, grp.getgrnam(user).gr_gid)
    except Exception:
        pass
    os.replace(tmp, SECOND_CONF)


def validate_displays(body, cur, outputs):
    cfg = dict(cur)
    names = {o["name"]: o for o in outputs}
    for key in ("main", "second"):
        if body.get(key) not in (None, ""):
            v = str(body[key])
            if v != "auto" and (not OUTPUT_RE.match(v) or (names and v not in names)):
                raise ValueError("%s: nie ma takiego wyjścia (%s)" % (key, ", ".join(names) or "brak danych z xrandr"))
            cfg[key] = v
    for key, out_key in (("main_mode", "main"), ("second_mode", "second")):
        if body.get(key) not in (None, ""):
            v = str(body[key])
            if v != "auto":
                if not MODE_RE.match(v):
                    raise ValueError(key + ": np. 1920x1080 albo auto")
                o = names.get(cfg[out_key])
                if o and o["modes"] and v not in o["modes"]:
                    raise ValueError("%s: monitor %s nie obsługuje %s" % (key, o["name"], v))
            cfg[key] = v
    if body.get("rotate") not in (None, ""):
        if body["rotate"] not in ROTATIONS:
            raise ValueError("rotate: " + ", ".join(ROTATIONS))
        cfg["rotate"] = body["rotate"]
    if body.get("others") not in (None, ""):
        if body["others"] not in OTHERS:
            raise ValueError("others: " + ", ".join(OTHERS))
        cfg["others"] = body["others"]
    if "second_view" in body:
        v = str(body["second_view"] or "")
        if v and v not in read_views():
            raise ValueError("nie ma widoku: " + v)
        cfg["second_view"] = v
    if session_mode() == "desktop":
        o = names.get(cfg["main"])
        if o and o.get("primary"):
            raise ValueError("%s to monitor pulpitu — wybierz drugie wyjście dla kiosku" % o["name"])
        return cfg
    if cfg["main"] != "auto" and cfg["main"] == cfg["second"]:
        raise ValueError("drugi monitor musi być innym wyjściem niż główny")
    return cfg


def apply_displays(body):
    outputs, err = list_outputs()
    cfg = validate_displays(body, read_displays(), outputs)
    write_displays(cfg)
    materialize_second(cfg)
    code, out = run_cmd([KIOSK_MODE, "reload"])
    if code != 0:
        raise RuntimeError(out)
    if session_mode() == "desktop":
        return "Kiosk na monitorze %s (%s, %s), pulpit bez zmian" % (
            "obok pulpitu" if cfg["main"] == "auto" else cfg["main"], cfg["main_mode"], cfg["rotate"])
    desc = {"off": "pozostałe wyłączone", "mirror": "lustro na pozostałych",
            "extend": "drugi ekran: %s" % (cfg["second_view"] or "logo (bez widoku)")}[cfg["others"]]
    return "Monitory: główny %s (%s, %s), %s" % (cfg["main"], cfg["main_mode"], cfg["rotate"], desc)


