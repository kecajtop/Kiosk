# --- parser iCal (.ics) — minimalny, bez zależności zewnętrznych -----------

_ICS_WEEKDAYS = ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]


def _ics_unfold(text):
    """RFC5545: linia zaczynająca się spacją/tabem to kontynuacja poprzedniej."""
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    out = []
    for ln in lines:
        if ln[:1] in (" ", "\t") and out:
            out[-1] += ln[1:]
        else:
            out.append(ln)
    return out


def _ics_parse_line(line):
    if ":" not in line:
        return None, {}, None
    head, value = line.split(":", 1)
    parts = head.split(";")
    name = parts[0].upper()
    params = {}
    for p in parts[1:]:
        if "=" in p:
            k, v = p.split("=", 1)
            params[k.upper()] = v
    return name, params, value


def _ics_parse_dt(value, params):
    """Zwraca (napis daty/czasu lokalnego, czy_caly_dzien)."""
    value = (value or "").strip()
    if not value:
        return None, False
    if params.get("VALUE") == "DATE" or (len(value) == 8 and value.isdigit()):
        try:
            d = datetime.datetime.strptime(value, "%Y%m%d").date()
        except ValueError:
            return None, True
        return d.isoformat(), True
    try:
        if value.endswith("Z"):
            dt = datetime.datetime.strptime(value, "%Y%m%dT%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
            dt = dt.astimezone()
        else:
            dt = datetime.datetime.strptime(value.rstrip("Z"), "%Y%m%dT%H%M%S")
            tzid = params.get("TZID")
            if tzid:
                try:
                    import zoneinfo
                    dt = dt.replace(tzinfo=zoneinfo.ZoneInfo(tzid)).astimezone()
                except Exception:
                    pass  # brak bazy stref — zostaw jako czas lokalny
    except ValueError:
        return None, False
    return dt.strftime("%Y-%m-%dT%H:%M:%S"), False


def _ics_events(text):
    events = []
    cur = None
    for ln in _ics_unfold(text):
        s = ln.strip()
        if s == "BEGIN:VEVENT":
            cur = {}
        elif s == "END:VEVENT":
            if cur is not None:
                events.append(cur)
            cur = None
        elif cur is not None and ":" in s:
            name, params, value = _ics_parse_line(s)
            if name in ("DTSTART", "DTEND"):
                cur[name] = (value, params)
            elif name == "SUMMARY":
                cur["SUMMARY"] = value.replace("\\,", ",").replace("\\;", ";").replace("\\n", " ").replace("\\N", " ")
            elif name == "RRULE":
                cur["RRULE"] = value
            elif name == "EXDATE":
                cur.setdefault("EXDATE", []).append((value, params))
    return events


def _rrule_parse(s):
    d = {}
    for part in s.split(";"):
        if "=" in part:
            k, v = part.split("=", 1)
            d[k.upper()] = v
    return d


def _expand_rrule(dtstart, rrule_str, exdates, range_start, range_end):
    """Uproszczony rozwijacz RRULE: DAILY/WEEKLY/MONTHLY/YEARLY + INTERVAL/COUNT/UNTIL.
    BYDAY jest pomijane (dla pojedynczego dnia w tygodniu i tak wynik jest ten sam,
    bo krok co INTERVAL tygodni zachowuje dzień tygodnia z DTSTART)."""
    rule = _rrule_parse(rrule_str)
    freq = rule.get("FREQ", "")
    if freq not in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY"):
        return [dtstart] if range_start <= dtstart <= range_end else []
    try:
        interval = max(1, int(rule.get("INTERVAL", "1")))
    except ValueError:
        interval = 1
    count = int(rule["COUNT"]) if rule.get("COUNT", "").isdigit() else None
    until = None
    uv = rule.get("UNTIL")
    if uv:
        try:
            if uv.endswith("Z"):
                until = datetime.datetime.strptime(uv, "%Y%m%dT%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
                until = until.astimezone().replace(tzinfo=None)
            elif "T" in uv:
                until = datetime.datetime.strptime(uv, "%Y%m%dT%H%M%S")
            else:
                until = datetime.datetime.strptime(uv, "%Y%m%d")
        except ValueError:
            until = None

    out = []
    cur = dtstart
    n = 0
    while n < 4000 and cur <= range_end:
        n += 1
        if until and cur > until:
            break
        if count is not None and n > count:
            break
        if cur >= range_start and cur.strftime("%Y%m%d") not in exdates:
            out.append(cur)
        if freq == "DAILY":
            cur = cur + datetime.timedelta(days=interval)
        elif freq == "WEEKLY":
            cur = cur + datetime.timedelta(weeks=interval)
        elif freq == "MONTHLY":
            m0 = cur.month - 1 + interval
            y = cur.year + m0 // 12
            m = m0 % 12 + 1
            day = cur.day
            moved = False
            while day >= 1:
                try:
                    cur = cur.replace(year=y, month=m, day=day)
                    moved = True
                    break
                except ValueError:
                    day -= 1
            if not moved:
                break
        elif freq == "YEARLY":
            y = cur.year + interval
            try:
                cur = cur.replace(year=y)
            except ValueError:
                cur = cur.replace(year=y, day=28)
        else:
            break
    return out


def fetch_ics_calendar(url, start_dt, end_dt):
    """Pobiera i parsuje jeden link .ics, zwraca wydarzenia w formacie jak fetch_agenda."""
    text = http_text(url, timeout=12)
    out = []
    for ev in _ics_events(text):
        if "DTSTART" not in ev:
            continue
        s_raw, s_params = ev["DTSTART"]
        start_s, all_day = _ics_parse_dt(s_raw, s_params)
        if start_s is None:
            continue
        summary = ev.get("SUMMARY", "")
        exdates = set()
        for xv, xp in ev.get("EXDATE", []):
            xs, _ = _ics_parse_dt(xv, xp)
            if xs:
                exdates.add(xs[:10].replace("-", ""))
        if "RRULE" in ev:
            fmt = "%Y-%m-%d" if all_day else "%Y-%m-%dT%H:%M:%S"
            try:
                dtstart_dt = datetime.datetime.strptime(start_s, fmt)
            except ValueError:
                continue
            dur = datetime.timedelta(hours=1)
            if "DTEND" in ev:
                e_raw, e_params = ev["DTEND"]
                end_s0, _ = _ics_parse_dt(e_raw, e_params)
                if end_s0:
                    try:
                        dur = datetime.datetime.strptime(end_s0, fmt) - dtstart_dt
                    except ValueError:
                        pass
            for occ in _expand_rrule(dtstart_dt, ev["RRULE"], exdates, start_dt, end_dt):
                out.append({"summary": summary[:80], "start": occ.strftime(fmt),
                            "all_day": all_day, "end": (occ + dur).strftime(fmt)})
        else:
            end_s = ""
            if "DTEND" in ev:
                e_raw, e_params = ev["DTEND"]
                end_s, _ = _ics_parse_dt(e_raw, e_params)
            out.append({"summary": summary[:80], "start": start_s, "all_day": all_day, "end": end_s or ""})
    return out


def fetch_agenda(cfg):
    import urllib.parse
    now = time.time()
    start = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(now - 3600))
    end = time.strftime("%Y-%m-%dT23:59:59", time.localtime(now + 86400 * max(cfg["days"] - 1, 0)))
    events = []
    if cfg["entities"]:
        url, tok = ha_conn()
        for ent in cfg["entities"]:
            q = urllib.parse.urlencode({"start": start, "end": end})
            for e in http_json("%s/api/calendars/%s?%s" % (url, ent, q), {"Authorization": "Bearer " + tok}, timeout=10):
                st, en = e.get("start", {}), e.get("end", {})
                s = st.get("dateTime") or st.get("date") or ""
                events.append({"summary": str(e.get("summary", ""))[:80], "start": s, "all_day": "dateTime" not in st,
                               "end": en.get("dateTime") or en.get("date") or ""})
    if cfg.get("ics_urls"):
        start_dt = datetime.datetime.strptime(start, "%Y-%m-%dT%H:%M:%S")
        end_dt = datetime.datetime.strptime(end, "%Y-%m-%dT%H:%M:%S")
        for u in cfg["ics_urls"]:
            try:
                events.extend(fetch_ics_calendar(u, start_dt, end_dt))
            except Exception as e:
                log("kalendarz iCal: %s" % mask(str(e)))
    events.sort(key=lambda e: e["start"])
    today = time.strftime("%Y-%m-%d")
    tomorrow = time.strftime("%Y-%m-%d", time.localtime(now + 86400))
    out = []
    for e in events:
        d = e["start"][:10]
        if e["end"] and e["end"][:16] < time.strftime("%Y-%m-%dT%H:%M") and not e["all_day"]:
            continue
        when = "dziś" if d == today else "jutro" if d == tomorrow else "%s.%s" % (d[8:10], d[5:7])
        hhmm = "" if e["all_day"] else e["start"][11:16]
        out.append({"when": when, "time": hhmm, "summary": e["summary"]})
    return out[:8]


