    return {"KIOSK_MODE": view.get("mode", "web"), "KIOSK_URL": view.get("url", ""),
            "KIOSK_RTSP_URLS": ",".join(c for c in cams if c), "KIOSK_USB_DEVICE": view.get("usb_device", "/dev/video0"),
            "KIOSK_WEB_PERCENT": str(view.get("web_percent", 50)), "KIOSK_CLOCK": view.get("clock", "off"),
            "KIOSK_CLOCK_POS": view.get("clock_position", "tr"), "KIOSK_CLOCK_SIZE": view.get("clock_size", "m")}


