def sun_brightness_pct(elevation, mn, mx):
    """Mapuje wysokość słońca na jasność: poniżej -4° (zmierzch) = min, powyżej 8° (jasny dzień) = max."""
    lo, hi = -4.0, 8.0
    f = 0.0 if elevation <= lo else (1.0 if elevation >= hi else (elevation - lo) / (hi - lo))
    return int(round(mn + (mx - mn) * f))


