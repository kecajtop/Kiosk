def log(msg):
    LOGBUF.append(time.strftime("%H:%M:%S ") + msg)
    sys.stderr.write(msg + "\n")
    sys.stderr.flush()


def mqtt_trace(direction, topic, payload):
    p = payload if isinstance(payload, str) else (payload or b"").decode("utf-8", "replace")
    if len(p) > 400:
        p = p[:400] + "…"
    MQTTBUF.append("%s %s %s  %s" % (time.strftime("%H:%M:%S"), direction, topic, p))


def read_token():
