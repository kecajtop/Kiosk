    def chunked(self):
        return "chunked" in (self.headers.get("Transfer-Encoding") or "").lower()

    def read_chunked(self, limit, out=None):
        """Treść przesyłana porcjami (Transfer-Encoding: chunked — np. przez pośrednika albo Ingress)."""
        data, total = [], 0
        while True:
            line = self.rfile.readline(1024)
            if not line:
                raise ValueError("przerwane przesyłanie")
            size = int(line.split(b";")[0].strip() or b"0", 16)
            if size == 0:
                while self.rfile.readline(1024) not in (b"\r\n", b"\n", b""):
                    pass
                break
            total += size
            if total > limit:
                raise OverflowError("plik za duży (najwyżej %d MB)" % (limit // 1_000_000))
            left = size
            while left > 0:
                chunk = self.rfile.read(min(left, 1 << 20))
                if not chunk:
                    raise ValueError("przerwane przesyłanie")
                (out.write(chunk) if out else data.append(chunk))
                left -= len(chunk)
            self.rfile.readline(16)
        return total if out else b"".join(data)

    def upload(self, path):
        """Przesyłanie pliku (surowe body): wiadomość głosowa, kopia ustawień, pakiet aktualizacji."""
        try:
            n = int(self.headers.get("Content-Length") or 0)
            limit = UPLOADS[path]
            chunked = not n and self.chunked()
            if n <= 0 and not chunked:
                return self.send(400, {"error": "pusty plik"})
            if n > limit:
                return self.send(413, {"error": "plik za duży (najwyżej %d MB)" % (limit // 1_000_000)})
            os.makedirs(UPDATE_DIR, exist_ok=True)
            tmp = os.path.join(UPDATE_DIR, "upload-%d.part" % int(time.time() * 1000))
            with open(tmp, "wb") as f:
                if chunked:
                    try:
                        n = self.read_chunked(limit, f)
                    except OverflowError as e:
                        f.close()
                        os.unlink(tmp)
                        self.close_connection = True
                        return self.send(413, {"error": str(e)})
                    left = 0 if n else 1
                else:
                    left = n
                while left > 0 and not chunked:
                    chunk = self.rfile.read(min(left, 1 << 20))
                    if not chunk:
                        break
                    f.write(chunk)
                    left -= len(chunk)
            if left:
                os.unlink(tmp)
                return self.send(400, {"error": "przerwane przesyłanie"})
            q = self.path.partition("?")[2]
            if path == "/api/message":
                out = announce_audio(tmp, "chime=0" not in q)
                os.unlink(tmp)
            elif path == "/api/photos/upload":
                from urllib.parse import parse_qs
                name = safe_name(parse_qs(q).get("name", [""])[0], IMG_EXT)
                os.makedirs(PHOTO_DIR, exist_ok=True)
                os.chmod(PHOTO_DIR, 0o755)
                dst = os.path.join(PHOTO_DIR, name)
                os.replace(tmp, dst)
                os.chmod(dst, 0o644)
                out = "Zdjęcie: " + name
            elif path == "/api/faces/upload":
                from urllib.parse import parse_qs
                try:
                    name = person_name(parse_qs(q).get("name", [""])[0])
                    if not faces_installed():
                        raise ValueError("najpierw zainstaluj rozpoznawanie twarzy")
                    r = faces_check(tmp)
                    if not r.get("faces"):
                        raise ValueError("na zdjęciu nie widać twarzy — użyj zdjęcia z twarzą na wprost")
                    if r.get("size", 0) < 60:
                        raise ValueError("twarz na zdjęciu jest za mała (%d px) — przytnij zdjęcie do twarzy" % r.get("size", 0))
                    ext = os.path.splitext(parse_qs(q).get("file", ["x.jpg"])[0])[1].lower()
                    os.replace(tmp, tmp + (ext if ext in IMG_EXT else ".jpg"))
                    tmp += ext if ext in IMG_EXT else ".jpg"
                    faces_add(name, tmp, move=True)
                finally:
                    if os.path.exists(tmp):
                        os.unlink(tmp)
                out = "Dodano zdjęcie osoby %s%s" % (name, " (na zdjęciu %d twarze — wzorcem jest największa)" % r["faces"]
                                                     if r["faces"] > 1 else "")
            elif path == "/api/restore":
                with open(tmp, "rb") as f:
                    blob = f.read()
                os.unlink(tmp)
                out = restore_backup(blob)
            else:
                deb = os.path.join(UPDATE_DIR, "kiosk-setup-upload.deb")
                os.replace(tmp, deb)
                pkg = qrun(["dpkg-deb", "-f", deb, "Package"]).strip()
                if pkg not in PKG_NAMES:
                    os.unlink(deb)
                    return self.send(400, {"error": "to nie jest pakiet kiosk-setup ani kiosk-setup-light (.deb)"})
                ver = qrun(["dpkg-deb", "-f", deb, "Version"]).strip()
                out = "Pakiet %s przesłany. " % ver + start_update("file", deb)
            log("przesłano %s (%d kB)" % (path, n // 1024))
            return self.send(200, {"ok": True, "output": out})
        except (ValueError, TypeError) as e:
            return self.send(400, {"error": str(e)})
        except Exception as e:
            log("przesyłanie %s: %s" % (path, e))
            return self.send(500, {"error": str(e)})

    def route(self, path, body):
        out = self.route_extra(path, body)
        if out is not None:
            return out
        if path == "/api/alert":
            return ALERT.start(body)
        if path == "/api/alert/stop":
            return ALERT.end()
        if path == "/api/schedule":
            cfg = validate_schedule(body)
            write_json(SCHEDULE_FILE, cfg, 0o644)
            return "Harmonogram: %d pozycji, %s" % (len(cfg["items"]), "włączony" if cfg["enabled"] else "wyłączony")
        if path == "/api/schedule/run":
            items = read_schedule()["items"]
            i = to_int(body.get("index"), 0, max(len(items) - 1, 0), "index")
            if not items:
                raise ValueError("harmonogram jest pusty")
            return str(run_schedule_item(items[i]))
        if path == "/api/presence":
            ent = str(body.get("entity", "")).strip()
            if ent and not HA_ENTITY_RE.match(ent):
                raise ValueError("encja HA, np. binary_sensor.ruch_salon")
            cfg = {"enabled": bool(body.get("enabled")), "entity": ent,
                   "off_minutes": to_int(body.get("off_minutes", 10), 1, 1440, "off_minutes"),
                   "on_absence": body.get("on_absence") if body.get("on_absence") in ("off", "photos") else "off"}
            if cfg["enabled"] and ent:
                ha_state(ent)   # od razu sprawdź, czy HA odpowiada i encja istnieje
            write_json(PRESENCE_FILE, cfg, 0o644)
            if AUTO:
                AUTO.last_seen = time.time()
            return "Obecność: %s" % (("%s, ekran gaśnie po %d min bez ruchu" % (ent or "MQTT presence/set", cfg["off_minutes"]))
                                     if cfg["enabled"] else "wyłączona")
        if path == "/api/ticker":
            items = body.get("items", [])
            if isinstance(items, str):
                items = items.splitlines()
            ents = body.get("entities", [])
            if isinstance(ents, str):
                ents = re.split(r"[,\s]+", ents)
            ents = [e for e in ents if e]
            bad = [e for e in ents if not HA_ENTITY_RE.match(e)]
            if bad:
                raise ValueError("nieprawidłowe encje: " + ", ".join(bad))
            cfg = {"enabled": bool(body.get("enabled")), "size": body.get("size") if body.get("size") in ("s", "m", "l") else "m",
                   "speed": to_int(body.get("speed", 3), 1, 10, "speed"),
                   "items": [str(x).strip()[:200] for x in items if str(x).strip()][:30], "entities": ents[:20],
                   "weather": bool(body.get("weather", True))}
            write_ticker(cfg)
            if AUTO:
                AUTO.last_ticker = 0
                AUTO.wake.set()
            run_cmd([KIOSK_MODE, "reload"])
            return "Pasek informacyjny: " + ("włączony" if cfg["enabled"] else "wyłączony")
        if path == "/api/ticker/message":
            return AUTO.set_message(body)
        if path == "/api/updates":
            return write_updates(body)
        if path == "/api/update/latest":
            if not read_updates()["url"]:
                raise ValueError("najpierw podaj adres aktualizacji")
            r = subprocess.run(["/usr/local/sbin/kiosk-update", "latest"], capture_output=True, text=True, timeout=60)
            lines = [l for l in r.stdout.splitlines() if not l.startswith("=====")]
            if r.returncode != 0:
                raise RuntimeError("Nie udało się sprawdzić: " + (" ".join(lines[-2:]) or r.stderr.strip() or "błąd"))
            return " · ".join(l for l in lines if l.startswith(("Zainstalowana", "Dostępna")))
        if path == "/api/update/switch":
            ed = str(body.get("edition") or "")
            if ed not in ("light", "full"):
                raise ValueError("edycja: light albo full")
            return start_update("switch", ed)
        if path == "/api/update/github":
            return start_update("github")
        if path == "/api/update/git":
            br = str(body.get("branch") or "main")
            if not re.match(r"^[A-Za-z0-9._/-]{1,60}$", br):
                raise ValueError("niepoprawna nazwa gałęzi")
            return start_update("git", br)
        if path == "/api/update/check":
            if not read_updates()["url"]:
                raise ValueError("najpierw podaj adres pakietu aktualizacji")
            return start_update("check")
        if path == "/api/debug/command":
            # Konsola debug: te same komendy co MQTT (<prefiks>/<komenda>), bez dowolnej powłoki.
            cmd = str(body.get("command", "")).strip().strip("/")
            pf = read_mqtt_conf()["prefix"]
            if cmd.startswith(pf + "/"):
                cmd = cmd[len(pf) + 1:]
            if not cmd:
                raise ValueError("podaj komendę, np. bubble/set")
            payload = body.get("payload", "")
            if not isinstance(payload, str):
                payload = json.dumps(payload, ensure_ascii=False)
            mqtt_trace("⌨", cmd, payload)
            log("konsola debug: %s %s" % (cmd, mask(payload)[:120]))
            return handle_command(cmd, payload) or "OK"
        if path == "/api/mode":
            return apply_mode(body)
        if path == "/api/view":
            return apply_view(str(body.get("name", "")))
        if path == "/api/views/rename":
            old, new = str(body.get("old", "")).strip(), str(body.get("new", "")).strip()
            views = read_views()
            if old not in views:
                raise ValueError("nie ma widoku: " + old)
            if not VIEW_RE.match(new):
                raise ValueError("nazwa widoku: 1-40 znaków (litery, cyfry, spacja, - _ .)")
            if new == old:
                return "Bez zmian"
            if new in views:
                raise ValueError("widok „%s” już jest" % new)
            views[new] = views.pop(old)
            write_views(views)
            # Odwołania w rotacji, harmonogramie i na drugim monitorze.
            rot = read_json(ROTATION_FILE, {})
            if isinstance(rot.get("views"), list) and old in rot["views"]:
                rot["views"] = [new if x == old else x for x in rot["views"]]
                write_json(ROTATION_FILE, rot, 0o644)
            sch = read_json(SCHEDULE_FILE, {})
            if isinstance(sch.get("items"), list) and any(isinstance(i, dict) and i.get("view") == old for i in sch["items"]):
                for i in sch["items"]:
                    if isinstance(i, dict) and i.get("view") == old:
                        i["view"] = new
                write_json(SCHEDULE_FILE, sch, 0o644)
            d = read_displays()
            if d["second_view"] == old:
                d["second_view"] = new
                write_displays(d)
            return "Zmieniono nazwę widoku: %s → %s" % (old, new)
        if path == "/api/views":
            name = str(body.get("name", "")).strip()
            if not VIEW_RE.match(name):
                raise ValueError("nazwa widoku: 1-40 znaków (litery, cyfry, spacja, - _ .)")
            views = read_views()
            if len(views) >= 50 and name not in views:
                raise ValueError("maksymalnie 50 widoków")
            src = body.get("view") if isinstance(body.get("view"), dict) else read_conf()
            v = view_from(src)
            for c in v.get("cameras", []):
                if not RTSP_RE.match(str(c)):
                    raise ValueError("adres kamery musi zaczynać się od rtsp://")
            if v.get("url") and not URL_RE.match(v["url"]):
                raise ValueError("url musi zaczynać się od http:// lub https://")
            views[name] = v
            write_views(views)
            if read_displays()["second_view"] == name:
                materialize_second()
                run_cmd([KIOSK_MODE, "reload"])
            return "Zapisano widok: " + name
        if path == "/api/power":
            return set_power_settings(body)
        if path == "/api/screen":
            return power("screen", "on" if body.get("on", True) else "off")
        if path == "/api/shutdown":
            return shutdown(body)
        if path == "/api/bubble":
            if body.get("hide"):
                return BUBBLE.hide()
            return BUBBLE.show(body)
        if path == "/api/say":
            return say(body.get("text"), body.get("voice"), body.get("speed", 150))
        if path == "/api/voices":
            return set_default_voice(str(body.get("default", "")))
        if path == "/api/time":
            return say_time(body)
        if path == "/api/weather":
            cfg = validate_weather(body, read_weather_conf())
            write_weather_conf(cfg)
            if WEATHER:
                WEATHER.refresh()
            return "Pogoda: " + {"off": "wyłączona", "ha": "z Home Assistant (%s)" % cfg["entity"],
                                 "open-meteo": "z Open-Meteo (%s, %s)" % (cfg["lat"], cfg["lon"])}[cfg["source"]]
        if path == "/api/displays":
            return apply_displays(body)
        if path == "/api/weather/say":
            return say_weather(body)
        if path == "/api/audio":
            if body.get("stop"):
                return audio_stop()
            out = []
            if "chime" in body or "duck" in body:
                upd = {}
                if "chime" in body:
                    upd["chime"] = bool(body["chime"])
                if "duck" in body:
                    upd["duck"] = to_int(body["duck"], 0, 100, "duck")
                pr = write_audio_prefs(**upd)
                out.append("Gong: %s, inne dźwięki podczas komunikatu: %d%%" % ("tak" if pr["chime"] else "nie", pr["duck"]))
            if body.get("test_chime"):
                ANNOUNCER.put(ensure_chime(), False)
                out.append("Gong")
            if body.get("volume") is not None:
                out.append(audio_volume(body["volume"]))
            if body.get("volume_step"):
                out.append(audio_volume_step(body["volume_step"]))
            if body.get("url"):
                out.append(audio_play(body["url"]))
            if not out:
                raise ValueError("podaj url, volume, volume_step lub stop")
            return "\n".join(out)
        if path == "/api/name":
            return set_kiosk_name(body)
        if path == "/api/ro":
            return ro_action(body)
        if path == "/api/wifi/scan":
            return wifi_scan(body)
        if path == "/api/wifi":
            return wifi_apply(body)
        if path == "/api/wifi/confirm":
            return wifi_confirm()
        if path == "/api/clockstyle":
            st = body.get("style", read_clock_style())
            if st not in dict(CLOCK_STYLES):
                raise ValueError("styl: " + ", ".join(k for k, _ in CLOCK_STYLES))
            col = body.get("lcd_color", read_lcd_color())
            if col not in dict(LCD_COLORS):
                raise ValueError("lcd_color: green, blue albo amber")
            write_json(CLOCK_STYLE_FILE, {"style": st, "lcd_color": col}, 0o644)
            return "Zegar: " + dict(CLOCK_STYLES)[st] + (" (podświetlenie: %s)" % dict(LCD_COLORS)[col].lower() if st.startswith("lcd") else "")
        if path == "/api/screenicons":
            corner = body.get("corner", "tl")
            if corner not in ("off", "tl", "tr", "bl", "br"):
                raise ValueError("corner: off, tl, tr, bl albo br")
            npos = body.get("nowplaying", read_icons()["nowplaying"])
            if npos not in ("off", "bc", "bl", "br", "tc"):
                raise ValueError("nowplaying: off, bc, bl, br albo tc")
            write_json(ICONS_FILE, {"corner": corner, "problems": bool(body.get("problems")), "nowplaying": npos}, 0o644)
            write_overlay()
            run_cmd([KIOSK_MODE, "reload"])
            return "Ikony stanu: " + {"off": "wyłączone", "tl": "lewy górny róg", "tr": "prawy górny róg",
                                      "bl": "lewy dolny róg", "br": "prawy dolny róg"}[corner]
        if path == "/api/mqtt":
            cfg = validate_mqtt(body, read_mqtt_conf())
            write_mqtt_conf(cfg)
            if BRIDGE:
                BRIDGE.start()
            return "MQTT " + ("włączone: %s:%s, prefiks %s" % (cfg["host"], cfg["port"], cfg["prefix"]) if cfg["enabled"] else "wyłączone")
        if path == "/api/restart":
            code, out = run_cmd([KIOSK_MODE, "reload"])
            if code != 0:
                raise RuntimeError(out)
            return out
        if path == "/api/reboot":
            subprocess.Popen(["/bin/sh", "-c", "sleep 2; /sbin/reboot"])
            return "Restart urządzenia za 2 s"
        return None


