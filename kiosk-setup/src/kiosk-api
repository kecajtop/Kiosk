def read_json(path, default):
    try:
        with open(path) as f:
            v = json.load(f)
        return v if isinstance(v, type(default)) else default
    except FileNotFoundError:
        return default
    except Exception as e:
        log("%s: %s" % (os.path.basename(path), e))
        return default


def write_json(path, data, mode=0o600):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_user_conf(path, vals, header):
    """Plik w formacie kiosk.conf czytany przez kiosk-layout (użytkownik kiosku): 0640 root:grupa użytkownika."""
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("# %s\n" % header)
        for k, v in vals.items():
            f.write("%s=%s\n" % (k, shlex.quote(str(v))))
    os.chmod(tmp, 0o640)
    try:
        import grp
        os.chown(tmp, 0, grp.getgrnam(read_conf()["user"]).gr_gid)
    except Exception:
        pass
    os.replace(tmp, path)


def view_vals(view):
    cams = view.get("cameras") or []
