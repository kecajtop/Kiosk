class Motion:
    """Proste wykrywanie ruchu: porównanie kolejnych klatek kluczowych (co 1-4 s) — mało CPU."""

    def __init__(self):
        self.procs = {}
        self.sig = None
        self.last = {}
        self.cooldown = {}
        threading.Thread(target=self._watch, daemon=True).start()

    def info(self):
        return {str(n): time.strftime("%H:%M:%S", time.localtime(t)) for n, t in self.last.items()}

    def _watch(self):
        while True:
            try:
                cfg = read_motion()
                cams = read_conf()["cameras"]
                want = {n: cams[n - 1] for n in cfg["cameras"] if cfg["enabled"] and 1 <= n <= len(cams)}
                sig = (tuple(sorted(want.items())), cfg["sensitivity"])
                if sig != self.sig:
                    self.sig = sig
                    for n, p in list(self.procs.items()):
                        p.terminate()
                    self.procs = {}
                for n, url in want.items():
                    p = self.procs.get(n)
                    if p is None or p.poll() is not None:
                        self.procs[n] = self._spawn(n, url, cfg["sensitivity"])
            except Exception as e:
                log("ruch: %s" % e)
            time.sleep(10)

    def _spawn(self, n, url, sens):
        th = max(0.012, 0.22 - sens * 0.021)   # 5 → 0,115; 10 → 0,012
        p = subprocess.Popen(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "info", "-rtsp_transport", "tcp",
                              "-skip_frame", "nokey", "-i", url, "-an",
                              "-vf", "scale=320:-2,select='gte(scene,%.3f)',metadata=print" % th,
                              "-f", "null", "-"], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                             text=True, errors="replace")
        threading.Thread(target=self._read, args=(n, p), daemon=True).start()
        log("ruch: kamera %d — wykrywanie (próg %.3f)" % (n, th))
        return p

    def _read(self, n, p):
        for line in p.stderr:
            if "lavfi.scene_score" in line:
                self.event(n)

    def event(self, n):
        now = time.time()
        first = now - self.last.get(n, 0) > 30
        self.last[n] = now
        if not first:
            return
        cfg = read_motion()
        log("ruch na kamerze %d" % n)
        if BRIDGE:
            BRIDGE.publish_raw("motion/%d" % n, "ON")
            threading.Timer(30, BRIDGE.publish_raw, args=("motion/%d" % n, "OFF")).start()
        if now - self.cooldown.get(n, 0) < 60:
            return
        self.cooldown[n] = now
        if cfg["action"] == "alert" and not ALERT.status()["active"]:
            try:
                ALERT.start({"camera": n, "seconds": cfg["alert_seconds"], "title": "Ruch", "text": "Kamera %d" % n,
                             "chime": True, "record": False})
            except Exception as e:
                log("ruch → alarm: %s" % e)
        if cfg["record"]:
            try:
                CLIPS.record(n, 20, "ruch")
            except Exception as e:
                log("ruch → nagranie: %s" % e)


