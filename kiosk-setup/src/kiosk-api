class Bubble:
    def __init__(self):
        self.proc = None
        self.lock = threading.Lock()

    def visible(self):
        return self.proc is not None and self.proc.poll() is None

    def hide(self):
        with self.lock:
            p, self.proc = self.proc, None
        if p is not None and p.poll() is None:
            try:
                os.killpg(p.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        return "Dymek ukryty"

    def show(self, body):
        if isinstance(body, str):
            body = {"text": body}
        text = str(body.get("text", "")).strip()
        title = str(body.get("title", "")).strip()
        if not text and not title:
            return self.hide()
        if len(text) > 600 or len(title) > 120:
            raise ValueError("dymek: tytuł do 120 znaków, tekst do 600")
        level = str(body.get("level", "info"))
        if level not in LEVELS:
            raise ValueError("level musi być jednym z: " + ", ".join(LEVELS))
        seconds = to_int(body.get("seconds", 10), 0, 86400, "seconds")
        user = read_conf()["user"]
        if not user:
            raise RuntimeError("brak KIOSK_USER w " + CONF)
        home = subprocess.run(["getent", "passwd", user], capture_output=True, text=True).stdout.split(":")
        home = home[5] if len(home) > 5 else "/home/" + user
        msg = json.dumps({"text": text, "title": title, "level": level, "seconds": seconds}, ensure_ascii=False)
        self.hide()
        if body.get("wake", True):
            try:
                power("screen", "on")
            except Exception as e:
                log("dymek: wybudzenie ekranu: %s" % e)
        p = subprocess.Popen(["runuser", "-u", user, "--", "env", "DISPLAY=:0", "XAUTHORITY=%s/.Xauthority" % home,
                              "python3", KIOSK_BUBBLE, msg],
                             start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        with self.lock:
            self.proc = p
        out = "Dymek: " + (title or text)[:80]
        if body.get("say"):
            try:
                say(". ".join(x for x in (title, text) if x), body.get("voice"))
                out += " (czytam na głos)"
            except Exception as e:
                out += " (bez głosu: %s)" % e
        return out


