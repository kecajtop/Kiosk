class Alert:
    """Alarm: kamera / widok / strona na ekranie na N sekund (np. dzwonek, ruch), potem powrót."""

    def __init__(self):
        self.lock = threading.Lock()
        self.timer = None
        self.until = 0
        self.what = ""

    def status(self):
        left = int(self.until - time.time())
        return {"active": left > 0, "seconds_left": max(left, 0), "what": self.what if left > 0 else ""}

    def start(self, body):
        if isinstance(body, str):
            body = {"camera": body}
        seconds = to_int(body.get("seconds", 30), 3, 3600, "seconds")
        cur = read_conf()
        cam, view, url = body.get("camera"), body.get("view"), body.get("url")
        if view:
            views = read_views()
            if view not in views:
                raise ValueError("nie ma widoku: %s" % view)
            vals, what = view_vals(views[view]), "widok " + view
        elif cam not in (None, ""):
            c = str(cam).strip()
            if c.isdigit():
                i = int(c)
                if not 1 <= i <= len(cur["cameras"]):
                    raise ValueError("kamera: numer 1-%d (kamery z zakładki Ekran)" % len(cur["cameras"]))
                c = cur["cameras"][i - 1]
                what = "kamera %d" % i
            elif RTSP_RE.match(c):
                what = "kamera " + mask(c)
            else:
                raise ValueError("camera: numer kamery (1, 2, …) albo adres rtsp://")
            vals = view_vals({"mode": "rtsp", "cameras": [c]})
        elif url:
            if not URL_RE.match(str(url)):
                raise ValueError("url: adres http(s)://")
            vals, what = view_vals({"mode": "web", "url": str(url)}), "strona"
        else:
            raise ValueError("podaj camera (numer albo rtsp://), view albo url")
        with self.lock:
            if self.timer:
                self.timer.cancel()
            self.until, self.what = time.time() + seconds, what
            self.timer = threading.Timer(seconds, self.end)
            self.timer.daemon = True
            self.timer.start()
        try:
            power("screen", "on")
        except Exception as e:
            log("alarm: wybudzenie ekranu: %s" % e)
        OVR.alert = vals
        OVR.update()
        out = "Alarm: %s na %d s" % (what, seconds)
        cam_n = None
        if cam not in (None, "") and str(cam).strip().isdigit():
            cam_n = int(str(cam).strip())
        if cam_n and body.get("record", read_motion()["record_alerts"]):
            try:
                out += ", nagranie: " + CLIPS.record(cam_n, max(seconds, 15), "alarm")
            except Exception as e:
                log("alarm → nagranie: %s" % e)
        title, text = str(body.get("title", "")).strip(), str(body.get("text", "")).strip()
        if title or text:
            BUBBLE.show({"title": title, "text": text, "level": "alert", "seconds": seconds, "wake": False,
                         "say": bool(body.get("say"))})
        elif body.get("chime", True) and ANNOUNCER:
            ANNOUNCER.put(ensure_chime(), False)
        log(out)
        return out

    def end(self):
        with self.lock:
            if self.timer:
                self.timer.cancel()
            self.timer, self.until, self.what = None, 0, ""
        if OVR.alert:
            OVR.alert = None
            OVR.update()
            log("Alarm zakończony")
        return "Alarm zakończony"


