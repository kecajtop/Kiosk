_SPEECH_RE = None


def _speech_patterns():
    global _SPEECH_RE
    if _SPEECH_RE is None:
        pats = []
        for mood, words in SPEECH_MOODS:
            parts = []
            for w in words:
                whole = w.endswith("=")
                ph = w.rstrip("=").replace("_", " ")
                parts.append(r"(?<!\w)" + re.escape(ph) + (r"(?!\w)" if whole else ""))
            pats.append((mood, re.compile("|".join(parts))))
        _SPEECH_RE = pats
    return _SPEECH_RE


def speech_mood(text):
    """Nastrój komunikatu z jego treści (do mimiki oczu na ekranie)."""
    t = " ".join(str(text or "").lower().split())
    best, score = "neutral", 0
    for mood, rx in _speech_patterns():
        n = len(rx.findall(t))
        if n > score:
            best, score = mood, n
    if score:
        return best
    if t.endswith("?"):
        return "suspicious"
    if t.endswith("!"):
        return "surprised"
    return "neutral"


def wav_info(path, step=0.06):
    """Czas trwania i krzywa głośności (0..1 co `step` s) pliku WAV 16-bit."""
    try:
        with wave.open(path, "rb") as w:
            rate, ch, sw, n = w.getframerate(), w.getnchannels(), w.getsampwidth(), w.getnframes()
            data = w.readframes(n)
        dur = n / float(rate or 1)
        if sw != 2 or not n:
            return dur, []
        cnt = len(data) // 2
        vals = struct.unpack("<%dh" % cnt, data[:cnt * 2])
        win = max(1, int(rate * step) * ch)
        env = []
        for i in range(0, cnt, win):
            chunk = vals[i:i + win:8]
            env.append(math.sqrt(sum(v * v for v in chunk) / max(1, len(chunk))) if chunk else 0.0)
        top = max(env) if env else 0
        return dur, [round(min(1.0, e / (top * 0.8)), 2) if top else 0 for e in env]
    except Exception as e:
        log("mowa (oczy): %s" % e)
        return 0.0, []


