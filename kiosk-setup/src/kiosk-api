<script>
const $ = (id) => document.getElementById(id);
let toastT;
function toast(t, cls){ const m=$('toast'); m.textContent=t; m.className=cls||''; m.hidden=false; clearTimeout(toastT); toastT=setTimeout(()=>{m.hidden=true;}, cls==='err'?9000:4500); }
function mode(){ const r=document.querySelector('input[name=mode]:checked'); return r?r.value:'web'; }
function showFields(){ const m=mode(); document.querySelectorAll('[data-for]').forEach(el=>{ el.hidden=!el.dataset.for.split(' ').includes(m); }); showClock(); }
function showClock(){ const c=$('clk').value, m=mode(); document.querySelectorAll('[data-clock]').forEach(el=>{ el.hidden=c!=='corner'; });
  $('clkhint').textContent = c==='tile' ? (m==='rtsp'||m==='mix' ? 'Zegar zajmie jedno pole siatki obok kamer. Bez kamer — zegar na cały ekran.' : 'W tym trybie nie ma siatki — zegar pokaże się w rogu.') : ''; }
function fmtUp(s){ const d=Math.floor(s/86400), h=Math.floor(s%86400/3600), m=Math.floor(s%3600/60); return (d?d+' d ':'')+h+' h '+m+' min'; }
const names={web:'Strona WWW', rtsp:'Kamery', mix:'Strona + kamery', usb:'Kamera USB'};
const astates={playing:'gra', paused:'pauza', stopped:'cisza', unknown:'niedostępny'};
function cell(label, value){ const d=document.createElement('div'); const b=document.createElement('b'); b.textContent=label; d.append(b, value); return d; }
function okDot(on, text){ const s=document.createElement('span'); const dot=document.createElement('span'); dot.className='dot'; dot.style.background=on?'var(--ok)':'var(--bad)'; s.append(dot, text); return s; }
async function api(path, opts){ const r=await fetch(path, Object.assign({headers:{'Content-Type':'application/json'}}, opts||{})); const j=await r.json().catch(()=>({error:'Błędna odpowiedź ('+r.status+')'})); if(!r.ok) throw new Error(j.error||('Błąd '+r.status)); return j; }
const post=(path, body)=>api(path, {method:'POST', body:JSON.stringify(body||{})});
async function act(fn, okMsg){ document.querySelectorAll('button').forEach(b=>b.disabled=true); try{ const r=await fn(); toast(okMsg || (r && r.output) || 'Gotowe', 'okm'); setTimeout(loadStatus, 2500); } catch(e){ toast(e.message,'err'); } finally { document.querySelectorAll('button').forEach(b=>b.disabled=false); } }
let volTouched=false;
async function loadStatus(){
  try{
    const s=await api('api/status');
    $('host').replaceChildren('Kiosk '+(s.name||s.hostname), Object.assign(document.createElement('small'),{textContent:s.hostname+' · '+s.time})); if(s.name){ document.querySelectorAll('.kname').forEach(e=>{ e.textContent=s.name; }); document.title='Kiosk '+s.name+' — panel'; }
    if(s.device_id && DID!==s.device_id){ DID=s.device_id; fillHelp($('mprefix').value||'kecaj/kiosk', $('mhost').value||'192.168.0.1'); } if(host!==s.hostname.replace(/[^A-Za-z0-9_]/g,'_')){ host=s.hostname.replace(/[^A-Za-z0-9_]/g,'_'); loadMqtt().catch(()=>{}); }
    const a=s.audio||{};
    rdNow(a); npUpdate(s.now_playing, a); if(RADIO && a.state==='stopped' && RADIO.playing){ RADIO.playing=null; rdTiles(); }
    if(a.volume!=null) $('pvol').textContent=a.volume+'%'; SCR=s.screen; $('pscr').classList.toggle('on', s.screen==='on'); $('pscr').textContent=s.screen==='off'?'⏻ Włącz ekran':'⏻ Wyłącz ekran';
    $('stat').replaceChildren(
      cell('Tryb', (names[s.mode]||s.mode)+(s.view?' · '+s.view:'')),
      cell('Monitor', okDot(s.screen==='on', s.screen==='on'?'włączony':(s.screen==='off'?'wyłączony':'nieznany'))),
      cell('Kamery', String(s.camera_players)),
      cell('Dźwięk', astates[a.state]||a.state||'—'),
      cell('Wyłączenie', s.shutdown_scheduled ? s.shutdown_scheduled+(s.shutdown_in_s!=null?' (za '+fmtUp(s.shutdown_in_s)+')':'') : 'brak'),
      ...(s.network_hw && s.network_hw.mac ? [cell('MAC', s.network_hw.mac+' · '+s.network_hw.iface+(s.network_hw.wifi?' (Wi-Fi, WOL zwykle nie działa)':(s.network_hw.wol===true?' · WOL włączone':(s.network_hw.wol===false?' · WOL wyłączone':''))))] : []),
      cell('Pogoda', s.weather ? (s.weather.icon+' '+(s.weather.temp!=null?Math.round(s.weather.temp)+'°C':'')) : '—'),
      cell('Czas pracy', fmtUp(s.uptime_s)),
      ...(s.ro ? [cell('Dysk', 'tylko odczyt')] : []),
      ...(netChip(s.net) ? [cell('Połączenia', netChip(s.net))] : []),
      ...(s.now_playing && s.now_playing.state==='playing' ? [cell('Gra', [s.now_playing.artist, s.now_playing.title||s.now_playing.station].filter(Boolean).join(' — ').slice(0,60)+' ('+s.now_playing.source+')')] : []));
    if(!volTouched && a.volume!=null){ $('vol').value=a.volume; $('volv').textContent=a.volume; }
    document.querySelectorAll('.view').forEach(v=>v.classList.toggle('on', v.dataset.name===s.view));
  }catch(e){ $('stat').replaceChildren(cell('Błąd', e.message)); }
}
const NETN={lan:'LAN', wifi:'Wi-Fi', internet:'Internet', ha:'HA', mqtt:'MQTT'};
function netChip(n){ if(!n) return null; const keys=Object.keys(NETN).filter(k=>n[k]); if(!keys.length) return null;
  const s=document.createElement('span'); keys.forEach((k,i)=>{ const it=n[k]; const d=okDot(it.state!=='bad', NETN[k]+(k==='wifi'&&it.quality!=null?' '+it.quality+'%':''));
    if(it.state==='warn') d.firstChild.style.background='var(--amber)'; d.title=it.ssid||it.iface||it.host||''; if(i) d.style.marginLeft='10px'; s.append(d); }); return s; }
async function loadClockStyles(){ const r=await api('api/clockstyle'); const t=Date.now();
  $('lcdcol').replaceChildren(...r.lcd_colors.map(c=>{ const o=document.createElement('option'); o.value=c.id; o.textContent=c.name; return o; })); $('lcdcol').value=r.lcd_color;
  $('clkstyles').replaceChildren(...r.styles.map(st=>{ const b=document.createElement('button'); b.type='button'; b.setAttribute('role','radio'); b.setAttribute('aria-checked', st.id===r.style);
    const im=document.createElement('img'); im.alt=''; im.loading='lazy'; im.src='api/clock/preview?style='+st.id+'&t='+t; b.append(im, st.name);
    b.onclick=()=>act(()=>post('api/clockstyle',{style:st.id})).then(()=>{ $('clkstyles').querySelectorAll('button').forEach(x=>x.setAttribute('aria-checked', x===b)); }); return b; })); }
$('lcdcol').onchange=()=>act(()=>post('api/clockstyle',{lcd_color:$('lcdcol').value})).then(()=>loadClockStyles().catch(()=>{}));
async function loadIcons(){ const r=await api('api/screenicons'); $('iccorner').value=r.corner; $('icprob').checked=r.problems; $('icnp').value=r.nowplaying||'bc';
  const n=r.net||{}; $('icnow').textContent=Object.keys(NETN).filter(k=>n[k]).map(k=>NETN[k]+': '+({ok:'działa',warn:'słaby sygnał',bad:'brak'}[n[k].state]||'?')).join(' · '); }
$('icf').addEventListener('submit', e=>{ e.preventDefault(); act(()=>post('api/screenicons',{corner:$('iccorner').value, problems:$('icprob').checked, nowplaying:$('icnp').value})).then(()=>loadIcons().catch(()=>{})); });
async function loadConfig(){
  const c=await api('api/config');
  (document.querySelector('input[name=mode][value="'+c.mode+'"]')||document.querySelector('input[name=mode]')).checked=true;
  $('url').value=c.url||''; $('cams').value=(c.cameras||[]).join('\n'); $('dev').value=c.usb_device||'/dev/video0';
  $('pct').value=c.web_percent||50; $('pctv').textContent=$('pct').value;
  $('clk').value=c.clock||'off'; $('clkpos').value=c.clock_position||'tr'; $('clksize').value=c.clock_size||'m'; showFields();
  $('sto').value=c.screen_off_minutes; $('sda').value=c.shutdown_after_minutes;
}
function modeLabel(v){ const base=modeLabel0(v); return v.clock&&v.clock!=='off' ? base+' · zegar' : base; }
function modeLabel0(v){ const m=names[v.mode]||v.mode; if(v.mode==='rtsp') return m+' ('+(v.cameras||[]).length+')'; if(v.mode==='mix') return m+' ('+(v.cameras||[]).length+' kam., '+(v.web_percent||50)+'%)'; return m; }
async function loadViews(){
  const v=await api('api/views'); const box=$('views'); box.replaceChildren();
  const keys=Object.keys(v).sort((a,b)=>a.localeCompare(b,'pl'));
  if(!keys.length){ const p=document.createElement('p'); p.className='hint'; p.textContent='Nie ma jeszcze widoków — kliknij „+ Nowy widok”.'; box.append(p); }
  keys.forEach(k=>{
    const row=document.createElement('div'); row.className='view'; row.dataset.name=k;
    const t=document.createElement('div'); const n=document.createElement('strong'); n.textContent=k; const sm=document.createElement('small'); sm.textContent=modeLabel(v[k]); t.append(n, sm);
    const b=document.createElement('div'); b.className='row';
    const show=document.createElement('button'); show.type='button'; show.textContent='Pokaż'; show.className='primary'; show.onclick=()=>act(()=>post('api/view',{name:k}), 'Widok „'+k+'” na ekranie').then(loadConfig);
    const ed=document.createElement('button'); ed.type='button'; ed.textContent='Edytuj'; ed.setAttribute('aria-label','Edytuj widok '+k); ed.hidden=ME!=='admin';
    ed.onclick=()=>vedOpen(k).catch(e=>toast(e.message,'err'));
    const del=document.createElement('button'); del.type='button'; del.textContent='Usuń'; del.setAttribute('aria-label','Usuń widok '+k); del.hidden=ME!=='admin';
    del.onclick=()=>{ if(confirm('Usunąć widok „'+k+'”?')) act(()=>api('api/views/'+encodeURIComponent(k),{method:'DELETE'}), 'Usunięto').then(loadViews); };
    b.append(show, ed, del); row.append(t, b); box.append(row);
  });
  loadStatus();
}
$('mdetect').onclick=async()=>{
  const b=$('mdetect'); b.disabled=true; $('mdres').textContent='Szukam brokera MQTT w sieci (do 30 s)…';
  try{
    const r=await api('api/mqtt/detect');
