class Announcer:
    """Kolejka komunikatów głosowych: gong, mowa; muzyka (MPD) i odtwarzacz DLNA grają
    w tym czasie ciszej. Komunikaty po kolei, bez przerywania muzyki."""

    def __init__(self):
        self.q = queue.Queue()
        self.proc = None
        threading.Thread(target=self._run, daemon=True).start()

    def put(self, path, chime, text=None):
        """text: treść komunikatu (None = to nie mowa, np. sam gong)."""
        self.q.put((path, chime, text))

    def stop(self):
        try:
            while True:
                self.q.get_nowait()
        except queue.Empty:
            pass
        p = self.proc
        if p is not None and p.poll() is None:
            p.terminate()

    def _run(self):
        while True:
            batch = [self.q.get()]
            time.sleep(0.5)          # kilka komunikatów naraz: jedno przyciszenie na całą serię
            try:
                while True:
                    batch.append(self.q.get_nowait())
            except queue.Empty:
                pass
            try:
                self._play(batch)
            except Exception as e:
                log("komunikat: %s" % e)

    def _render(self, path, chime, vol):
        """Gong + mowa w jednym pliku, głośność jak suwak „Głośność”."""
        out = path[:-4] + "-play.wav"
        inputs = (["-i", ensure_chime()] if chime else []) + ["-i", path]
        n = len(inputs) // 2
        chain = "".join("[%d:a]aformat=sample_rates=44100:channel_layouts=stereo[a%d];" % (i, i) for i in range(n))
        chain += "".join("[a%d]" % i for i in range(n)) + "concat=n=%d:v=0:a=1,volume=%.2f[o]" % (n, vol / 100.0)
        r = subprocess.run(["ffmpeg", "-v", "error", "-y"] + inputs + ["-filter_complex", chain, "-map", "[o]", out],
                           capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            log("komunikat: ffmpeg: " + r.stderr[-200:])
            return path
        return out

    def _aplay(self, f):
        for dev in ("sysdefault", "default"):
            self.proc = subprocess.Popen(["aplay", "-q", "-D", dev, f], stderr=subprocess.PIPE)
            try:
                _, err = self.proc.communicate(timeout=300)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                err = b""
            if self.proc.returncode in (0, -15):
                return
            log("komunikat: aplay %s: %s" % (dev, err.decode("utf-8", "replace").strip()[-200:]))

    def _play(self, batch):
        prefs = audio_prefs()
        duck = prefs["duck"]
        st = audio_status()
        vol = st["volume"] if st.get("available") and st.get("volume") is not None else 80
        files = [self._render(p, c, vol) for p, c, _ in batch]
        restore = []
        try:
            if duck < 100:
                if st.get("state") == "playing" and st.get("volume") is not None:
                    fade(lambda x: mpc("volume", str(x)), st["volume"], st["volume"] * duck // 100)
                    restore.append(("mpd", st["volume"]))
                d = dlna_state()
                if d and d[1]:
                    fade(dlna_volume, d[0], d[0] * duck // 100)
                    restore.append(("dlna", d[0]))
            for i, f in enumerate(files):
                if i:
                    time.sleep(0.4)
                path, chime, text = batch[i]
                if text is not None:
                    dur, env = wav_info(path)
                    lead = wav_info(ensure_chime())[0] if chime and f != path else 0.0
                    start = time.time() + lead
                    write_speaking({"active": True, "start": start, "end": start + dur, "step": 0.06, "env": env,
                                    "mood": speech_mood(text), "text": str(text)[:200]})
                self._aplay(f)
                if text is not None:
                    write_speaking({"active": False, "end": time.time()})
        finally:
            self.proc = None
            time.sleep(0.3)
            for kind, v in restore:
                if kind == "mpd":
                    fade(lambda x: mpc("volume", str(x)), v * duck // 100, v, steps=8)
                else:
                    fade(dlna_volume, v * duck // 100, v, steps=8)
            for f, (p, _, _) in zip(files, batch):
                if f != p:
                    try:
                        os.unlink(f)
                    except OSError:
                        pass


