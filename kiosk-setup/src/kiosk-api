# Jasność: DDC/CI (prawdziwe podświetlenie monitora, ddcutil) albo programowo (xrandr --brightness).
class Brightness:
    def __init__(self):
        self.lock = threading.Lock()
        self.ddc = None            # numer monitora w ddcutil albo "" (brak)
        self.ddc_checked = 0
        self.method = ""
        self.value = None

    def _ddc_display(self, output):
        if time.time() - self.ddc_checked < 600 and self.ddc is not None:
            return self.ddc
        self.ddc_checked = time.time()
        self.ddc = ""
        out = qrun(["ddcutil", "detect", "--terse"], timeout=30)
        disps = re.findall(r"Display (\d+)\s*\n(?:.*\n)*?\s*DRM[_ ]connector:\s*\S*?-(\S+)", out)
        norm = lambda x: re.sub(r"[^a-z0-9]", "", x.lower()).replace("hdmia", "hdmi")
        for num, conn in disps:
            if output and norm(conn) == norm(output):
                self.ddc = num
                break
        if not self.ddc and len(disps) == 1:
            # Jedyny monitor z DDC/CI bierzemy tylko wtedy, gdy podłączony jest jeden monitor —
            # inaczej przyciemnialiśmy np. monitor pulpitu (HDMI) zamiast kiosku na VGA.
            outs, _ = list_outputs()
            if not output or sum(1 for o in outs if o["connected"]) <= 1:
                self.ddc = disps[0][0]
        return self.ddc

    @staticmethod
    def _ddc_set(display, pct):
        """setvcp + sprawdzenie getvcp: część monitorów (zwłaszcza na VGA) przyjmuje polecenie,
        ale jasność się nie zmienia — wtedy przyciemniamy programowo."""
        r = subprocess.run(["ddcutil", "--display", display, "setvcp", "10", str(pct)], capture_output=True, timeout=30)
        if r.returncode != 0:
            return False
        m = re.search(r"VCP 10 C (\d+) (\d+)", qrun(["ddcutil", "--display", display, "getvcp", "10", "--terse"],
                                                     timeout=30))
        if not m:
            return True     # monitor nie podaje wartości — ufamy setvcp
        cur, mx = int(m.group(1)), max(1, int(m.group(2)))
        return abs(cur - round(pct * mx / 100.0)) <= max(2, mx // 50)

    def set(self, pct):
        pct = to_int(pct, 5, 100, "jasność")
        out = display_areas().get("main_output", "")
        how = read_bright()["method"]
        with self.lock:
            d = self._ddc_display(out) if how != "soft" else ""
            # Odwrotna jasność: część monitorów ma odwróconą skalę DDC/CI (mniej = jaśniej).
            hw = bool(d) and self._ddc_set(d, 100 - pct if read_bright()["invert"] else pct)
            if how == "ddc" and not hw:
                raise RuntimeError("monitor nie zmienia jasności przez DDC/CI (częste na VGA) — wybierz sposób „programowo”")
            if hw:
                self.method = "DDC/CI (podświetlenie monitora)"
                if os.path.exists(BRIGHT_RUN):
                    os.unlink(BRIGHT_RUN)
                    if out:
                        xrun("xrandr", "--output", out, "--brightness", "1")
            else:
                self.method = "programowo (xrandr)" + (" — monitor nie obsługuje DDC/CI" if how == "auto" else "")
                v = "%.2f" % max(0.1, pct / 100.0)
                with open(BRIGHT_RUN, "w") as f:
                    f.write(v + "\n")
                os.chmod(BRIGHT_RUN, 0o644)
                if out:
                    xrun("xrandr", "--output", out, "--brightness", v)
            self.value = pct
        return "Jasność %d%% — %s" % (pct, self.method)


