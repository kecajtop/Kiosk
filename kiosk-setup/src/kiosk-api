def power(*args):
    code, out = run_cmd([KIOSK_POWER] + list(args), timeout=30)
    if code != 0:
        raise RuntimeError(out or "kiosk-power: błąd")
    return out


def screen_state():
    try:
        return run_cmd([KIOSK_POWER, "screen", "status"], timeout=10)[1] or "unknown"
    except Exception:
        return "unknown"


def shutdown_at():
    """Czas zaplanowanego wyłączenia (epoch) z systemd albo None."""
    try:
        with open("/run/systemd/shutdown/scheduled") as f:
            for line in f:
                if line.startswith("USEC="):
                    return int(line[5:]) / 1e6
    except Exception:
        pass
    return None


def shutdown_scheduled():
    t = shutdown_at()
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(t)) if t else ""


def shutdown_in_s():
    """Sekundy do zaplanowanego wyłączenia (None = nic nie zaplanowano)."""
    t = shutdown_at()
    return max(0, int(t - time.time())) if t else None


_NETHW = {"t": 0, "data": None}


def net_hw():
    """Interfejs trasy domyślnej: nazwa, MAC, Wi-Fi czy kabel, Wake-on-LAN (ethtool) — pamiętane 5 min."""
    if _NETHW["data"] and time.time() - _NETHW["t"] < 300:
        return _NETHW["data"]
    iface = ""
    try:
        with open("/proc/net/route") as f:
            for line in f.readlines()[1:]:
                parts = line.split()
                if len(parts) > 2 and parts[1] == "00000000":
                    iface = parts[0]
                    break
    except OSError:
        pass
    if not iface:   # bez trasy domyślnej — pierwszy fizyczny interfejs
        try:
            iface = next((n for n in sorted(os.listdir("/sys/class/net")) if os.path.exists("/sys/class/net/%s/device" % n)), "")
        except OSError:
            pass
    out = {"iface": iface, "mac": "", "wifi": False, "wol": None}
    if iface:
        try:
            with open("/sys/class/net/%s/address" % iface) as f:
                out["mac"] = f.read().strip().upper()
        except OSError:
            pass
        out["wifi"] = os.path.isdir("/sys/class/net/%s/wireless" % iface)
        m = re.search(r"^\s*Wake-on:\s*(\S+)", qrun(["ethtool", iface], timeout=5), re.M)
        if m:
            out["wol"] = "g" in m.group(1)   # g = magic packet
    _NETHW.update(t=time.time(), data=out)
    return out


def set_power_settings(body):
    msgs = []
    if body.get("screen_off_minutes") is not None:
        n = to_int(body["screen_off_minutes"], 0, 1440, "screen_off_minutes")
        code, out = run_cmd([KIOSK_MODE, "screen-timeout", str(n)])
        if code != 0:
            raise RuntimeError(out)
        msgs.append("Ekran gaśnie po: %s" % ("%d min bez dotyku" % n if n else "nigdy"))
    if body.get("shutdown_after_minutes") is not None:
        n = to_int(body["shutdown_after_minutes"], 0, 10080, "shutdown_after_minutes")
        code, out = run_cmd([KIOSK_MODE, "power-off-after", str(n)])
        if code != 0:
            raise RuntimeError(out)
        msgs.append("Wyłączenie komputera: %s" % ("%d min po starcie" % n if n else "nie"))
    if not msgs:
        raise ValueError("podaj screen_off_minutes i/lub shutdown_after_minutes")
    return "\n".join(msgs)


def shutdown(body):
    if body.get("cancel"):
        return power("cancel")
    return power("shutdown", str(to_int(body.get("in_minutes", 0), 0, 10080, "in_minutes")))


