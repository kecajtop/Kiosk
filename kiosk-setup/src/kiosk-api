_LOGIN_CACHE = {}


def cached_login(user, pw):
    import hashlib
    key = hashlib.sha256(("%s\0%s" % (user, pw)).encode()).hexdigest()
    hit = _LOGIN_CACHE.get(key)
    if hit and time.time() - hit[1] < 600:
        return hit[0]
    role = check_user(user, pw)
    if role:
        _LOGIN_CACHE[key] = (role, time.time())
    return role


