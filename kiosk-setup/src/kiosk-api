    for k, key in zip(DISPLAY_KEYS, ("main", "main_mode", "rotate", "others", "second", "second_mode", "second_view")):
        lines.append("%s=%s" % (k, shlex.quote(str(cfg[key]))))
    tmp = DISPLAYS_CONF + ".tmp"
