def parse_xrandr(text):
    outs, cur = [], None
    for line in text.splitlines():
        if not line.strip() or line.startswith("Screen"):
            continue
        if not line[0].isspace():
            parts = line.split()
            if len(parts) < 2 or parts[1] not in ("connected", "disconnected"):
                cur = None
                continue
            geom = next((p for p in parts[2:] if re.match(r"^\d+x\d+\+\d+\+\d+$", p)), "")
            cur = {"name": parts[0], "connected": parts[1] == "connected", "primary": "primary" in parts[2:3],
                   "geometry": geom, "modes": [], "current": "", "preferred": ""}
            outs.append(cur)
        elif cur is not None:
            parts = line.split()
            if parts and MODE_RE.match(parts[0]):
                m = parts[0]
                if m not in cur["modes"]:
                    cur["modes"].append(m)
                if "*" in line:
                    cur["current"] = m
                if "+" in "".join(parts[1:]):
                    cur["preferred"] = cur["preferred"] or m
    return outs


def list_outputs():
    try:
        r = xrun("xrandr", "--query")
        if r.returncode != 0:
            return [], (r.stderr.strip() or "xrandr: błąd")[:200]
        return parse_xrandr(r.stdout), ""
    except Exception as e:
        return [], str(e)


def read_displays():
    script = ". " + shlex.quote(DISPLAYS_CONF) + " >/dev/null 2>&1; " + "; ".join(
        'printf "%s\\0" "${' + k + '}"' for k in DISPLAY_KEYS)
    try:
        out = subprocess.run(["sh", "-c", script], capture_output=True, timeout=5).stdout.decode()
    except Exception:
        out = ""
    vals = out.split("\0")
    cfg = dict(DISPLAY_DEFAULTS)
    for i, k in enumerate(("main", "main_mode", "rotate", "others", "second", "second_mode", "second_view")):
        if i < len(vals) and vals[i]:
            cfg[k] = vals[i]
    return cfg


