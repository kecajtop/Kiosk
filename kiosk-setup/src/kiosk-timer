#!/usr/bin/env python3
"""Minutnik (odliczanie) w rogu ekranu kiosku.

  kiosk-timer --corner br --area 1920x1080+0+0

Stan zapisuje kiosk-api do /run/kiosk-timer.json (start/anuluj w panelu WWW,
zakładka Automatyka → Minutnik). Kartę rysuje ImageMagick (czcionka DejaVu),
Tk ją tylko wyświetla. Bez aktywnego minutnika karta się chowa.
"""
import argparse
import json
import os
import subprocess
import tempfile
import time
import tkinter as tk

BG, INK, MUTED, LINE, ACCENT = "#0E1216", "#F3F5F7", "#A3AEB9", "#26303A", "#F2A900"
FONT = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
FONT_BOLD = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
SRC = "/run/kiosk-timer.json"


def read_state():
    try:
        with open(SRC) as f:
            return json.load(f)
    except Exception:
        return {"active": False}


def render(label, left, total, pt, out):
    mm, ss = divmod(max(0, int(left)), 60)
    rows = ["(", "-background", BG, "-fill", ACCENT, "-font", FONT_BOLD, "-pointsize", str(int(pt * 0.8)),
            "label:" + (label or "Minutnik"), ")",
            "(", "-background", BG, "-fill", INK, "-font", FONT_BOLD, "-pointsize", str(int(pt * 1.7)),
            "label:%d:%02d" % (mm, ss), ")"]
    pad = max(8, int(pt * 0.4))
    cmd = ["convert"] + rows + ["-background", BG, "-gravity", "center", "-append",
                                "-bordercolor", BG, "-border", "%dx%d" % (pad * 2, pad),
                                "-bordercolor", LINE, "-border", "2", "PNG24:" + out]
    subprocess.run(cmd, check=True, timeout=20)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--corner", default="br", choices=["tl", "tr", "bl", "br"])
    ap.add_argument("--area", required=True, help="WxH+X+Y — monitor kiosku")
    a = ap.parse_args()
    wh, ox, oy = a.area.split("+", 1)[0], *map(int, a.area.split("+")[1:3])
    sw, sh = map(int, wh.split("x"))
    pt = max(14, int(sh * 0.028))
    margin = int(sh * 0.025)

    root = tk.Tk()
    root.configure(cursor="none")
    root.overrideredirect(True)
    root.configure(bg=BG)
    label = tk.Label(root, borderwidth=0, highlightthickness=0, bg=BG)
    label.pack()
    tmp = os.path.join(tempfile.mkdtemp(prefix="kiosk-timer-"), "t.png")
    state = {"key": None, "img": None}

    def refresh():
        st = read_state()
        active = bool(st.get("active"))
        left = (st.get("ends_at", 0) - time.time()) if active else 0
        active = active and left > 0
        key = (active, int(left), st.get("label", ""))
        if key != state["key"]:
            state["key"] = key
            if not active:
                root.withdraw()
            else:
                try:
                    render(st.get("label", ""), left, st.get("total", 0), pt, tmp)
                    img = tk.PhotoImage(file=tmp)
                    state["img"] = img
                    label.configure(image=img)
                    w, h = img.width(), img.height()
                    x = ox + (margin if a.corner in ("tl", "bl") else sw - w - margin)
                    y = oy + (margin if a.corner in ("tl", "tr") else sh - h - margin)
                    root.geometry("%dx%d+%d+%d" % (w, h, x, y))
                    root.deiconify()
                except Exception as e:
                    print("minutnik: %s" % e, flush=True)
        if active:
            root.lift()
        root.after(1000 if active else 3000, refresh)

    refresh()
    root.mainloop()


if __name__ == "__main__":
    main()
