#!/bin/bash
# Cockpit — ogólny panel administracyjny Debiana/Ubuntu (CPU/RAM/dysk/sieć, usługi,
# konta, terminal w przeglądarce), osobny od panelu kiosku. Instalowany na żądanie.
#   sudo kiosk-cockpit install   - zainstaluj Cockpit (apt), port 9090
#   sudo kiosk-cockpit remove    - odinstaluj
#   sudo kiosk-cockpit status
# Włączanie/wyłączanie i link: panel WWW → System → Cockpit.
set -u
LOG=/var/log/kiosk-cockpit-install.log

need_root() { [ "$EUID" -eq 0 ] || { echo "Uruchom jako root: sudo kiosk-cockpit ${1:-status}" >&2; exit 1; }; }
installed() { dpkg -s cockpit-ws >/dev/null 2>&1 || dpkg -s cockpit >/dev/null 2>&1; }

case "${1:-status}" in
    install)
        need_root install
        exec > >(tee -a "$LOG") 2>&1
        echo "===== $(date '+%F %T') instalacja Cockpit ====="
        if [ -x /usr/local/sbin/kiosk-ro ] && /usr/local/sbin/kiosk-ro is-active; then
            echo "BŁĄD: dysk jest tylko do odczytu — instalacja przepadłaby po restarcie."
            echo "Wyłącz tryb (panel → System → Dysk tylko do odczytu albo sudo kiosk-ro off), uruchom ponownie, zainstaluj i włącz tryb z powrotem."
            exit 1
        fi
        echo "Pobieram listę pakietów…"
        DEBIAN_FRONTEND=noninteractive apt-get update -q || true
        echo "Instaluję Cockpit…"
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cockpit || {
            echo "BŁĄD: apt nie zainstalował Cockpit"; exit 1; }
        systemctl enable --now cockpit.socket
        command -v kiosk-firewall >/dev/null && kiosk-firewall refresh >/dev/null 2>&1 || true
        echo "Gotowe: https://<adres-kiosku>:9090 — logowanie kontem systemowym (jak przez SSH)."
        ;;
    remove)
        need_root remove
        systemctl disable --now cockpit.socket 2>/dev/null || true
        DEBIAN_FRONTEND=noninteractive apt-get remove -y cockpit cockpit-ws cockpit-bridge cockpit-system 2>/dev/null || true
        echo "Cockpit usunięty."
        ;;
    status)
        if installed; then
            st=$(systemctl is-active cockpit.socket 2>/dev/null || echo nieznany)
            echo "Cockpit: zainstalowany (gniazdo: $st, port 9090)"
        else
            echo "Cockpit: nie zainstalowany (sudo kiosk-cockpit install)"
        fi ;;
    *)  sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
