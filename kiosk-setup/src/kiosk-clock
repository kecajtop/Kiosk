def _synth_bell(freq, dur, sr=44100):
    """Pojedyncze uderzenie dzwonu: zasadniczy ton + dwa wyższe częściowe, wykładniczy zanik."""
    n = int(sr * dur)
    buf = [0.0] * n
    for i in range(n):
        tt = i / sr
        env = math.exp(-tt * 2.2)
        v = (math.sin(2 * math.pi * freq * tt) * 0.65
             + math.sin(2 * math.pi * freq * 2.005 * tt) * 0.22
             + math.sin(2 * math.pi * freq * 2.996 * tt) * 0.13)
        buf[i] = v * env
    return buf


WEST_NOTES = {1: 329.63, 2: 369.99, 3: 415.30, 4: 246.94}   # E4, Fis4, Gis4, H3
WEST_PHRASES = ((3, 2, 1, 4), (1, 3, 2, 4), (1, 2, 3, 1), (3, 1, 4, 2))


def synth_westminster(path, quarter, hour=None):
    """Kurant w stylu Westminster (dzwony Big Bena) dla zegara-kukułki.
    quarter: 1 = :15 (1 fraza), 2 = :30 (2 frazy), 3 = :45 (3 frazy), 4 = :00 (4 frazy + uderzenia
    godzin). Melodia jest przybliżeniem klasycznego kurantu, nie nutą po nucie z oryginału."""
    sr = 44100
    note_dur, gap = 1.05, 0.16
    seq = []
    for ph in WEST_PHRASES[:max(1, min(4, quarter))]:
        seq.extend(ph)
    strikes = hour if (quarter == 4 and hour) else 0
    strike_gap = 0.85
    total = 0.3 + len(seq) * (note_dur + gap) + (0.6 + strikes * strike_gap + 1.4 if strikes else 0) + 1.0
    n_total = int(sr * total)
    buf = [0.0] * n_total

    def mix(start_t, samples):
        s0 = int(start_t * sr)
        for i, v in enumerate(samples):
            j = s0 + i
            if 0 <= j < n_total:
                buf[j] += v

    tpos = 0.3
    for k in seq:
        mix(tpos, _synth_bell(WEST_NOTES[k], note_dur, sr))
        tpos += note_dur + gap
    if strikes:
        tpos += 0.6
        for _ in range(strikes):
            mix(tpos, _synth_bell(130.81, 1.0, sr))   # C3 — niskie uderzenie godziny
            tpos += strike_gap

    _write_wave(path, buf, sr, gain=0.5)


