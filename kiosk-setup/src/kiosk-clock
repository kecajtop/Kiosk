# Każda scena to lista elementów o stałej liczbie: ("poly", punkty, kolor), ("oval", prostokąt, kolor),
# ("text", (x, y), kolor, tekst, (rodzina, rozmiar, gruby), kotwica), ("line", punkty, kolor, grubość).
# Tk tworzy elementy raz i co klatkę zmienia tylko ich punkty, kolor i tekst; podgląd rysuje ImageMagick.

WORDS = {
    "pl": {"cols": 21, "fill": "AĄBCDEĘFGHIJKLŁMNOÓPRSŚTUWYZŹŻ",
           "order": ["JEST", "ZA", "DWADZIEŚCIA", "PIĘĆ", "DZIESIĘĆ", "KWADRANS", "PO", "WPÓŁ", "DO",
                     "PIERWSZA", "PIERWSZEJ", "DRUGA", "DRUGIEJ", "TRZECIA", "TRZECIEJ", "CZWARTA", "CZWARTEJ",
                     "PIĄTA", "PIĄTEJ", "SZÓSTA", "SZÓSTEJ", "SIÓDMA", "SIÓDMEJ", "ÓSMA", "ÓSMEJ",
                     "DZIEWIĄTA", "DZIEWIĄTEJ", "DZIESIĄTA", "DZIESIĄTEJ", "JEDENASTA", "JEDENASTEJ",
                     "DWUNASTA", "DWUNASTEJ"]},
    "en": {"cols": 11, "fill": "ABCDEFGHIJKLMNOPRSTUVWXYZ",
           "order": ["IT", "IS", "HALF", "TEN*", "QUARTER", "TWENTY", "FIVE*", "PAST", "TO",
                     "ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX", "SEVEN", "EIGHT", "NINE", "TEN", "ELEVEN",
                     "TWELVE", "OCLOCK"]},
}
PL_NOM = ["DWUNASTA", "PIERWSZA", "DRUGA", "TRZECIA", "CZWARTA", "PIĄTA", "SZÓSTA", "SIÓDMA", "ÓSMA",
          "DZIEWIĄTA", "DZIESIĄTA", "JEDENASTA"]
PL_LOC = [w[:-1] + ("EJ" if w.endswith("A") else "") for w in PL_NOM]
PL_LOC = [{"DWUNASTA": "DWUNASTEJ", "PIERWSZA": "PIERWSZEJ", "DRUGA": "DRUGIEJ", "TRZECIA": "TRZECIEJ",
           "CZWARTA": "CZWARTEJ", "PIĄTA": "PIĄTEJ", "SZÓSTA": "SZÓSTEJ", "SIÓDMA": "SIÓDMEJ", "ÓSMA": "ÓSMEJ",
           "DZIEWIĄTA": "DZIEWIĄTEJ", "DZIESIĄTA": "DZIESIĄTEJ", "JEDENASTA": "JEDENASTEJ"}[w] for w in PL_NOM]
EN_HOURS = ["TWELVE", "ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX", "SEVEN", "EIGHT", "NINE", "TEN", "ELEVEN"]
_WGRID = {}


def word_grid(lang):
    """Siatka liter: słowa w stałej kolejności, między nimi co najmniej jedna litera, reszta losowa (stała)."""
    if lang in _WGRID:
        return _WGRID[lang]
    import random
    cfg = WORDS[lang]
    cols, rnd = cfg["cols"], random.Random(7)
    hours = set(PL_NOM + PL_LOC) if lang == "pl" else set()
    rows, pos, row, x = [], {}, [], 0
    for key in [k for k in cfg["order"] if k not in hours]:
        w = key.rstrip("*")
        need = len(w) + (1 if row else 0)
        if x + need > cols:
            rows.append(row)
            row, x = [], 0
        if row:
            row.append(None)
            x += 1
        pos[key] = (len(rows), x, len(w))
        row.extend(w)
        x += len(w)
    rows.append(row)
    if hours:
        # Nazwy godzin (zawsze świeci tylko jedna) — upakowane ciasno: najdłuższe najpierw, do pierwszego wiersza z miejscem.
        hrows = []
        for w in sorted(hours, key=lambda w: (-len(w), w)):
            for hr in hrows:
                if len(hr) + 1 + len(w) <= cols:
                    pos[w] = (len(rows) + hrows.index(hr), len(hr) + 1, len(w))
                    hr.extend([None] + list(w))
                    break
            else:
                pos[w] = (len(rows) + len(hrows), 0, len(w))
                hrows.append(list(w))
        rows += hrows
    grid = []
    for r in rows:
        r = list(r) + [None] * (cols - len(r))
        # luz w wierszu rozłożony losowo między słowami — wygląda jak prawdziwa tablica
        grid.append([c if c else rnd.choice(cfg["fill"]) for c in r])
    _WGRID[lang] = (grid, pos)
    return grid, pos


def word_keys(lang, t):
    h, m = t.tm_hour % 12, t.tm_min // 5 * 5
    if lang == "pl":
        mins = {5: ["PIĘĆ"], 10: ["DZIESIĘĆ"], 15: ["KWADRANS"], 20: ["DWADZIEŚCIA"], 25: ["DWADZIEŚCIA", "PIĘĆ"]}
        if m == 0:
            return ["JEST", PL_NOM[h]]
        if m < 30:
            return ["JEST"] + mins[m] + ["PO", PL_LOC[h]]
        if m == 30:
            return ["JEST", "WPÓŁ", "DO", PL_LOC[(h + 1) % 12]]
        return ["JEST", "ZA"] + mins[60 - m] + [PL_NOM[(h + 1) % 12]]
    mins = {5: ["FIVE*"], 10: ["TEN*"], 15: ["QUARTER"], 20: ["TWENTY"], 25: ["TWENTY", "FIVE*"], 30: ["HALF"]}
    if m == 0:
        return ["IT", "IS", EN_HOURS[h], "OCLOCK"]
    if m <= 30:
        return ["IT", "IS"] + mins[m] + ["PAST", EN_HOURS[h]]
    return ["IT", "IS"] + mins[60 - m] + ["TO", EN_HOURS[(h + 1) % 12]]


def scene_words(style, W, H, t):
    lang = "pl" if style == "words_pl" else "en"
    grid, pos = word_grid(lang)
    rows, cols = len(grid), len(grid[0])
    cell = min(W * 0.92 / cols, H * 0.86 / rows)
    x0, y0 = (W - cell * cols) / 2.0, (H - cell * rows) / 2.0
    lit = set()
    for k in word_keys(lang, t):
        r, c, n = pos[k]
        lit.update((r, c + i) for i in range(n))
    font = ("DejaVu Sans Mono", max(6, int(cell * 0.62)), True)
    items = []
    for r in range(rows):
        for c in range(cols):
            on = (r, c) in lit
            items.append(("text", (x0 + (c + 0.5) * cell, y0 + (r + 0.5) * cell), "#FFF1D6" if on else "#262A30",
                          grid[r][c], font, "center"))
    extra = t.tm_min % 5
    d = cell * 0.16
    for i, (cx, cy) in enumerate(((x0 - cell * 0.25, y0 - cell * 0.25), (x0 + cell * cols + cell * 0.25, y0 - cell * 0.25),
                                   (x0 + cell * cols + cell * 0.25, y0 + cell * rows + cell * 0.25),
                                   (x0 - cell * 0.25, y0 + cell * rows + cell * 0.25))):
        items.append(("oval", (cx - d, cy - d, cx + d, cy + d), "#FFF1D6" if i < extra else "#262A30"))
    return items


DCF_C = {"bg": "#111410", "lcd": "#B9C2A6", "lcd2": "#A7B193", "on": "#1C2119", "off": "#AAB397", "frame": "#2B3128"}
DCF_DAYS = ["PN", "WT", "ŚR", "CZ", "PT", "SB", "ND"]


def scene_dcf(style, W, H, t, now=None, weather=None):
    now = now if now is not None else time.time()
    pw, ph = W * 0.92, min(H * 0.84, W * 0.92 * 0.52)
    px, py = (W - pw) / 2.0, (H - ph) / 2.0
    items = [("poly", _rrect(px - pw * 0.02, py - pw * 0.02, px + pw * 1.02, py + ph + pw * 0.02, pw * 0.04), DCF_C["frame"]),
             ("poly", _rrect(px, py, px + pw, py + ph, pw * 0.02), DCF_C["lcd"])]
    top = py + ph * 0.06
    fs = max(8, int(ph * 0.11))
    # maszt nadajnika i fale (fale zapalają się po kolei — „odbiór sygnału”)
    mx, my, mh = px + pw * 0.05, top + ph * 0.05, ph * 0.13
    items.append(("line", [mx, my + mh, mx + mh * 0.25, my, mx + mh * 0.5, my + mh], DCF_C["on"], max(2, int(ph * 0.012))))
    phase = int(now * 2) % 4
    for i in range(3):
        rr = mh * (0.30 + 0.22 * i)
        cxw, cyw = mx + mh * 0.25, my + mh * 0.05
        pts = []
        for a in range(-50, 51, 10):
            ra = math.radians(a - 90)
            pts += [cxw + rr * math.cos(ra), cyw + rr * math.sin(ra)]
        items.append(("line", pts, DCF_C["on"] if i < phase else DCF_C["off"], max(2, int(ph * 0.01))))
    items.append(("text", (mx + mh * 1.1, top + mh * 0.5), DCF_C["on"], "DCF", ("DejaVu Sans", int(fs * 0.8), True), "w"))
    items.append(("text", (px + pw * 0.55, top + mh * 0.5), DCF_C["on"], "%s %02d.%02d.%d" % (DCF_DAYS[t.tm_wday], t.tm_mday, t.tm_mon, t.tm_year),
                  ("DejaVu Sans", fs, True), "center"))
    temp = ("%+.0f°C" % weather["temp"]) if weather and weather.get("temp") is not None else ""
    items.append(("text", (px + pw * 0.95, top + mh * 0.5), DCF_C["on"], temp, ("DejaVu Sans", fs, True), "e"))
    # cyfry
    _, uw, uh = seg7_shapes(t, 100.0, slant=0.06)
    Hd = min(pw * 0.90 / uw, ph * 0.66 / uh) * 100.0
    shapes, sw_, sh_ = seg7_shapes(t, Hd, (now % 1) < 0.5, DCF_C["on"], DCF_C["off"], True, 0.06)
    ox = px + (pw - sw_) / 2.0
    oy = py + ph * 0.28 + (ph * 0.70 - sh_) / 2.0
    for pts, col in shapes:
        items.append(("poly", [c for p_ in pts for c in (ox + p_[0], oy + p_[1])], col))
    return items


def scene_ledring(style, W, H, t, now=None):
    now = now if now is not None else time.time()
    R = min(W, H) * 0.44
    cx, cy = W / 2.0, H / 2.0
    on, dim, mark = "#FF2A1A", "#2A0C0A", "#FF2A1A"
    items = []
    sec = t.tm_sec
    for i in range(60):
        a = math.radians(i * 6 - 90)
        r = R * (0.040 if i % 5 == 0 else 0.028)
        x, y = cx + R * math.cos(a), cy + R * math.sin(a)
        lit = (i <= sec) if sec else (i == 0)
        col = on if lit else (mark if i % 5 == 0 else dim)
        if i % 5 == 0 and not lit:
            col = "#B21D12"
        items.append(("oval", (x - r, y - r, x + r, y + r), col))
    _, uw, uh = seg7_shapes(t, 100.0, seconds=False, slant=0.0)
    Hd = min(R * 1.25 / uw, R * 0.55 / uh) * 100.0
    shapes, sw_, sh_ = seg7_shapes(t, Hd, (now % 1) < 0.5, on, "#1E0907", False, 0.0)
    ox, oy = cx - sw_ / 2.0, cy - sh_ / 2.0 - R * 0.06
    for pts, col in shapes:
        items.append(("poly", [c for p_ in pts for c in (ox + p_[0], oy + p_[1])], col))
    items.append(("text", (cx, oy + sh_ + R * 0.06), "#B21D12", "%s %02d.%02d" % (DCF_DAYS[t.tm_wday], t.tm_mday, t.tm_mon),
                  ("DejaVu Sans Mono", max(8, int(R * 0.11)), True), "n"))
    return items


# --- kod czasu DCF77: telegram minutowy na pierścieniu sekund (bit 1 = impuls 0,2 s, bit 0 = 0,1 s)
DCF77_GROUPS = [  # (od, do, nazwa, kolor łuku)
    (0, 0, "M", "#7A8794"), (1, 14, "ostrzeżenia", "#4A5560"), (15, 15, "R", "#7A8794"), (16, 16, "A1", "#7A8794"),
    (17, 17, "Z1", "#7A8794"), (18, 18, "Z2", "#7A8794"), (19, 19, "A2", "#7A8794"), (20, 20, "S", "#7A8794"),
    (21, 27, "minuta", "#E0533D"), (28, 28, "P1", "#7A8794"), (29, 34, "godzina", "#F2A900"), (35, 35, "P2", "#7A8794"),
    (36, 41, "dzień", "#3FB8D6"), (42, 44, "dz. tyg.", "#7BD88F"), (45, 49, "miesiąc", "#B38BFA"),
    (50, 57, "rok", "#F07FB0"), (58, 58, "P3", "#7A8794")]


def dcf77_bits(t):
    """59 bitów telegramu DCF77 dla minuty zaczynającej się po tym telegramie (czas t = ta minuta)."""
    b = [0] * 59

    def bcd(val, start, weights):
        tens, ones = divmod(val, 10)
        bits = [(ones >> k) & 1 for k in range(4)] + [(tens >> k) & 1 for k in range(len(weights) - 4)]
        for i, v in enumerate(bits[:len(weights)]):
            b[start + i] = v
    dst = t.tm_isdst > 0
    b[17], b[18], b[20] = int(dst), int(not dst), 1
    bcd(t.tm_min, 21, [1, 2, 4, 8, 10, 20, 40])
    b[28] = sum(b[21:28]) % 2
    bcd(t.tm_hour, 29, [1, 2, 4, 8, 10, 20])
    b[35] = sum(b[29:35]) % 2
    bcd(t.tm_mday, 36, [1, 2, 4, 8, 10, 20])
    wd = t.tm_wday + 1
    b[42], b[43], b[44] = wd & 1, (wd >> 1) & 1, (wd >> 2) & 1
    bcd(t.tm_mon, 45, [1, 2, 4, 8, 10])
    bcd(t.tm_year % 100, 50, [1, 2, 4, 8, 10, 20, 40, 80])
    b[58] = sum(b[36:58]) % 2
    return b


def scene_dcf77(style, W, H, t, now=None):
    now = now if now is not None else time.time()
    lt = time.localtime(now)
    sec = lt.tm_sec
    tele = time.localtime(now - sec + 60)           # telegram w tej minucie opisuje następną minutę
    bits = dcf77_bits(tele)
    R = min(W * 0.36, H * 0.40)
    cx, cy = W / 2.0, H / 2.0
    on, dim, cur = "#F3F5F7", "#2A323A", "#FF5A30"
    items = []
    frac = now % 1
    for i in range(60):
        a = math.radians(i * 6 - 90)
        ca, sa = math.cos(a), math.sin(a)
        if i == 59:                                   # sekunda 59: brak impulsu (znacznik minuty)
            ln, wd, col = 0.0, 0.0, dim
        else:
            one = bits[i]
            ln = R * (0.17 if one else 0.09)
            wd = R * (0.030 if one else 0.014)
            col = on if i < sec else dim
            if i == sec:
                col = cur if frac < (0.2 if one else 0.1) * 2.5 else on
        r0 = R
        px, py = -sa * wd / 2, ca * wd / 2
        x0, y0, x1, y1 = cx + r0 * ca, cy + r0 * sa, cx + (r0 - ln) * ca, cy + (r0 - ln) * sa
        items.append(("poly", [x0 + px, y0 + py, x1 + px, y1 + py, x1 - px, y1 - py, x0 - px, y0 - py], col))
    # łuki grup i podpisy z odczytaną wartością
    vals = {"minuta": "%02d" % tele.tm_min, "godzina": "%02d" % tele.tm_hour, "dzień": "%02d" % tele.tm_mday,
            "dz. tyg.": DCF_DAYS[tele.tm_wday], "miesiąc": "%02d" % tele.tm_mon, "rok": "%02d" % (tele.tm_year % 100)}
    fs = max(7, int(R * 0.060))
    for a0, a1, name, col in DCF77_GROUPS:
        rr = R * 1.06
        pts = []
        for k in range(9):
            ang = math.radians((a0 - 0.4 + (a1 - a0 + 0.8) * k / 8.0) * 6 - 90)
            pts += [cx + rr * math.cos(ang), cy + rr * math.sin(ang)]
        active = a0 <= sec <= a1
        items.append(("line", pts, col if (sec > a1 or active) else "#20262C", max(2, int(R * 0.012))))
        mid = math.radians((a0 + a1) / 2.0 * 6 - 90)
        rl = R * (1.20 if a1 - a0 > 0 else 1.15)
        label = name + ((" " + vals[name]) if name in vals else "")
        items.append(("text", (cx + rl * math.cos(mid), cy + rl * math.sin(mid)), col if active else "#9AA6B2", label,
                      ("DejaVu Sans", fs if a1 - a0 > 0 else int(fs * 0.85), active), "center"))
    items.append(("text", (cx, cy - R * 0.36), "#9AA6B2", "DCF77", ("DejaVu Sans", int(R * 0.12), True), "center"))
    items.append(("text", (cx, cy), on, time.strftime("%H:%M:%S", lt), ("DejaVu Sans Mono", int(R * 0.22), True), "center"))
    items.append(("text", (cx, cy + R * 0.25), "#9AA6B2", date_text(lt), ("DejaVu Sans", int(R * 0.075), False), "center"))
    bit = bits[sec] if sec < 59 else None
    items.append(("text", (cx, cy + R * 0.42), cur, ("bit %d: %d" % (sec, bit)) if bit is not None else "znacznik minuty",
                  ("DejaVu Sans Mono", int(R * 0.07), True), "center"))
    return items



# --- minimalistyczny analogowy: jasna tarcza, cienkie wskazówki, płynny pomarańczowy sekundnik
def _hand(cx, cy, ang, length, tail, width):
    a = math.radians(ang - 90)
    ca, sa = math.cos(a), math.sin(a)
    px, py = -sa * width / 2, ca * width / 2
    x0, y0 = cx - ca * tail, cy - sa * tail
    x1, y1 = cx + ca * length, cy + sa * length
    return [x0 + px, y0 + py, x1 + px, y1 + py, x1 - px, y1 - py, x0 - px, y0 - py]


def scene_minimal(style, W, H, t, now=None):
    now = now if now is not None else time.time()
    lt = time.localtime(now)
    R = min(W, H) * 0.44
    cx, cy = W / 2.0, H / 2.0
    ink, face, orange = "#1C1C1E", "#F5F5F7", "#FF9500"
    items = [("oval", (cx - R, cy - R, cx + R, cy + R), face)]
    for i in range(60):
        big = i % 5 == 0
        items.append(("poly", _hand(cx, cy, i * 6, R * 0.95, -R * (0.86 if big else 0.91), R * (0.018 if big else 0.007)),
                      ink if big else "#8E8E93"))
    for h in range(1, 13):
        a = math.radians(h * 30 - 90)
        items.append(("text", (cx + R * 0.72 * math.cos(a), cy + R * 0.72 * math.sin(a)), ink, str(h),
                      ("DejaVu Sans", max(8, int(R * 0.14)), False), "center"))
    items.append(("text", (cx, cy + R * 0.38), orange, "%s %d" % (DCF_DAYS[lt.tm_wday], lt.tm_mday),
                  ("DejaVu Sans", max(7, int(R * 0.075)), True), "center"))
    sec = lt.tm_sec + (now % 1)
    mins = lt.tm_min + sec / 60.0
    hrs = lt.tm_hour % 12 + mins / 60.0
    items.append(("poly", _hand(cx, cy, hrs * 30, R * 0.50, R * 0.06, R * 0.045), ink))
    items.append(("poly", _hand(cx, cy, mins * 6, R * 0.80, R * 0.06, R * 0.032), ink))
    items.append(("oval", (cx - R * 0.035, cy - R * 0.035, cx + R * 0.035, cy + R * 0.035), ink))
    items.append(("poly", _hand(cx, cy, sec * 6, R * 0.88, R * 0.16, R * 0.010), orange))
    items.append(("oval", (cx - R * 0.022, cy - R * 0.022, cx + R * 0.022, cy + R * 0.022), orange))
    items.append(("oval", (cx - R * 0.009, cy - R * 0.009, cx + R * 0.009, cy + R * 0.009), face))
    return items


# --- kwadratowe woltomierze: skala 90° (ćwierć okręgu), oś wskazówki w prawym dolnym rogu,
#     zero przy podstawie (wskazówka poziomo w lewo), maksimum u góry (wskazówka pionowo)
def scene_voltsq(style, W, H, t, now=None):
    now = now if now is not None else time.time()
    lt = time.localtime(now)
    vals = volt_values(now)
    side = min(W * 0.30, H * 0.78)
    gap = side * 0.06
    x = (W - 3 * side - 2 * gap) / 2.0
    y0 = (H - side) / 2.0 - H * 0.04
    items = []
    fs = max(7, int(side * 0.07))
    ink = "#141414"
    titles = {"GODZ.": "h", "MIN.": "min", "SEK.": "s"}
    for (vmax, labels, title), val in zip(VOLT_METERS, vals):
        x0, x1, y1 = x, x + side, y0 + side
        b = side * 0.045
        items.append(("poly", _rrect(x0, y0, x1, y1, side * 0.03), "#0E0E0E"))          # ramka
        items.append(("poly", _rrect(x0 + b, y0 + b, x1 - b, y1 - b, side * 0.01), "#F6F6F2"))  # tarcza
        hw = side * 0.27                                                           # obudowa osi
        px, py = x1 - b - hw * 0.55, y1 - b - hw * 0.55
        r = side * 0.60
        lw = max(1, int(side * 0.006))
        arc = []
        for k in range(25):
            a = math.radians(180 + 90 * k / 24.0)
            arc += [px + r * math.cos(a), py + r * math.sin(a)]
        items.append(("line", arc, ink, lw))
        n = len(labels) - 1
        steps = n * 10
        for i in range(steps + 1):
            a = math.radians(180 + 90.0 * i / steps)
            major, half = i % 10 == 0, i % 5 == 0
            r1 = r * (1.10 if major else 1.065 if half else 1.04)
            items.append(("line", [px + r * math.cos(a), py + r * math.sin(a), px + r1 * math.cos(a), py + r1 * math.sin(a)],
                          ink, max(1, int(side * (0.011 if major else 0.006 if half else 0.004)))))
        for i, lab in enumerate(labels):
            a = math.radians(180 + 90.0 * i / n)
            items.append(("text", (px + r * 0.88 * math.cos(a), py + r * 0.88 * math.sin(a)), ink, lab,
                          ("DejaVu Sans", fs, False), "center"))
        items.append(("text", (x0 + b * 2.2, y0 + b * 2.6), ink, titles.get(title, title),
                      ("DejaVu Sans", int(side * 0.12), False), "nw"))
        items.append(("text", (x0 + b * 2.2, y1 - b * 1.6), "#555555", "~  kl. 1,5  " + title,
                      ("DejaVu Sans", max(6, int(side * 0.04)), False), "sw"))
        a = 180 + 90.0 * min(val, vmax) / vmax
        items.append(("poly", _hand(px, py, a + 90, r * 1.08, 0, max(1.5, side * 0.008)), ink))   # wskazówka
        items.append(("poly", _rrect(px - hw * 0.45, py - hw * 0.45, x1 - b, y1 - b, side * 0.015), "#D9DAD6"))
        items.append(("poly", _rrect(px - hw * 0.45, py - hw * 0.45, x1 - b, py - hw * 0.38, 1), "#C4C5C0"))
        sr = hw * 0.16
        items.append(("oval", (px + hw * 0.1 - sr, py + hw * 0.1 - sr, px + hw * 0.1 + sr, py + hw * 0.1 + sr), "#2A2A2A"))
        x += side + gap
    items.append(("text", (W / 2.0, y0 + side + H * 0.05), MUTED, date_text(lt) + "  " + time.strftime("%H:%M:%S", lt),
                  ("DejaVu Sans", max(8, int(H * 0.05)), False), "n"))
    return items


SCENES = {"words_pl": scene_words, "words_en": scene_words, "dcf": scene_dcf, "ledring": scene_ledring, "dcf77": scene_dcf77,
          "minimal": scene_minimal, "voltsq": scene_voltsq}


def scene_items(style, W, H, t, now=None, weather=None):
    if style == "dcf":
        return scene_dcf(style, W, H, t, now, weather)
    if style == "ledring":
        return scene_ledring(style, W, H, t, now)
    if style == "dcf77":
        return scene_dcf77(style, W, H, t, now)
    if style == "minimal":
        return scene_minimal(style, W, H, t, now)
    if style == "voltsq":
        return scene_voltsq(style, W, H, t, now)
    return scene_words(style, W, H, t)


def preview_scene(style, t, out, width=360):
    aw, ah = ASPECT[style]
    W, H = width, int(width * ah / aw)
    mvg = ["stroke none"]
    for it in scene_items(style, W, H, t, None, read_weather()):
        kind, col = it[0], it[2]
        if kind == "poly":
            pts = it[1]
            mvg += ["stroke none", "fill '%s'" % col, "polygon " + " ".join("%.1f,%.1f" % (pts[j], pts[j + 1]) for j in range(0, len(pts), 2))]
        elif kind == "oval":
            x0, y0, x1, y1 = it[1]
            mvg += ["stroke none", "fill '%s'" % col, "ellipse %.1f,%.1f %.1f,%.1f 0,360" % ((x0 + x1) / 2, (y0 + y1) / 2, (x1 - x0) / 2, (y1 - y0) / 2)]
        elif kind == "line":
            pts = it[1]
            mvg += ["fill none", "stroke '%s'" % col, "stroke-width %d" % it[3],
                    "polyline " + " ".join("%.1f,%.1f" % (pts[j], pts[j + 1]) for j in range(0, len(pts), 2)), "stroke none"]
        else:
            (x, y), txt, (fam, size, bold), anchor = it[1], it[3], it[4], it[5]
            if not txt:
                continue
            fnt = MONO_BOLD if "Mono" in fam else (FONT_BOLD if bold else FONT)
            ta = {"w": "start", "e": "end", "nw": "start", "sw": "start"}.get(anchor, "middle")
            yb = y + size * 0.36 if anchor in ("center", "w", "e") else (y if anchor == "sw" else y + size * 0.9)
            mvg += ["fill '%s'" % col, "font '%s'" % fnt, "font-size %d" % size, "text-anchor %s" % ta,
                    "text %.1f,%.1f '%s'" % (x, yb, txt.replace("'", ""))]
    bg = {"dcf": DCF_C["bg"]}.get(style, "#000000")
    _png(["convert", "-size", "%dx%d" % (W, H), "xc:" + bg, "-draw", "\n".join(mvg), "PNG24:" + out])


def preview_anim(style, t, out, width=360):
    """Statyczny kadr do podglądu w panelu (ImageMagick)."""
    if style in SCENES:
        preview_scene(style, t, out, width)
        return
    if style in ("robot", "robot_only"):
        preview_robot(style, t, out, width)
        return
    if style in ("eyes", "eyes_only"):
        preview_eyes(style, t, out, width)
        return
    if style in ("seg7", "volt", "analog"):
        render(out, t, 64, 18, None, None, style)
        return
    if style in ("lcd1602", "lcd2004"):
        draw_lcd(style, t, width, out)
        return
    aw, ah = ASPECT[style]
    if style in ("snake", "platform"):
        sc = max(1, width // aw)
        if style == "snake":
            g = Snake()
            g.length = 12
            g.pos = 20
            g.apple = 30
            rects = g.background() + g.rects(t)
            bg = SNK["bg"]
        else:
            g = Platform()
            g.shown = list(g.digits(t))
            g.hx, g.hy = g.bx[3] + 3, -9
            rects = g.background() + g.blocks() + g.hero()
            bg = PLT["sky"]
        mvg = ["stroke none"]
        for x, y, w, h, c in rects:
            gap = 1 if style == "snake" and sc >= 4 else 0
            mvg += ["fill '%s'" % c, "rectangle %d,%d %d,%d" % (x * sc, y * sc, (x + w) * sc - 1 - gap, (y + h) * sc - 1 - gap)]
        _png(["convert", "-size", "%dx%d" % (aw * sc, ah * sc), "xc:" + bg, "-draw", "\n".join(mvg), "PNG24:" + out])
        return
    W, H = width, int(width * ah / aw)
    if style == "c64":
        b = int(W * 0.06)
        fs = max(8, int((W - 2 * b) / 40 * 1.75))
        mvg = ["fill '%s'" % C64["screen"], "rectangle %d,%d %d,%d" % (b, b, W - b, H - b),
               "fill '%s'" % C64["ink"], "font '%s'" % MONO_BOLD, "font-size %d" % fs]
        for i, ln in enumerate(c64_lines(t, True)):
            if ln:
                mvg.append("text %d,%d '%s'" % (b + 4, b + (i + 1) * fs * 1.12, ln.replace("'", "")))
        _png(["convert", "-size", "%dx%d" % (W, H), "xc:" + C64["border"], "-draw", "\n".join(mvg), "PNG24:" + out])
        return
    mvg = ["fill '%s'" % BSOD["ink"]]
    y = H * 0.04
    for txt, size, _ in bsod_texts(t):
        fs = max(8, int(H * size))
        mvg += ["font '%s'" % (FONT_BOLD if size > 0.12 else FONT), "font-size %d" % fs,
                "text %d,%d '%s'" % (W * 0.08, y + fs, txt.replace("'", ""))]
        y += fs * 1.25
    _png(["convert", "-size", "%dx%d" % (W, H), "xc:" + BSOD["bg"], "-draw", "\n".join(mvg), "PNG24:" + out])


