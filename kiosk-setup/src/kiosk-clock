def read_weather():
    try:
        with open(WEATHER_CACHE) as f:
            w = json.load(f)
        return w if isinstance(w, dict) and w.get("text") else None
    except Exception:
        return None


def read_style():
    try:
        with open(STYLE_FILE) as f:
            st = json.load(f).get("style")
        return st if st in STYLES else "classic"
    except Exception:
        return "classic"


