SEG_ON, SEG_OFF = "#FF5A30", "#170E0D"


def seg7_shapes(t, H, colon_on=True, on=None, off=None, seconds=True, slant=0.10):
    """Kształty wyświetlacza 7-segmentowego: [(punkty, kolor)], szerokość, wysokość.
    HH:MM wysokości H, sekundy o połowę mniejsze, pochylenie jak w prawdziwych wyświetlaczach."""
    shapes = []
    pad = H * 0.08

    def digit(ch, x, y, h):
        w, T = h * 0.56, max(2.0, h * 0.12)
        h2, ym, y1 = T / 2.0, y + h / 2.0, y + h

        def hs(x0, x1, yc):
            return [(x0 + h2, yc), (x0 + T, yc - h2), (x1 - T, yc - h2), (x1 - h2, yc), (x1 - T, yc + h2), (x0 + T, yc + h2)]

        def vs(xc, ya, yb):
            return [(xc, ya + h2), (xc + h2, ya + T), (xc + h2, yb - T), (xc, yb - h2), (xc - h2, yb - T), (xc - h2, ya + T)]
        segs = {"a": hs(x, x + w, y + h2), "g": hs(x, x + w, ym), "d": hs(x, x + w, y1 - h2),
                "f": vs(x + h2, y, ym), "b": vs(x + w - h2, y, ym), "e": vs(x + h2, ym, y1), "c": vs(x + w - h2, ym, y1)}
        for k in "abcdefg":
            shapes.append((segs[k], (on or SEG_ON) if k in SEG[ch] else (off or SEG_OFF)))
        return w

    x, y, gap = pad, pad, H * 0.16
    for ch in time.strftime("%H", t):
        x += digit(ch, x, y, H) + gap
    r = max(2.0, H * 0.12) * 0.55
    cx = x + H * 0.04
    for yy in (y + H * 0.32, y + H * 0.68):
        shapes.append(([(cx - r, yy - r), (cx + r, yy - r), (cx + r, yy + r), (cx - r, yy + r)],
                       (on or SEG_ON) if colon_on else (off or SEG_OFF)))
    x = cx + r + gap
    for ch in time.strftime("%M", t):
        x += digit(ch, x, y, H) + gap
    if seconds:
        hs_ = H * 0.5
        x += H * 0.06
        for ch in time.strftime("%S", t):
            x += digit(ch, x, y + H - hs_, hs_) + gap * 0.5
    k = slant
    shapes = [([(px + (y + H - py) * k, py) for px, py in pts], c) for pts, c in shapes]
    return shapes, x + pad + H * k, H + 2 * pad


def draw_seg7(t, H, out):
    shapes, W, Ht = seg7_shapes(t, H)
    mvg = ["stroke none"]
    for pts, c in shapes:
        mvg += ["fill '%s'" % c, "polygon " + " ".join("%.1f,%.1f" % p for p in pts)]
    _png(["convert", "-size", "%dx%d" % (int(W), int(Ht)), "xc:" + BG, "-draw", "\n".join(mvg), "PNG24:" + out])


def draw_matrix(t, H, out):
    on, off = "#FFB000", "#1A170F"
    text = time.strftime("%H:%M", t)
    cols = []
    for i, ch in enumerate(text):
        rows = DOTS[ch]
        for c in range(len(rows[0])):
            cols.append([r[c] == "1" for r in rows])
        if i < len(text) - 1:
            cols.append([False] * 7)
    cols = [[False] * 7] + cols + [[False] * 7]
    p = H / 7.0
    r = p * 0.36
    W, Ht = int(len(cols) * p), int(7 * p)
    mvg = ["stroke none"]
    for ci, col in enumerate(cols):
        for ri, lit in enumerate(col):
            cx, cy = ci * p + p / 2, ri * p + p / 2
            mvg += ["fill '%s'" % (on if lit else off), "circle %.1f,%.1f %.1f,%.1f" % (cx, cy, cx + r, cy)]
    pad = int(p * 0.6)
    _png(["convert", "-size", "%dx%d" % (W, Ht), "xc:" + BG, "-draw", "\n".join(mvg),
          "-bordercolor", BG, "-border", "%dx%d" % (pad, pad), "PNG24:" + out])


def draw_nixie(t, H, out):
    """Lampy Nixie: szklane tuby ze świecącymi pomarańczowymi cyframi (retro elektronika).
    Poświata jest rozmywana (-blur) w osobnej warstwie zamiast rysowana jako ułożone w stos
    teksty o różnych rozmiarach — dzięki temu wygląda jak prawdziwa, miękka poświata katody,
    bez "schodków"; dodatkowo szklany połysk (ukośny jasny pas) i winieta u góry wnęki."""
    digs = time.strftime("%H%M", t)
    tw = H * 0.50          # szerokość tuby
    th = H * 1.42          # wysokość tuby (szkło)
    gap = H * 0.13
    colon_w = H * 0.22
    base_h = H * 0.12
    pad = H * 0.16
    W = int(pad * 2 + tw * 4 + gap * 4 + colon_w)
    Ht = int(pad * 2 + th + base_h)

    base_mvg = ["stroke none"]
    glow_mvg = []     # poświata — rozmywana osobno (-blur)
    bright_mvg = []   # ostre jądro cyfry na wierzchu
    mesh_mvg = []     # siateczka anody nad poświatą (jak na prawdziwych lampach)

    def tube(x0, digit):
        x1 = x0 + tw
        y0, y1 = pad, pad + th
        r = tw * 0.24
        cx, cy = (x0 + x1) / 2.0, (y0 + y1) / 2.0 + th * 0.02

        base_mvg.extend(["fill '#111417'", "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f"
                          % (x0 - tw * 0.04, y1 - H * 0.02, x1 + tw * 0.04, y1 + base_h, r * 0.4, r * 0.4)])
        base_mvg.extend(["fill '#2b3138'", "rectangle %.1f,%.1f %.1f,%.1f"
                          % (x0 - tw * 0.03, y1 - H * 0.015, x1 + tw * 0.03, y1 - H * 0.005)])
        for i in range(3):
            px = x0 + tw * (0.2 + i * 0.3)
            base_mvg.extend(["fill '#3d4349'", "rectangle %.1f,%.1f %.1f,%.1f" % (px, y1 + base_h * 0.3, px + tw * 0.06, y1 + base_h)])
            base_mvg.extend(["fill '#56606a'", "rectangle %.1f,%.1f %.1f,%.1f" % (px, y1 + base_h * 0.3, px + tw * 0.015, y1 + base_h)])

        base_mvg.extend(["fill '#13171b'", "stroke '#4a545e'", "stroke-width %.1f" % max(1.3, tw * 0.02),
                          "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f" % (x0, y0, x1, y1, r, r), "stroke none"])
        ix0, iy0, ix1, iy1 = x0 + tw * 0.08, y0 + th * 0.05, x1 - tw * 0.08, y1 - th * 0.05
        base_mvg.extend(["fill '#190d06'", "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f" % (ix0, iy0, ix1, iy1, r * 0.7, r * 0.7)])
        for yy, op in ((iy0, 0.55), (iy0 + th * 0.05, 0.3), (iy0 + th * 0.1, 0.12)):
            base_mvg.extend(["fill-opacity %.2f" % op, "fill '#000000'", "rectangle %.1f,%.1f %.1f,%.1f" % (ix0, iy0, ix1, yy + 6)])
        base_mvg.append("fill-opacity 1")

        base_mvg.extend(["stroke '#55382a'", "stroke-width %.1f" % max(0.9, tw * 0.01)])
        for i in range(6):
            ly = iy0 + (iy1 - iy0) * (0.1 + i * 0.04)
            base_mvg.append("line %.1f,%.1f %.1f,%.1f" % (ix0 + tw * 0.04, ly, ix1 - tw * 0.04, ly))
        base_mvg.append("stroke none")

        glow_mvg.extend(["font '%s'" % FONT_BOLD, "font-size %.1f" % (th * 0.50), "fill '#FF8A3D'", "gravity center",
                     "text %.1f,%.1f '%s'" % (cx - W / 2.0, cy - Ht / 2.0, digit)])
        bright_mvg.extend(["font '%s'" % FONT_BOLD, "font-size %.1f" % (th * 0.44), "fill '#FFE9CF'", "gravity center",
                       "text %.1f,%.1f '%s'" % (cx - W / 2.0, cy - Ht / 2.0, digit)])

        # siatka siateczkowa anody (jak na prawdziwych lampach Nixie) — cienkie sześciokątne oczka
        # rysowane NAD poświatą, ale pod ostrym rdzeniem, żeby przecinały blask jak prawdziwa siatka
        hexr = tw * 0.065
        hx_step = hexr * 1.73
        hy_step = hexr * 1.5
        mesh = []
        row = 0
        yy = iy0 + hexr
        while yy < iy1 - hexr * 0.3:
            xoff = (hx_step / 2.0) if (row % 2) else 0.0
            xx = ix0 + hexr + xoff
            while xx < ix1 - hexr * 0.3:
                pts = []
                for k in range(6):
                    ang = math.radians(60 * k + 30)
                    pts.append((xx + hexr * math.cos(ang), yy + hexr * math.sin(ang)))
                mesh.append("polyline " + " ".join("%.1f,%.1f" % p for p in pts) + " %.1f,%.1f" % pts[0])
                xx += hx_step
            yy += hy_step
            row += 1
        mesh_mvg.extend(["stroke '#8a8f95'", "stroke-width %.1f" % max(0.6, tw * 0.008), "fill none"])
        mesh_mvg.extend(mesh)
        mesh_mvg.append("stroke none")

        hx0, hw = x0 + tw * 0.16, tw * 0.14
        base_mvg.extend(["fill-opacity 0.10", "fill '#ffffff'", "polygon %.1f,%.1f %.1f,%.1f %.1f,%.1f %.1f,%.1f"
                          % (hx0, y0 + th * 0.08, hx0 + hw, y0 + th * 0.05, hx0 + hw * 0.6, y1 - th * 0.1, hx0 - hw * 0.3, y1 - th * 0.14)])
        base_mvg.append("fill-opacity 1")
        return x1

    x = pad
    for i, d in enumerate(digs):
        x = tube(x, d) + gap
        if i == 1:
            cx = x + colon_w / 2.0
            y0, y1 = pad, pad + th
            base_mvg.extend(["fill '#13171b'", "stroke '#4a545e'", "stroke-width %.1f" % max(1.3, tw * 0.02),
                              "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f"
                              % (x, y0, x + colon_w, y1, colon_w * 0.4, colon_w * 0.4), "stroke none"])
            for frac in (0.38, 0.62):
                dy = y0 + th * frac
                glow_mvg.extend(["fill '#FF8A3D'", "circle %.1f,%.1f %.1f,%.1f" % (cx, dy, cx + colon_w * 0.30, dy)])
                bright_mvg.extend(["fill '#FFE9CF'", "circle %.1f,%.1f %.1f,%.1f" % (cx, dy, cx + colon_w * 0.15, dy)])
            x += colon_w + gap

    _png(["convert", "-size", "%dx%d" % (W, Ht), "xc:" + BG,
          "-draw", "\n".join(base_mvg),
          "(", "-size", "%dx%d" % (W, Ht), "xc:none", "-draw", "\n".join(glow_mvg), "-blur", "0x14", ")",
          "-compose", "plus", "-composite",
          "(", "-size", "%dx%d" % (W, Ht), "xc:none", "-draw", "\n".join(glow_mvg), "-blur", "0x5", ")",
          "-compose", "over", "-composite",
          "(", "-size", "%dx%d" % (W, Ht), "xc:none", "-draw", "\n".join(mesh_mvg), ")",
          "-compose", "over", "-composite",
          "-draw", "\n".join(bright_mvg),
          "PNG24:" + out])


def draw_kukulka(t, H, out):
    """Zegar z kukułką: drewniana szafka, tarcza ze wskazówkami, wahadło, ciężarki-szyszki."""
    W = int(H * 1.15)
    Ht = int(H * 1.55)
    wood, wood_d, wood_l = "#6B4226", "#4A2C18", "#8A5A35"
    face_bg, face_ring = "#F4E9D8", "#C9A876"
    mvg = ["stroke none"]

    roof_h = H * 0.24
    body_top = roof_h
    body_w = W * 0.80
    bx0 = (W - body_w) / 2.0
    mvg += ["fill '%s'" % wood_d,
            "polygon %.1f,%.1f %.1f,%.1f %.1f,%.1f" % (W / 2.0, 0, bx0 - W * 0.05, body_top, bx0 + body_w + W * 0.05, body_top)]
    mvg += ["fill '%s'" % wood,
            "polygon %.1f,%.1f %.1f,%.1f %.1f,%.1f" % (W / 2.0, H * 0.025, bx0, body_top, bx0 + body_w, body_top)]
    mvg += ["fill '%s'" % wood_l, "circle %.1f,%.1f %.1f,%.1f" % (W / 2.0, H * 0.07, W / 2.0 + H * 0.035, H * 0.07)]

    body_bot = body_top + H * 0.95
    mvg += ["fill '%s'" % wood, "rectangle %.1f,%.1f %.1f,%.1f" % (bx0, body_top, bx0 + body_w, body_bot)]
    mvg += ["fill none", "stroke '%s'" % wood_d, "stroke-width %.1f" % max(2, W * 0.012),
            "rectangle %.1f,%.1f %.1f,%.1f" % (bx0 + W * 0.02, body_top + W * 0.02, bx0 + body_w - W * 0.02, body_bot - W * 0.02),
            "stroke none"]

    door_w, door_h = W * 0.19, H * 0.075
    door_x, door_y = W / 2.0 - door_w / 2.0, body_top + H * 0.02
    dm = max(0.8, min(door_w, door_h) * 0.14)
    mvg += ["fill '%s'" % wood_d,
            "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f" % (door_x, door_y, door_x + door_w, door_y + door_h, 4, 4)]
    mvg += ["fill '#2b1a0f'", "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f"
            % (door_x + dm, door_y + dm, door_x + door_w - dm, door_y + door_h - dm, 3, 3)]

    fcy = body_top + H * 0.30
    fr = body_w * 0.26
    mvg += ["fill '%s'" % face_ring, "circle %.1f,%.1f %.1f,%.1f" % (W / 2.0, fcy, W / 2.0 + fr + H * 0.02, fcy)]
    mvg += ["fill '%s'" % face_bg, "circle %.1f,%.1f %.1f,%.1f" % (W / 2.0, fcy, W / 2.0 + fr, fcy)]
    for i in range(12):
        x0, y0 = _pt(W / 2.0, fcy, fr * 0.84, i * 30)
        x1, y1 = _pt(W / 2.0, fcy, fr * 0.95, i * 30)
        mvg += ["stroke '%s'" % wood_d, "stroke-width %.1f" % max(1.5, fr * 0.04),
                "line %.1f,%.1f %.1f,%.1f" % (x0, y0, x1, y1), "stroke none"]
    h, m, sec = t.tm_hour % 12, t.tm_min, t.tm_sec
    for deg, length, width in (((h + m / 60.0) * 30, 0.48, fr * 0.1), ((m + sec / 60.0) * 6, 0.74, fr * 0.06)):
        x1, y1 = _pt(W / 2.0, fcy, fr * length, deg)
        x0, y0 = _pt(W / 2.0, fcy, fr * 0.1, deg + 180)
        mvg += ["stroke '%s'" % wood_d, "stroke-width %.1f" % width,
                "line %.1f,%.1f %.1f,%.1f" % (x0, y0, x1, y1), "stroke none"]
    mvg += ["fill '#B1282B'", "circle %.1f,%.1f %.1f,%.1f" % (W / 2.0, fcy, W / 2.0 + fr * 0.07, fcy)]

    win_y0 = fcy + fr + H * 0.03
    win_y1 = body_bot - H * 0.03
    win_x0, win_x1 = W / 2.0 - body_w * 0.17, W / 2.0 + body_w * 0.17
    mvg += ["fill '#13181c'", "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f" % (win_x0, win_y0, win_x1, win_y1, 6, 6)]
    pend_cx, pend_top = W / 2.0, win_y0 + H * 0.015
    pend_len = (win_y1 - win_y0) * 0.72
    swing = 13 * math.sin(t.tm_sec * math.pi / 30.0)
    bxp, byp = _pt(pend_cx, pend_top, pend_len, swing)
    mvg += ["stroke '#C9A876'", "stroke-width %.1f" % max(2, W * 0.01),
            "line %.1f,%.1f %.1f,%.1f" % (pend_cx, pend_top, bxp, byp), "stroke none"]
    mvg += ["fill '#D4AF37'", "circle %.1f,%.1f %.1f,%.1f" % (bxp, byp, bxp + W * 0.045, byp)]

    for side in (-1, 1):
        cx0 = W / 2.0 + side * body_w * 0.30
        cy0 = body_top + H * 0.09
        cy1 = body_bot - H * 0.07
        mvg += ["stroke '#8a7a5a'", "stroke-width %.1f" % max(1.5, W * 0.006),
                "line %.1f,%.1f %.1f,%.1f" % (cx0, cy0, cx0, cy1), "stroke none"]
        pr = W * 0.045
        mvg += ["fill '#7A5230'", "polygon %.1f,%.1f %.1f,%.1f %.1f,%.1f %.1f,%.1f"
                % (cx0 - pr, cy1 - pr * 1.6, cx0 + pr, cy1 - pr * 1.6, cx0 + pr * 0.6, cy1 + pr * 1.1, cx0 - pr * 0.6, cy1 + pr * 1.1)]

    mvg += ["fill '%s'" % wood_d,
            "rectangle %.1f,%.1f %.1f,%.1f" % (bx0 - W * 0.03, body_bot, bx0 + body_w + W * 0.03, body_bot + H * 0.10)]

    _png(["convert", "-size", "%dx%d" % (W, Ht), "xc:" + BG, "-draw", "\n".join(mvg), "PNG24:" + out])


RED_GLOW = ["#330000", "#C8102E", "#FF3B30", "#FF9B8F"]


def draw_bomba(t, H, out):
    """Żartobliwy zegar-bomba: czerwone cyfry jak w filmach + kreskówkowe laski dynamitu."""
    hhmm = time.strftime("%H:%M", t)
    pt = H * 0.95
    pad = H * 0.18
    digit_w = pt * 0.62
    colon_w = pt * 0.28
    n_digits = sum(1 for c in hhmm if c != ":")
    W = int(pad * 2 + digit_w * n_digits + colon_w)
    Ht_digits = int(pt * 1.25)

    bomb_h = H * 1.55
    stick_w = W * 0.15
    stick_h = bomb_h * 0.62
    gap = W * 0.04
    n_sticks = 3
    sticks_w = stick_w * n_sticks + gap * (n_sticks - 1)
    W = max(W, int(sticks_w + pad * 2))
    Ht = int(Ht_digits + pad * 1.3 + bomb_h)

    mvg = ["stroke none"]
    panel_y0, panel_y1 = pad * 0.3, pad * 0.3 + Ht_digits
    mvg += ["fill '#15181b'", "stroke '#3a1414'", "stroke-width %.1f" % max(2, H * 0.01),
            "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f" % (pad * 0.5, panel_y0, W - pad * 0.5, panel_y1, H * 0.05, H * 0.05),
            "stroke none"]
    cy = (panel_y0 + panel_y1) / 2.0
    for size, col in zip((pt * 0.52, pt * 0.47, pt * 0.42, pt * 0.38), RED_GLOW):
        mvg += ["font '%s'" % FONT_BOLD, "font-size %.1f" % size, "fill '%s'" % col, "gravity center",
                "text %.1f,%.1f '%s'" % (0, -(Ht - cy) + Ht / 2.0, hhmm)]

    sy0 = panel_y1 + pad * 1.3
    sx0 = (W - sticks_w) / 2.0
    for i in range(n_sticks):
        x0 = sx0 + i * (stick_w + gap)
        x1 = x0 + stick_w
        y1 = sy0 + stick_h
        r = stick_w * 0.5
        mvg += ["fill '#B5301E'", "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f" % (x0, sy0, x1, y1, r, r)]
        for sband in (0.18, 0.5, 0.82):
            by = sy0 + stick_h * sband
            mvg += ["fill '#E8D9B0'", "rectangle %.1f,%.1f %.1f,%.1f" % (x0, by - stick_h * 0.035, x1, by + stick_h * 0.035)]
        if i == 1:
            fuse_x = (x0 + x1) / 2.0
            fx, fy = fuse_x, sy0
            pts = [(fx, fy)]
            for k in range(1, 6):
                a = k * 0.9
                pts.append((fx + math.sin(a * 2.3) * stick_w * 0.32, fy - k * stick_h * 0.022))
            mvg += ["fill none", "stroke '#8a6b3f'", "stroke-width %.1f" % max(2, stick_w * 0.1)]
            mvg.append("polyline " + " ".join("%.1f,%.1f" % p for p in pts))
            mvg += ["stroke none"]
            if (t.tm_sec % 2) == 0:
                fx2, fy2 = pts[-1]
                for size, col in zip((stick_w * 0.5, stick_w * 0.36, stick_w * 0.22), ("#FF9B00", "#FFD23B", "#FFF3C4")):
                    mvg += ["fill '%s'" % col, "circle %.1f,%.1f %.1f,%.1f" % (fx2, fy2, fx2 + size, fy2)]

    mvg += ["fill '#6b4a28'", "rectangle %.1f,%.1f %.1f,%.1f" % (sx0 - W * 0.02, sy0 + stick_h * 0.46,
                                                                   sx0 + sticks_w + W * 0.02, sy0 + stick_h * 0.46 + stick_h * 0.05)]

    _png(["convert", "-size", "%dx%d" % (W, Ht), "xc:" + BG, "-draw", "\n".join(mvg), "PNG24:" + out])


GREEN_GLOW = ["#06240A", "#1E8C2E", "#49E85A", "#C8FFCE"]


def draw_nuklearny(t, H, out):
    """Żartobliwy zegar nuklearny: panel reaktora z zielonym wyświetlaczem i znakiem radioaktywnym."""
    hhmm = time.strftime("%H:%M", t)
    pt = H * 0.95
    pad = H * 0.22
    digit_w = pt * 0.6
    n_digits = sum(1 for c in hhmm if c != ":")
    panel_w = int(pad * 2 + digit_w * n_digits + pt * 0.3)
    panel_h = int(pt * 1.3)
    trefoil_d = H * 0.85
    stripe = H * 0.09
    W = int(panel_w + stripe * 2)
    Ht = int(stripe * 2 + panel_h + H * 0.1 + trefoil_d)

    mvg = ["stroke none"]
    n_s = 14
    sw = (W + Ht) / n_s
    mvg += ["fill '#F2C100'", "rectangle 0,0 %.1f,%.1f" % (W, Ht)]
    for i in range(-2, n_s + 2):
        x0 = i * sw
        pts = [(x0, 0), (x0 + sw * 0.5, 0), (x0 + sw * 0.5 - Ht, Ht), (x0 - Ht, Ht)]
        mvg += ["fill '#17140a'", "polygon " + " ".join("%.1f,%.1f" % p for p in pts)]

    px0, py0 = stripe, stripe
    px1, py1 = W - stripe, stripe + panel_h
    mvg += ["fill '#0c1410'", "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f" % (px0, py0, px1, py1, H * 0.04, H * 0.04)]
    cy = (py0 + py1) / 2.0
    for size, col in zip((pt * 0.5, pt * 0.45, pt * 0.4, pt * 0.36), GREEN_GLOW):
        mvg += ["font '%s'" % FONT_BOLD, "font-size %.1f" % size, "fill '%s'" % col, "gravity center",
                "text %.1f,%.1f '%s'" % (0, -(Ht - cy) + Ht / 2.0, hhmm)]

    tcx, tcy = W / 2.0, py1 + H * 0.1 + trefoil_d / 2.0
    tr = trefoil_d / 2.0
    mvg += ["fill '#F2C100'", "circle %.1f,%.1f %.1f,%.1f" % (tcx, tcy, tcx + tr, tcy)]
    for k in range(3):
        a0 = -90 - 30 + k * 120
        a1 = a0 + 60
        x0 = tcx + tr * 0.92 * math.cos(math.radians(a0))
        y0 = tcy + tr * 0.92 * math.sin(math.radians(a0))
        x1 = tcx + tr * 0.92 * math.cos(math.radians(a1))
        y1 = tcy + tr * 0.92 * math.sin(math.radians(a1))
        path = "M %.1f,%.1f L %.1f,%.1f A %.1f,%.1f 0 0,1 %.1f,%.1f Z" % (tcx, tcy, x0, y0, tr * 0.92, tr * 0.92, x1, y1)
        mvg += ["fill '#15120a'", "path '%s'" % path]
    mvg += ["fill '#F2C100'", "circle %.1f,%.1f %.1f,%.1f" % (tcx, tcy, tcx + tr * 0.14, tcy)]
    mvg += ["fill '#15120a'", "circle %.1f,%.1f %.1f,%.1f" % (tcx, tcy, tcx + tr * 0.09, tcy)]

    _png(["convert", "-size", "%dx%d" % (W, Ht), "xc:" + BG, "-draw", "\n".join(mvg), "PNG24:" + out])


FLIPDOT_FONT = {
    "0": ["01110", "10001", "10011", "10101", "11001", "10001", "01110"],
    "1": ["00100", "01100", "00100", "00100", "00100", "00100", "01110"],
    "2": ["01110", "10001", "00001", "00010", "00100", "01000", "11111"],
    "3": ["11111", "00010", "00100", "00010", "00001", "10001", "01110"],
    "4": ["00010", "00110", "01010", "10010", "11111", "00010", "00010"],
    "5": ["11111", "10000", "11110", "00001", "00001", "10001", "01110"],
    "6": ["00110", "01000", "10000", "11110", "10001", "10001", "01110"],
    "7": ["11111", "00001", "00010", "00100", "01000", "01000", "01000"],
    "8": ["01110", "10001", "10001", "01110", "10001", "10001", "01110"],
    "9": ["01110", "10001", "10001", "01111", "00001", "00010", "01100"],
    ":": ["0", "1", "0", "0", "1", "0", "0"],
}
FLIPDOT_ON = "#F2C100"
FLIPDOT_OFF = "#2a2a28"


def draw_flipdot(t, H, out, prog=1.0, prev_hhmm=None):
    """Żółty zegar flip-dot (tablica dworcowa z obracającymi się krążkami, czarno/żółtymi).
    Gdy prog<1 i podano prev_hhmm, krążki które właśnie zmieniają stan są rysowane w trakcie
    "obrotu" (ściśnięte poziomo, jak krążek widziany z boku w połowie obrotu)."""
    hhmm = time.strftime("%H:%M", t)
    chars = list(hhmm)
    prev_chars = list(prev_hhmm) if prev_hhmm and len(prev_hhmm) == len(hhmm) else chars
    dot = H * 0.17
    dot_gap = dot * 0.30
    char_gap = dot * 0.9
    rows = 7
    widths = [len(FLIPDOT_FONT.get(c, FLIPDOT_FONT["0"])[0]) for c in chars]
    total_w = sum(w * (dot + dot_gap) - dot_gap for w in widths) + char_gap * (len(chars) - 1)
    pad = dot * 1.1
    W = int(pad * 2 + total_w)
    Ht = int(pad * 2 + rows * (dot + dot_gap) - dot_gap)

    mvg = ["stroke none", "fill '#0c0c0b'", "roundrectangle 0,0 %d,%d %.1f,%.1f" % (W, Ht, dot * 0.4, dot * 0.4)]

    x = pad
    for ci, c in enumerate(chars):
        pat = FLIPDOT_FONT.get(c, FLIPDOT_FONT["0"])
        prev_pat = FLIPDOT_FONT.get(prev_chars[ci], pat) if ci < len(prev_chars) else pat
        cols = len(pat[0])
        for ri in range(rows):
            for cj in range(cols):
                cx = x + cj * (dot + dot_gap) + dot / 2.0
                cy = pad + ri * (dot + dot_gap) + dot / 2.0
                new_on = pat[ri][cj] == "1"
                old_on = (prev_pat[ri][cj] == "1") if ri < len(prev_pat) and cj < len(prev_pat[ri]) else new_on
                if old_on != new_on and prog < 1.0:
                    squash = abs(math.cos(math.pi * prog))
                    rx = max(0.6, dot / 2.0 * squash)
                    col = FLIPDOT_ON if (old_on if prog < 0.5 else new_on) else FLIPDOT_OFF
                    mvg += ["fill '%s'" % col, "ellipse %.1f,%.1f %.1f,%.1f 0,360" % (cx, cy, rx, dot / 2.0)]
                else:
                    col = FLIPDOT_ON if new_on else FLIPDOT_OFF
                    mvg += ["fill '%s'" % col, "circle %.1f,%.1f %.1f,%.1f" % (cx, cy, cx + dot / 2.0, cy)]
        x += cols * (dot + dot_gap) - dot_gap + char_gap

    _png(["convert", "-size", "%dx%d" % (W, Ht), "xc:" + BG, "-draw", "\n".join(mvg), "PNG24:" + out])


FLUX_GLOW = "#49E8FF"
FLUX_BRIGHT = "#E8FEFF"


def draw_flux(t, H, out):
    """Zegar w stylu retro-sci-fi: panel z 'kondensatorem przepływu' — trzy świecące ramiona
    zbiegające się w centralnym rdzeniu (jak w kultowych maszynach czasu z filmów lat 80.) —
    i czerwonym cyfrowym wyświetlaczem czasu pod spodem. Oryginalna grafika, bez logo/napisów filmu."""
    hhmm = time.strftime("%H:%M", t)
    pad = H * 0.18
    y_r = H * 0.62
    hub_r = H * 0.1
    panel_w = int(pad * 2 + y_r * 2.3)
    panel_h = int(pad * 2 + y_r * 2.1 + H * 0.55)
    cx, cy = panel_w / 2.0, pad + y_r * 1.05

    base_mvg = ["stroke none"]
    glow_mvg = []
    bright_mvg = []
    txt_glow_mvg = []
    txt_bright_mvg = []

    base_mvg += ["fill '#15181d'", "roundrectangle 0,0 %.1f,%.1f %.1f,%.1f" % (panel_w, panel_h, H * 0.12, H * 0.12)]
    base_mvg += ["stroke '#3a4048'", "stroke-width %.1f" % max(1.5, H * 0.02), "fill none",
                 "roundrectangle 2,2 %.1f,%.1f %.1f,%.1f" % (panel_w - 2, panel_h - 2, H * 0.12, H * 0.12), "stroke none"]
    for rx, ry in ((pad * 0.5, pad * 0.5), (panel_w - pad * 0.5, pad * 0.5),
                   (pad * 0.5, panel_h - pad * 0.5), (panel_w - pad * 0.5, panel_h - pad * 0.5)):
        base_mvg += ["fill '#4a5058'", "circle %.1f,%.1f %.1f,%.1f" % (rx, ry, rx + H * 0.035, ry)]

    tube_w = max(3, H * 0.09)
    for ang in (-90, 30, 150):
        a = math.radians(ang)
        nx, ny = cx + y_r * math.cos(a), cy + y_r * math.sin(a)
        base_mvg += ["stroke '#2a3038'", "stroke-width %.1f" % (tube_w * 1.9), "stroke-linecap round",
                     "line %.1f,%.1f %.1f,%.1f" % (cx, cy, nx, ny)]
        glow_mvg += ["stroke '%s'" % FLUX_GLOW, "stroke-width %.1f" % (tube_w * 1.4), "stroke-linecap round",
                     "line %.1f,%.1f %.1f,%.1f" % (cx, cy, nx, ny)]
        glow_mvg += ["fill '%s'" % FLUX_GLOW, "circle %.1f,%.1f %.1f,%.1f" % (nx, ny, nx + tube_w * 0.9, ny)]
        bright_mvg += ["stroke '%s'" % FLUX_BRIGHT, "stroke-width %.1f" % (tube_w * 0.5), "stroke-linecap round",
                       "line %.1f,%.1f %.1f,%.1f" % (cx, cy, nx, ny)]
        bright_mvg += ["fill '%s'" % FLUX_BRIGHT, "circle %.1f,%.1f %.1f,%.1f" % (nx, ny, nx + tube_w * 0.45, ny)]
    base_mvg += ["fill '#2a3038'", "circle %.1f,%.1f %.1f,%.1f" % (cx, cy, cx + hub_r, cy)]
    glow_mvg += ["fill '%s'" % FLUX_GLOW, "circle %.1f,%.1f %.1f,%.1f" % (cx, cy, cx + hub_r * 0.8, cy)]
    bright_mvg += ["fill '%s'" % FLUX_BRIGHT, "circle %.1f,%.1f %.1f,%.1f" % (cx, cy, cx + hub_r * 0.45, cy)]

    disp_y0 = cy + y_r * 1.15
    disp_h = H * 0.52
    disp_w = panel_w - pad * 1.3
    disp_x0 = (panel_w - disp_w) / 2.0
    base_mvg += ["fill '#120505'", "roundrectangle %.1f,%.1f %.1f,%.1f %.1f,%.1f"
                 % (disp_x0, disp_y0, disp_x0 + disp_w, disp_y0 + disp_h, H * 0.05, H * 0.05)]
    tcx, tcy = panel_w / 2.0, disp_y0 + disp_h / 2.0
    for size, col, lst in ((disp_h * 0.62, "#FF3B30", txt_glow_mvg), (disp_h * 0.52, "#FFD9D5", txt_bright_mvg)):
        lst += ["font '%s'" % FONT_BOLD, "font-size %.1f" % size, "fill '%s'" % col,
                "gravity center", "text %.1f,%.1f '%s'" % (tcx - panel_w / 2.0, tcy - panel_h / 2.0, hhmm)]

    _png(["convert", "-size", "%dx%d" % (panel_w, panel_h), "xc:" + BG,
          "-draw", "\n".join(base_mvg),
          "(", "-size", "%dx%d" % (panel_w, panel_h), "xc:none", "-draw", "\n".join(glow_mvg), "-blur", "0x10", ")",
          "-compose", "plus", "-composite",
          "(", "-size", "%dx%d" % (panel_w, panel_h), "xc:none", "-draw", "\n".join(glow_mvg), "-blur", "0x4", ")",
          "-compose", "over", "-composite",
          "-draw", "\n".join(bright_mvg),
          "(", "-size", "%dx%d" % (panel_w, panel_h), "xc:none", "-draw", "\n".join(txt_glow_mvg), "-blur", "0x6", ")",
          "-compose", "plus", "-composite",
          "-draw", "\n".join(txt_bright_mvg),
          "PNG24:" + out])


def draw_flip(t, H, out):
    card, card2, ink = "#1E252C", "#252D35", "#F3F5F7"
    cw, ch = int(H * 1.5), int(H * 1.25)
    r = int(H * 0.09)
    gap = int(H * 0.14)
    parts = []
    for txt in (time.strftime("%H", t), time.strftime("%M", t)):
        parts += ["(", "-size", "%dx%d" % (cw, ch), "xc:none",
                  "-fill", card2, "-draw", "roundrectangle 0,0 %d,%d %d,%d" % (cw - 1, ch - 1, r, r),
                  "-fill", card, "-draw", "roundrectangle 0,0 %d,%d %d,%d" % (cw - 1, ch // 2, r, r),
                  "-font", FONT_BOLD, "-pointsize", str(int(H * 0.82)), "-fill", ink, "-gravity", "center",
                  "-annotate", "+0+%d" % int(H * 0.02), txt,
                  "-stroke", BG, "-strokewidth", str(max(2, H // 40)), "-draw", "line 0,%d %d,%d" % (ch // 2, cw, ch // 2),
                  "-stroke", "none", "-fill", BG,
                  "-draw", "rectangle 0,%d %d,%d" % (ch // 2 - H // 14, H // 30, ch // 2 + H // 14),
                  "-draw", "rectangle %d,%d %d,%d" % (cw - H // 30, ch // 2 - H // 14, cw, ch // 2 + H // 14),
                  ")"]
    spacer = ["(", "-size", "%dx%d" % (gap, ch), "xc:" + BG, ")"]
    _png(["convert", "-respect-parentheses", "-background", BG] + parts[:len(parts) // 2] + spacer +
         parts[len(parts) // 2:] + ["-background", BG, "+append", "+repage", "-flatten", "PNG24:" + out])


def _pt(cx, cy, r, deg):
    a = math.radians(deg)
    return cx + r * math.sin(a), cy - r * math.cos(a)


def draw_analog(t, H, out):
    S = int(H * 1.6)
    c = S / 2.0
    R = S * 0.46
    mvg = ["fill '#151B21'", "stroke '#26303A'", "stroke-width %.1f" % max(2, S / 120),
           "circle %.1f,%.1f %.1f,%.1f" % (c, c, c + R, c), "stroke-linecap round"]
    for i in range(60):
        big = i % 5 == 0
        x0, y0 = _pt(c, c, R * (0.80 if big else 0.88), i * 6)
        x1, y1 = _pt(c, c, R * 0.93, i * 6)
        mvg += ["stroke '%s'" % (INK if big else "#4A5561"), "stroke-width %.1f" % (S / 60 if big else S / 200),
                "line %.1f,%.1f %.1f,%.1f" % (x0, y0, x1, y1)]
    h, m, sec = t.tm_hour % 12, t.tm_min, t.tm_sec
    for deg, length, width, color in (((h + m / 60.0) * 30, 0.52, S / 28, INK), ((m + sec / 60.0) * 6, 0.78, S / 45, INK)):
        x1, y1 = _pt(c, c, R * length, deg)
        x0, y0 = _pt(c, c, R * 0.12, deg + 180)
        mvg += ["stroke '%s'" % color, "stroke-width %.1f" % width, "line %.1f,%.1f %.1f,%.1f" % (x0, y0, x1, y1)]
    # Sekundnik: cienka czerwona wskazówka z przeciwwagą.
    x1, y1 = _pt(c, c, R * 0.86, sec * 6)
    x0, y0 = _pt(c, c, R * 0.22, sec * 6 + 180)
    mvg += ["stroke '#FF4D2E'", "stroke-width %.1f" % max(1.5, S / 160), "line %.1f,%.1f %.1f,%.1f" % (x0, y0, x1, y1)]
    mvg += ["stroke none", "fill '%s'" % ACCENT, "circle %.1f,%.1f %.1f,%.1f" % (c, c, c + S / 30, c)]
    _png(["convert", "-size", "%dx%d" % (S, S), "xc:" + BG, "-draw", "\n".join(mvg), "PNG24:" + out])


VOLT_METERS = ((24, ["0", "6", "12", "18", "24"], "GODZ."), (60, ["0", "10", "20", "30", "40", "50", "60"], "MIN."),
               (60, ["0", "10", "20", "30", "40", "50", "60"], "SEK."))


def volt_values(now):
    t = time.localtime(now)
    sec = t.tm_sec + (now % 1)
    return (t.tm_hour + t.tm_min / 60.0 + sec / 3600.0, t.tm_min + sec / 60.0, sec)


def volt_geometry(W, Hm):
    """Środek obrotu i długość wskazówki (wspólne dla obrazka i animacji)."""
    return W / 2.0, Hm * 0.88, Hm * 0.60 * 1.04


def _meter(value, vmax, labels, title, W, Hm, needle=True):
    """MVG jednego woltomierza (tarcza kremowa, skala łukiem, czerwona wskazówka)."""
    face, ink, red = "#EDE6D3", "#1B1B1B", "#C8281E"
    cx, cy = W / 2.0, Hm * 0.88
    R = Hm * 0.60
    mvg = ["stroke '#3A3F45'", "stroke-width %.1f" % max(3, W / 60), "fill '#0B0F13'",
           "roundrectangle 1,1 %d,%d %d,%d" % (W - 2, Hm - 2, W // 18, W // 18),
           "stroke none", "fill '%s'" % face,
           "roundrectangle %d,%d %d,%d %d,%d" % (W // 22, W // 22, W - W // 22, Hm - W // 22, W // 30, W // 30),
           "fill none", "stroke '%s'" % ink, "stroke-width %.1f" % max(1.5, W / 220),
           "path 'M %.1f,%.1f A %.1f,%.1f 0 0 1 %.1f,%.1f'" % (_pt(cx, cy, R, -45) + (R, R) + _pt(cx, cy, R, 45))]
    steps = len(labels) - 1
    minor = 5 if vmax == 60 else 4
    for i in range(steps * minor + 1):
        deg = -45 + 90.0 * i / (steps * minor)
        big = i % minor == 0
        x0, y0 = _pt(cx, cy, R, deg)
        x1, y1 = _pt(cx, cy, R * (1.10 if big else 1.05), deg)
        mvg += ["stroke-width %.1f" % (max(2, W / 120) if big else max(1, W / 260)), "line %.1f,%.1f %.1f,%.1f" % (x0, y0, x1, y1)]
    mvg += ["stroke none", "fill '%s'" % ink, "font '%s'" % FONT, "font-size %d" % max(9, int(W / 15))]
    for i, lab in enumerate(labels):
        deg = -45 + 90.0 * i / steps
        x, y = _pt(cx, cy, R * 1.17, deg)
        mvg += ["text %.1f,%.1f '%s'" % (x - len(lab) * W / 60.0, y + W / 50.0, lab)]
    # Podpis w lewym dolnym rogu tarczy — poza drogą wskazówki.
    mvg += ["font '%s'" % FONT_BOLD, "font-size %d" % max(8, int(W / 17)),
            "text %.1f,%.1f '%s'" % (W * 0.10, Hm - W / 11.0, title)]
    if not needle:
        return mvg
    deg = -45 + 90.0 * min(value, vmax) / vmax
    x1, y1 = _pt(cx, cy, R * 1.04, deg)
    mvg += ["stroke '%s'" % red, "stroke-width %.1f" % max(2, W / 110), "stroke-linecap round",
            "line %.1f,%.1f %.1f,%.1f" % (cx, cy, x1, y1), "stroke none", "fill '#2A2A2A'",
            "circle %.1f,%.1f %.1f,%.1f" % (cx, cy, cx + W / 28.0, cy)]
    return mvg


def draw_volt(t, H, out, needles=True, now=None):
    W, Hm = int(H * 1.6), int(H * 1.07)
    gap = int(H * 0.14)
    vals = volt_values(now if now is not None else time.mktime(t))
    files = []
    for i, ((vmax, labels, title), val) in enumerate(zip(VOLT_METERS, vals)):
        f = out + ".m%d.png" % i
        _png(["convert", "-size", "%dx%d" % (W, Hm), "xc:" + BG,
              "-draw", "\n".join(_meter(val, vmax, labels, title, W, Hm, needles)), "PNG24:" + f])
        files.append(f)
    try:
        cmd = ["convert", files[0]]
        for f in files[1:]:
            cmd += ["-size", "%dx%d" % (gap, Hm), "xc:" + BG, f]
        _png(cmd + ["+append", "PNG24:" + out])
    finally:
        for f in files:
            os.unlink(f)
    return W, Hm, gap


