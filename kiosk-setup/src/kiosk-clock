# --- oczy robota: świecące zaokrąglone prostokąty z wyrazem twarzy (robot — z godziną, robot_only — same oczy)
RBT = {"bg": "#000000", "eye": "#3FE6FF", "glow": "#0A4652", "ink": "#3FE6FF", "dim": "#1E7F90"}
# Wyrazy: (obniżenie powieki przy zewnętrznym kącie, przy wewnętrznym, dolna powieka „uśmiech”, wysokość, szerokość)
RBT_MOODS = {"neutral": (0.0, 0.0, 0.0, 1.0, 1.0), "happy": (0.0, 0.0, 0.48, 0.92, 1.05),
             "sad": (0.42, 0.0, 0.0, 0.88, 1.0), "angry": (0.0, 0.48, 0.0, 0.92, 1.0),
             "sleepy": (0.52, 0.52, 0.0, 1.0, 1.04), "surprised": (0.0, 0.0, 0.0, 1.28, 0.88),
             "suspicious": (0.38, 0.38, 0.22, 1.0, 1.02)}


def _rrect(x0, y0, x1, y1, r, seg=5):
    """Wielokąt zaokrąglonego prostokąta (lista x, y)."""
    r = max(0.0, min(r, (x1 - x0) / 2.0, (y1 - y0) / 2.0))
    pts = []
    for cx, cy, a0 in ((x1 - r, y0 + r, -90), (x1 - r, y1 - r, 0), (x0 + r, y1 - r, 90), (x0 + r, y0 + r, 180)):
        for i in range(seg + 1):
            a = math.radians(a0 + 90.0 * i / seg)
            pts += [cx + r * math.cos(a), cy + r * math.sin(a)]
    return pts


def robot_geometry(style, W, H):
    # Pole oczu mieści największy wyraz (zdziwienie, oko bliżej patrzącego, ruch w pionie),
    # więc oczy nigdy nie nachodzą na godzinę.
    area_h = H * (0.64 if style == "robot" else 0.94)
    eh = (area_h - 2 * robot_dy(style, H)) / (1.28 * 1.16 * 1.12)
    ew = min(W * 0.24, eh / 1.18)
    eh = ew * 1.18
    cy = (H * 0.03 + area_h / 2.0) if style == "robot" else H / 2.0
    gap = ew * 0.55
    return (W / 2.0 - gap / 2.0 - ew / 2.0, W / 2.0 + gap / 2.0 + ew / 2.0), cy, ew, eh


def robot_dy(style, H):
    return H * (0.035 if style == "robot" else 0.07)


def robot_clock_y(H):
    return H * 0.70


def robot_parts(style, W, H, st):
    """Kształty obu oczu: [(punkty, kolor)] — zawsze tyle samo elementów (Tk tylko przesuwa punkty)."""
    cxs, cy, ew, eh = robot_geometry(style, W, H)
    out_o, out_i, smile, hs, ws = st["mood"]
    gx, gy, blink = st["gx"], st["gy"], st["blink"]
    talk = st.get("talk", 0.0)
    shapes = []
    for side, cx0 in ((-1, cxs[0]), (1, cxs[1])):
        persp = 1.0 + 0.09 * gx * side           # oko po stronie spojrzenia trochę większe
        w = ew * ws * persp * (1 + 0.04 * talk)
        h = eh * hs * persp * max(0.07, 1.0 - blink) * (1 + 0.12 * talk)   # pulsują w rytm głosu
        cx = cx0 + gx * W * 0.07
        cy1 = cy + gy * robot_dy(style, H)
        x0, x1, y0, y1 = cx - w / 2, cx + w / 2, cy1 - h / 2, cy1 + h / 2
        r = min(w, h) * 0.24
        g = max(3.0, ew * 0.07)
        shapes.append((_rrect(x0 - g, y0 - g, x1 + g, y1 + g, r + g), RBT["glow"]))
        shapes.append((_rrect(x0, y0, x1, y1, r), RBT["eye"]))
        # górna powieka: linia od kąta zewnętrznego do wewnętrznego (lewe oko: zewnętrzny = lewy)
        left, right = (out_o, out_i) if side < 0 else (out_i, out_o)
        m = g * 2 + 2
        shapes.append(([x0 - m, y0 - m - h, x1 + m, y0 - m - h, x1 + m, y0 + right * h - (m if not right else 0),
                        x0 - m, y0 + left * h - (m if not left else 0)], RBT["bg"]))
        # dolna powieka „uśmiech”: łuk wypukły do góry — oczy jak ^ ^
        pts = [x1 + m, y1 + m + h, x0 - m, y1 + m + h]
        n = 12
        for i in range(n + 1):
            u = -1 + 2.0 * i / n
            pts += [cx + u * (w / 2 + m), y1 + m - smile * h * (1 - u * u) * 1.05 - (m if smile else 0) * (1 - u * u)]
        shapes.append((pts, RBT["bg"]))
    return shapes


class RobotEyes:
    """Wyraz, spojrzenie i mruganie oczu robota."""

    def __init__(self, with_clock):
        import random
        self.r = random.Random()
        self.with_clock = with_clock
        self.mood = list(RBT_MOODS["neutral"])
        self.target = "neutral"
        self.mood_until = time.time() + 4
        self.gx = self.gy = self.tx = self.ty = 0.0
        self.next_look = 0.0
        self.blink = 0.0
        self.blink_at = time.time() + 2.5
        self.blink_t0 = None
        self.minute = time.localtime().tm_min
        self.speech = Speech()
        self.talk = 0.0

    def update(self, now):
        r = self.r
        t = time.localtime(now)
        talking, level, mood = self.speech.state(now)
        if mood:                                   # mówi albo przed chwilą skończył: wyraz z treści
            self.target, self.mood_until = mood, now + 2.0
        if talking:
            if now >= self.next_look:
                self.tx, self.ty = r.uniform(-0.15, 0.15), r.uniform(-0.12, 0.08)
                self.next_look = now + r.uniform(0.4, 1.2)
            if self.blink_t0 is None and self.blink_at - now > 3.0:
                self.blink_at = now + r.uniform(1.0, 3.0)
        self.talk += ((level if talking else 0.0) - self.talk) * 0.5
        if self.with_clock and t.tm_min != self.minute and not talking:
            self.minute = t.tm_min
            self.target, self.mood_until = "happy", now + 3.0
            self.tx, self.ty, self.next_look = 0.0, 0.8, now + 2.5
        if now >= self.mood_until:
            h = t.tm_hour
            pool = ["neutral"] * 6 + ["happy"] * 3 + ["suspicious", "surprised", "sad", "angry"]
            if h >= 22 or h < 6:
                pool += ["sleepy"] * 6
            self.target = r.choice(pool)
            self.mood_until = now + (r.uniform(5, 12) if self.target == "neutral" else r.uniform(2.5, 5))
        goal = RBT_MOODS[self.target]
        self.mood = [a + (b - a) * 0.18 for a, b in zip(self.mood, goal)]
        if now >= self.next_look:
            if r.random() < 0.35:
                self.tx, self.ty = 0.0, 0.0
            else:
                self.tx, self.ty = r.choice((-1, -0.6, 0.6, 1)), r.uniform(-0.7, 0.7)
            self.next_look = now + r.uniform(0.8, 3.0)
        self.gx += (self.tx - self.gx) * 0.25
        self.gy += (self.ty - self.gy) * 0.25
        if self.blink_t0 is None and now >= self.blink_at:
            self.blink_t0 = now
        if self.blink_t0 is not None:
            p = (now - self.blink_t0) / 0.20
            if p >= 1:
                self.blink_t0, self.blink = None, 0.0
                self.blink_at = now + (0.15 if r.random() < 0.15 else r.uniform(2.5, 6.0))
            else:
                self.blink = 1 - abs(1 - 2 * p)
        return {"mood": self.mood, "gx": self.gx, "gy": self.gy, "blink": self.blink, "talk": self.talk}


