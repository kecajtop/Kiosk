def _write_wave(path, buf, sr, gain=0.6):
    peak = max(1e-6, max(abs(x) for x in buf))
    scale = gain * 32767 / peak
    tmp = path + ".tmp"
    with wave.open(tmp, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(sr)
        frames = bytearray()
        for x in buf:
            v = int(max(-32767, min(32767, x * scale)))
            frames += struct.pack("<h", v)
        w.writeframes(bytes(frames))
    os.replace(tmp, path)


def _synth_click(path):
    """Krótkie, metaliczne kliknięcie — jak przełączenie prawdziwej lampki Nixie."""
    sr = 44100
    n = int(sr * 0.028)
    rng = random.Random(7)
    buf = [0.0] * n
    for i in range(n):
        t = i / sr
        env = math.exp(-t * 260)
        noise = (rng.random() * 2 - 1) * 0.5
        tone = math.sin(2 * math.pi * 3200 * t) * 0.5
        buf[i] = env * (noise + tone)
    _write_wave(path, buf, sr, gain=0.55)


def _synth_siren(path):
    """Syrena alarmowa (wznosząco-opadająca) — żartobliwy akcent zegara-bomby."""
    sr = 44100
    dur = 4.6
    n = int(sr * dur)
    f_lo, f_hi = 500.0, 1100.0
    period = 2.3
    buf = [0.0] * n
    phase = 0.0
    for i in range(n):
        t = i / sr
        cyc = (t % period) / period
        tri = cyc * 2 if cyc < 0.5 else 2 - cyc * 2
        f = f_lo + (f_hi - f_lo) * tri
        phase += 2 * math.pi * f / sr
        env = min(1.0, t / 0.15) * min(1.0, (dur - t) / 0.3)
        buf[i] = math.sin(phase) * env
    _write_wave(path, buf, sr, gain=0.9)


