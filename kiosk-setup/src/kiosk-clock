# --- mowa: kiosk-api zapisuje, kiedy kiosk mówi (czas, krzywa głośności, nastrój tekstu)
SPEAK_FILE = "/run/kiosk-speaking.json"


class Speech:
    def __init__(self):
        self.data, self.mtime, self.checked = {}, None, 0.0

    def state(self, now):
        """(mówi?, głośność 0..1, nastrój) — plik sprawdzany co 0,2 s."""
        if now - self.checked > 0.2:
            self.checked = now
            try:
                m = os.path.getmtime(SPEAK_FILE)
                if m != self.mtime:
                    self.mtime = m
                    with open(SPEAK_FILE) as f:
                        self.data = json.load(f)
            except (OSError, ValueError):
                self.data = {}
        d = self.data
        if not d.get("active"):
            return False, 0.0, None
        start, end = d.get("start", 0), d.get("end", 0)
        if not (start - 0.2 <= now <= end + 0.3):
            return False, 0.0, d.get("mood") if now <= end + 2.0 else None
        env = d.get("env") or []
        i = int((now - start) / (d.get("step") or 0.06))
        level = env[i] if 0 <= i < len(env) else 0.0
        return True, float(level), d.get("mood") or "neutral"


# --- oczy: para oczu, które rozglądają się i mrugają (eyes — z godziną pod spodem, eyes_only — same oczy)
EYE = {"white": "#F2EFE6", "iris": "#2FA3C4", "iris2": "#1B6F87", "pupil": "#0A0D10", "lid": "#1A2129",
       "line": "#05070A", "shine": "#FFFFFF"}


def eyes_geometry(style, W, H):
    """Środki i promienie obu oczu oraz pole na godzinę (eyes)."""
    eh = H * (0.62 if style == "eyes" else 0.92)
    rx = min(W * 0.20, eh * 0.42)
    ry = rx * 1.12
    cy = (H * 0.06 + ry) if style == "eyes" else H / 2.0
    gap = rx * 0.42
    cxs = (W / 2.0 - gap / 2.0 - rx, W / 2.0 + gap / 2.0 + rx)
    return cxs, cy, rx, ry


def eye_parts(cx, cy, rx, ry, gx, gy, lid, dil=1.0):
    """Kształty jednego oka: [(rodzaj, punkty/prostokąt, kolor)]. gx, gy w -1..1, lid 0 (otwarte)..1 (zamknięte)."""
    ri = min(rx, ry) * 0.48
    rp = ri * 0.48 * dil
    ix = cx + gx * (rx - ri) * 0.80
    iy = cy + gy * (ry - ri) * 0.80
    out = [("oval", (cx - rx, cy - ry, cx + rx, cy + ry), EYE["white"]),
           ("oval", (ix - ri, iy - ri, ix + ri, iy + ri), EYE["iris2"]),
           ("oval", (ix - ri * 0.82, iy - ri * 0.82, ix + ri * 0.82, iy + ri * 0.82), EYE["iris"]),
           ("oval", (ix - rp, iy - rp, ix + rp, iy + rp), EYE["pupil"]),
           ("oval", (ix - ri * 0.42 - rp * 0.32, iy - ri * 0.42 - rp * 0.32, ix - ri * 0.42 + rp * 0.32, iy - ri * 0.42 + rp * 0.32), EYE["shine"])]
    n = 24
    top = []
    edge = []
    for i in range(n + 1):
        u = -1 + 2.0 * i / n
        h = math.sqrt(max(0.0, 1 - u * u))
        top.append((cx + u * rx, cy - ry * h))
        edge.append((cx + u * rx, cy + (-1 + 2 * lid) * ry * h))
    poly = top + edge[::-1]
    out.append(("poly", [c for pt in poly for c in pt], EYE["lid"]))
    out.append(("line", [c for pt in edge for c in pt], EYE["line"]))
    out.append(("ring", (cx - rx, cy - ry, cx + rx, cy + ry), EYE["line"]))
    return out


class Eyes:
    """Ruch oczu: skoki spojrzenia w losowe miejsca, mruganie, zerknięcie na zegar przy zmianie minuty."""

    def __init__(self, with_clock):
        import random
        self.r = random.Random()
        self.with_clock = with_clock
        self.gx = self.gy = 0.0
        self.tx = self.ty = 0.0
        self.next_look = 0.0
        self.lid = 0.08
        self.blink_at = time.time() + 2.0
        self.blink_t0 = None
        self.double = False
        self.minute = time.localtime().tm_min
        self.dil = 1.0
        self.speech = Speech()
        self.base = 0.08

    def update(self, now):
        r = self.r
        t = time.localtime(now)
        talking, level, mood = self.speech.state(now)
        # Podczas mowy: patrzą na rozmówcę (środek), powieki wg nastroju, źrenice w rytm głosu.
        base = {"happy": 0.22, "sad": 0.36, "sleepy": 0.5, "angry": 0.3, "suspicious": 0.42,
                "surprised": 0.0}.get(mood, 0.08) if mood else 0.08
        self.base += (base - self.base) * 0.15
        if talking:
            if now >= self.next_look:
                self.tx, self.ty = r.uniform(-0.12, 0.12), r.uniform(-0.1, 0.08)
                self.next_look = now + r.uniform(0.4, 1.2)
            if self.blink_t0 is None and self.blink_at - now > 3.0:
                self.blink_at = now + r.uniform(1.0, 3.0)
        if self.with_clock and t.tm_min != self.minute:
            self.minute = t.tm_min
            self.tx, self.ty = 0.0, 0.95          # zerknij na godzinę
            self.next_look = now + 2.2
            self.blink_at = min(self.blink_at, now + 0.6)
        if now >= self.next_look:
            if r.random() < 0.25:
                self.tx, self.ty = r.uniform(-0.15, 0.15), r.uniform(-0.1, 0.15)
            else:
                self.tx, self.ty = r.uniform(-1, 1), r.uniform(-0.85, 0.85)
            self.next_look = now + r.uniform(0.7, 3.2)
        k = 0.32                                    # szybki skok, potem spoczynek
        self.gx += (self.tx - self.gx) * k
        self.gy += (self.ty - self.gy) * k
        self.dil = 1.0 + 0.10 * math.sin(now * 0.7) + (0.28 * level if talking else 0.0)
        if self.blink_t0 is None and now >= self.blink_at:
            self.blink_t0 = now
        if self.blink_t0 is not None:
            p = (now - self.blink_t0) / 0.22       # 0..1 zamykanie i otwieranie
            if p >= 1:
                self.blink_t0 = None
                self.lid = self.base
                if not self.double and r.random() < 0.18:
                    self.double = True
                    self.blink_at = now + 0.12
                else:
                    self.double = False
                    self.blink_at = now + r.uniform(2.5, 6.5)
            else:
                self.lid = self.base + (1 - self.base) * (1 - abs(1 - 2 * p))
        else:
            self.lid = self.base
        return self.gx, self.gy, self.lid, self.dil


