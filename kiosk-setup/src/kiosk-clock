def font_rects(text, x0, y0, scale, color, gap=1):
    """Prostokąty pikselowej czcionki 5×7 (cyfry i dwukropek)."""
    out, x = [], x0
    for ch in text:
        rows = DOTS.get(ch)
        if not rows:
            x += 3 * scale
            continue
        for ry, row in enumerate(rows):
            for rx, bit in enumerate(row):
                if bit == "1":
                    out.append((x + rx * scale, y0 + ry * scale, scale, scale, color))
        x += (len(rows[0]) + gap) * scale
    return out


def text_width(text, scale, gap=1):
    return sum(((len(DOTS[c][0]) + gap) if c in DOTS else 3) * scale for c in text) - gap * scale


