def lcd_cells(style, t, colon_on=True, weather=None):
    """Zawartość wyświetlacza: lista wierszy, każdy to lista pól; pole = 8 wierszy po 5 kropek ('0'/'1')."""
    cols, rows = (16, 2) if style == "lcd1602" else (20, 4)
    blank = ["00000"] * 8
    grid = [[blank for _ in range(cols)] for _ in range(rows)]

    def put_big(ch, col, table):
        for r, line in enumerate(table[ch]):
            for c, key in enumerate(line.split()):
                grid[r][col + c] = [LCD_ROWS[key][i] * 5 for i in range(8)]

    def put_colon(col, height):
        dot = "01110"
        on = colon_on
        if height == 2:
            grid[0][col] = ["00000"] * 4 + [dot if on else "00000"] * 3 + ["00000"]
            grid[1][col] = ["00000"] + [dot if on else "00000"] * 3 + ["00000"] * 4
        else:
            d = dot if on else "00000"
            grid[1][col] = ["00000", d, d, "00000", "00000", d, d, "00000"]

    def put_text(text, row, col):
        for i, ch in enumerate(text):
            if 0 <= col + i < cols:
                pat = LCD_FONT.get(ch.upper(), LCD_FONT[" "]).split()
                grid[row][col + i] = pat + ["00000"]

    hh, mm, ss = time.strftime("%H", t), time.strftime("%M", t), time.strftime("%S", t)
    if style == "lcd1602":
        put_big(hh[0], 0, BIG2)
        put_big(hh[1], 3, BIG2)
        put_colon(6, 2)
        put_big(mm[0], 7, BIG2)
        put_big(mm[1], 10, BIG2)
        put_text(LCD_DAYS[t.tm_wday][:2], 0, 14)
        put_text(ss, 1, 14)
    else:
        for i, (ch, col) in enumerate(zip(hh + mm + ss, (0, 3, 7, 10, 14, 17))):
            put_big(ch, col, BIG3)
        put_colon(6, 3)
        put_colon(13, 3)
        temp = ("%d°C" % round(weather["temp"])) if weather and weather.get("temp") is not None else ""
        line = "%s %02d.%02d.%d" % (LCD_DAYS[t.tm_wday], t.tm_mday, t.tm_mon, t.tm_year)
        line = (line + " " * 20)[:20 - len(temp)] + temp if temp else line
        put_text(line[:20], 3, 0)
    return grid


def lcd_geometry(style, W, H):
    """Rozmiar kropki i położenie matrycy w polu W×H (z ramką modułu)."""
    cols, rows = (16, 2) if style == "lcd1602" else (20, 4)
    dots_w, dots_h = cols * 6 - 1, rows * 9 - 1
    p = max(2.0, min(W * 0.90 / (dots_w + 6), H * 0.90 / (dots_h + 6)))
    mw, mh = (dots_w + 6) * p, (dots_h + 6) * p
    x0, y0 = (W - mw) / 2.0, (H - mh) / 2.0
    return cols, rows, p, x0, y0, mw, mh


def lcd_dots(grid, p, x0, y0):
    """[(x, y, rozmiar, zapalona)] — kropki matrycy."""
    out = []
    s = p * 0.86
    for r, row in enumerate(grid):
        for c, cell in enumerate(row):
            for dy in range(8):
                line = cell[dy]
                for dx in range(5):
                    x = x0 + (3 + c * 6 + dx) * p
                    y = y0 + (3 + r * 9 + dy) * p
                    out.append((x, y, s, line[dx] == "1"))
    return out


def _raster_png(W, H, rects, out, bg):
    """Prosta bitmapa z prostokątów (bez długiej listy poleceń dla ImageMagick)."""
    def rgb(c):
        return bytes(int(c[i:i + 2], 16) for i in (1, 3, 5))
    buf = bytearray(rgb(bg) * (W * H))
    for x0, y0, x1, y1, col in rects:
        x0, y0, x1, y1 = max(0, int(round(x0))), max(0, int(round(y0))), min(W, int(round(x1))), min(H, int(round(y1)))
        if x1 <= x0 or y1 <= y0:
            continue
        line = rgb(col) * (x1 - x0)
        for y in range(y0, y1):
            i = (y * W + x0) * 3
            buf[i:i + len(line)] = line
    subprocess.run(["convert", "ppm:-", "PNG24:" + out], input=b"P6 %d %d 255\n" % (W, H) + bytes(buf),
                   check=True, timeout=20)


def draw_lcd(style, t, W, out, color=None):
    color = color or read_lcd_color()
    bg, on, off = LCD_COLORS[color]
    H = int(W * (0.32 if style == "lcd1602" else 0.42))
    cols, rows, p, x0, y0, mw, mh = lcd_geometry(style, W, H)
    rects = [(x0 - p * 2, y0 - p * 2, x0 + mw + p * 2, y0 + mh + p * 2, LCD_PANEL[color]), (x0, y0, x0 + mw, y0 + mh, bg)]
    rects += [(x, y, x + sz, y + sz, on if lit else off)
              for x, y, sz, lit in lcd_dots(lcd_cells(style, t, True, read_weather()), p, x0, y0)]
    _raster_png(W, H, rects, out, BG)


def lcd_lit(grid):
    return [line[dx] == "1" for row in grid for cell in row for line in cell[:8] for dx in range(5)]


def run_anim(tk, parent, root, style, W, H, place, alive):
    """Animowany zegar na Canvas W×H; place(w, h) ustawia okno. Wraca, gdy zmieni się styl."""
    cv = tk.Canvas(parent, width=W, height=H, highlightthickness=0, borderwidth=0, cursor="none")

    def later(ms, fn):      # kolejna klatka tylko, dopóki ten wygląd jest na ekranie
        root.after(ms, lambda: fn() if alive() else None)
    cv.pack()
    place(W, H)
    aw, ah = ASPECT[style]

    def draw(rects, tag, sc, ox=0, oy=0, gap=0):
        cv.delete(tag)
        for x, y, w, h, c in rects:
            cv.create_rectangle(ox + x * sc, oy + y * sc, ox + (x + w) * sc - gap, oy + (y + h) * sc - gap,
                                fill=c, outline="", tags=tag)

    if style in ("snake", "platform"):
        sc = max(1, min(W // aw, H // ah))
        ox, oy = (W - aw * sc) // 2, (H - ah * sc) // 2
        if style == "snake":
            g = Snake()
            cv.configure(bg=SNK["bg"])
            gap = 1 if sc >= 4 else 0
            draw(g.background(), "bg", sc, ox, oy, gap)

            def frame():
                g.step()
                draw(g.rects(time.localtime()), "fg", sc, ox, oy, gap)
                later(140, frame)
        else:
            g = Platform()
            cv.configure(bg=PLT["sky"])
            draw(g.background(), "bg", sc, ox, oy)
            last = {"b": None, "h": None}

            def frame():
                g.update(time.localtime())
                bk = (tuple(g.shown), tuple(g.bump))
                if bk != last["b"]:
                    last["b"] = bk
                    draw(g.blocks(), "blk", sc, ox, oy)
                hk = (int(round(g.hx)), int(round(g.hy)), g.face)
                if hk != last["h"]:
                    last["h"] = hk
                    draw(g.hero(), "hero", sc, ox, oy)
                later(33, frame)
        frame()
    elif style in ("seg7", "volt", "analog"):
        cv.configure(bg=BG)
        info_h = int(H * (0.30 if H < W * 0.7 else 0.24))
        pt_date = max(10, int(min(H * 0.065, W * 0.035)))
        info = {"key": None, "img": None, "item": None}
        tmpd = tempfile.mkdtemp(prefix="kiosk-clock-")

        def draw_info():
            t = time.localtime()
            w = read_weather()
            key = (t.tm_yday, json.dumps(w, sort_keys=True))
            if key == info["key"]:
                return
            info["key"] = key
            path = os.path.join(tmpd, "info.png")
            try:
                render_info(path, t, pt_date, w)
                info["img"] = tk.PhotoImage(file=path)
                if info["item"] is None:
                    info["item"] = cv.create_image(W // 2, H - info_h, anchor="n", image=info["img"])
                else:
                    cv.itemconfigure(info["item"], image=info["img"])
            except Exception as e:
                print("data/pogoda: %s" % e, flush=True)

        avail_w, avail_h = W * 0.94, H - info_h - H * 0.06
        if style == "analog":
            # Tarcza ze wskazówkami rysowana co sekundę (ImageMagick — gładkie krawędzie).
            Hd = int(min(avail_w, avail_h) / 1.6)
            face = {"sec": None, "img": None, "item": None}
            fpath = os.path.join(tmpd, "analog.png")

            def frame():
                t = time.localtime()
                if t.tm_sec != face["sec"]:
                    face["sec"] = t.tm_sec
                    try:
                        draw_analog(t, Hd, fpath)
                        face["img"] = tk.PhotoImage(file=fpath)
                        if face["item"] is None:
                            face["item"] = cv.create_image(W // 2, (H - info_h) // 2, image=face["img"])
                        else:
                            cv.itemconfigure(face["item"], image=face["img"])
                    except Exception as e:
                        print("zegar analogowy: %s" % e, flush=True)
                    draw_info()
                later(100, frame)
        elif style == "seg7":
            _, uw, uh = seg7_shapes(time.localtime(), 100.0)
            Hd = min(avail_w / uw, avail_h / uh) * 100.0
            _, sw_, sh_ = seg7_shapes(time.localtime(), Hd)
            ox, oy = (W - sw_) / 2.0, (H - info_h - sh_) / 2.0
            polys = [cv.create_polygon(*[c for p in pts for c in (ox + p[0], oy + p[1])], fill=col, outline="")
                     for pts, col in seg7_shapes(time.localtime(), Hd)[0]]

            def frame():
                now = time.time()
                shapes = seg7_shapes(time.localtime(now), Hd, colon_on=(now % 1) < 0.5)[0]
                for it, (_, col) in zip(polys, shapes):
                    cv.itemconfigure(it, fill=col)
                draw_info()
                later(100, frame)
        else:
            # Tarcze rysuje ImageMagick raz (bez wskazówek), wskazówki Tk co 0,1 s — płynny ruch.
            Hd = min(avail_w / (3 * 1.6 + 2 * 0.14), avail_h / 1.07)
            path = os.path.join(tmpd, "faces.png")
            mw, mh, gap = draw_volt(time.localtime(), int(Hd), path, needles=False)
            faces = tk.PhotoImage(file=path)
            fw, fh = faces.width(), faces.height()
            ox, oy = (W - fw) // 2, (H - info_h - fh) // 2
            cv.create_image(ox, oy, anchor="nw", image=faces)
            cv.faces = faces
            pcx, pcy, plen = volt_geometry(mw, mh)
            nw = max(2, int(mw / 110))
            needles, caps = [], []
            for i in range(3):
                bx = ox + i * (mw + gap)
                needles.append((cv.create_line(0, 0, 1, 1, fill="#C8281E", width=nw, capstyle="round"), bx + pcx, oy + pcy))
                rr = mw / 28.0
                caps.append(cv.create_oval(bx + pcx - rr, oy + pcy - rr, bx + pcx + rr, oy + pcy + rr, fill="#2A2A2A", outline=""))

            def frame():
                for (it, cx, cy), (vmax, _, _), val in zip(needles, VOLT_METERS, volt_values(time.time())):
                    x1, y1 = _pt(cx, cy, plen, -45 + 90.0 * min(val, vmax) / vmax)
                    cv.coords(it, cx, cy, x1, y1)
                for c in caps:
                    cv.tag_raise(c)
                draw_info()
                later(100, frame)
        frame()
    elif style in ("lcd1602", "lcd2004"):
        color = read_lcd_color()
        bg, on, off = LCD_COLORS[color]
        cv.configure(bg=BG)
        cols, rows, p, x0, y0, mw, mh = lcd_geometry(style, W, H)
        cv.create_rectangle(x0 - p * 2, y0 - p * 2, x0 + mw + p * 2, y0 + mh + p * 2, fill=LCD_PANEL[color], outline="")
        cv.create_rectangle(x0, y0, x0 + mw, y0 + mh, fill=bg, outline="")
        lw = {"w": read_weather(), "t": time.time()}
        dots = lcd_dots(lcd_cells(style, time.localtime(), True, lw["w"]), p, x0, y0)
        items = [cv.create_rectangle(x, y, x + sz, y + sz, fill=on if lit else off, outline="") for x, y, sz, lit in dots]
        shown = [lit for _, _, _, lit in dots]

        def frame():
            now = time.time()
            if now - lw["t"] > 60:
                lw["w"], lw["t"] = read_weather(), now
            new = lcd_lit(lcd_cells(style, time.localtime(now), (now % 1) < 0.5, lw["w"]))
            for i, lit in enumerate(new):
                if lit != shown[i]:
                    shown[i] = lit
                    cv.itemconfigure(items[i], fill=on if lit else off)
            later(100, frame)
        frame()
    elif style == "c64":
        b = int(min(W, H) * 0.07)
        cv.configure(bg=C64["border"])
        cv.create_rectangle(b, b, W - b, H - b, fill=C64["screen"], outline="")
        lines = len(c64_lines(time.localtime(), True))
        fs = max(8, int(min((W - 2 * b) / 40 * 1.6, (H - 2 * b) / (lines + 1) / 1.25)))
        font = ("DejaVu Sans Mono", -fs, "bold")
        items = [cv.create_text(b + fs // 2, b + fs * 0.6 + i * fs * 1.22, anchor="nw", text="", fill=C64["ink"], font=font)
                 for i in range(lines)]

        def frame():
            now = time.time()
            for it, ln in zip(items, c64_lines(time.localtime(now), int(now * 2) % 2 == 0)):
                cv.itemconfigure(it, text=ln)
            later(250, frame)
        frame()
    elif style in ("eyes", "eyes_only"):
        cv.configure(bg=BG)
        cxs, cy, rx, ry = eyes_geometry(style, W, H)
        g = Eyes(style == "eyes")
        items = []
        for cx in cxs:
            row = []
            for kind, pts, col in eye_parts(cx, cy, rx, ry, 0, 0, 0.08):
                if kind == "oval":
                    row.append(cv.create_oval(*pts, fill=col, outline=""))
                elif kind == "poly":
                    row.append(cv.create_polygon(*pts, fill=col, outline=""))
                elif kind == "line":
                    row.append(cv.create_line(*pts, fill=col, width=max(2, int(rx * 0.06)), capstyle="round", smooth=True))
                else:
                    row.append(cv.create_oval(*pts, fill="", outline=col, width=max(2, int(rx * 0.07))))
            items.append(row)
        clock = None
        if style == "eyes":
            fs = max(12, int(min(H * 0.20, W * 0.16)))
            ty = cy + ry + (H - (cy + ry)) * 0.08
            clock = (cv.create_text(W // 2, ty, anchor="n", text="", fill=INK, font=("DejaVu Sans", -fs, "bold")),
                     cv.create_text(W // 2, ty + fs * 1.12, anchor="n", text="", fill=MUTED,
                                    font=("DejaVu Sans", -max(9, int(fs * 0.30)))))

        def frame():
            now = time.time()
            gx, gy, lid, dil = g.update(now)
            for cx, row in zip(cxs, items):
                for it, (kind, pts, _) in zip(row, eye_parts(cx, cy, rx, ry, gx, gy, lid, dil)):
                    cv.coords(it, *pts)
            if clock:
                tm, dt = eyes_clock_texts(time.localtime(now))
                cv.itemconfigure(clock[0], text=tm)
                cv.itemconfigure(clock[1], text=dt)
            later(33, frame)
        frame()
    else:  # bsod
        cv.configure(bg=BSOD["bg"])
        texts = bsod_texts(time.localtime())
        x0, top = W * 0.08, H * 0.07
        items, gaps = [], []
        for txt, size, _ in texts:
            fs = max(8, int(H * size))
            items.append(cv.create_text(x0, top, anchor="nw", text=txt, fill=BSOD["ink"], width=W * 0.84,
                                        font=("DejaVu Sans", -fs, "bold" if size > 0.12 else "normal")))
            gaps.append(int(fs * 0.35))

        def layout():
            # Każdy napis pod poprzednim, wg jego rzeczywistej wysokości (dłuższe zdanie
            # zawija się do dwóch linii i nie może nachodzić na następne).
            y = top
            for it, g in zip(items, gaps):
                cv.coords(it, x0, y)
                bb = cv.bbox(it)
                y = (bb[3] if bb else y) + g

        def frame():
            for it, (txt, _, _) in zip(items, bsod_texts(time.localtime())):
                cv.itemconfigure(it, text=txt)
            layout()
            later(1000, frame)
        frame()



def date_text(t):
    return "%s, %d %s" % (DAYS[t.tm_wday], t.tm_mday, MONTHS[t.tm_mon - 1])


def render_info(out, t, pt_date, weather):
    """Sama data i pogoda (pod zegarem animowanym)."""
    core = ["(", "-background", BG, "-fill", MUTED, "-font", FONT, "-pointsize", str(pt_date), "label:" + date_text(t), ")"]
    if weather:
        pt_w = int(pt_date * 1.15)
        temp = ("%d°C  " % round(weather["temp"])) if weather.get("temp") is not None else ""
        core += ["(", "-size", "1x%d" % max(4, pt_date // 3), "xc:" + BG, "+size", ")",
                 "(", "(", "-background", BG, "-fill", ICON_COLORS.get(weather.get("condition"), INK), "-font", FONT,
                 "-pointsize", str(int(pt_w * 1.2)), "label:" + weather.get("icon", "").replace("%", "%%") + " ", ")",
                 "(", "-background", BG, "-fill", INK, "-font", FONT_BOLD, "-pointsize", str(pt_w),
                 "label:" + temp.replace("%", "%%"), ")",
                 "(", "-background", BG, "-fill", MUTED, "-font", FONT, "-pointsize", str(pt_w),
                 "label:" + weather.get("text", "").replace("%", "%%"), ")",
                 "-background", BG, "-gravity", "center", "+append", ")"]
    _png(["convert", "-respect-parentheses"] + core + ["-background", BG, "-gravity", "center", "-append", "+repage",
                                                      "PNG24:" + out])


def render(out, t, pt_time, pt_date, box=None, weather=None, style="classic"):
    """Obraz zegara. box=(w,h) -> kafelek wypełniający pole, inaczej zwarta karta."""
    hhmm = time.strftime("%H:%M", t)
    timg = None
    if style in DRAW:
        timg = out + ".t.png"
        try:
            DRAW[style](t, int(pt_time * 0.95), timg)
        except Exception as e:
            print("zegar %s: %s — klasyczny" % (style, e), flush=True)
            timg = None
    first = ["(", timg, ")", "(", "-size", "1x%d" % max(4, pt_date // 2), "xc:" + BG, ")"] if timg else \
        ["(", "-background", BG, "-fill", INK, "-font", FONT_BOLD, "-pointsize", str(pt_time), "label:" + hhmm, ")"]
    core = first + [
            "(", "-background", BG, "-fill", MUTED, "-font", FONT, "-pointsize", str(pt_date),
            "label:" + date_text(t), ")"]
    if weather:
        pt_w = int(pt_date * 1.15)
        temp = ("%d°C  " % round(weather["temp"])) if weather.get("temp") is not None else ""
        icon_color = ICON_COLORS.get(weather.get("condition"), INK)
        core += ["(", "-size", "1x%d" % max(4, pt_date // 3), "xc:" + BG, "+size", ")",
                 "(", "(", "-background", BG, "-fill", icon_color, "-font", FONT, "-pointsize", str(int(pt_w * 1.2)),
                 "label:" + weather.get("icon", "").replace("%", "%%") + " ", ")",
                 "(", "-background", BG, "-fill", INK, "-font", FONT_BOLD, "-pointsize", str(pt_w),
                 "label:" + temp.replace("%", "%%"), ")",
                 "(", "-background", BG, "-fill", MUTED, "-font", FONT, "-pointsize", str(pt_w),
                 "label:" + weather.get("text", "").replace("%", "%%"), ")",
                 "-background", BG, "-gravity", "center", "+append", ")"]
    core += ["-background", BG, "-gravity", "center", "-append"]
    if box:
        w, h = box
        cmd = ["convert", "("] + core + ["-resize", "%dx%d>" % (int(w * 0.92), int(h * 0.92)), ")",
               "-size", "%dx%d" % (w, h), "xc:" + BG, "+swap",
               "-gravity", "center", "-composite",
               "-fill", "none", "-stroke", LINE, "-strokewidth", "2",
               "-draw", "rectangle 1,1 %d,%d" % (w - 2, h - 2), "PNG24:" + out]
    else:
        pad = max(8, pt_time // 4)
        cmd = ["convert"] + core + ["-bordercolor", BG, "-border", "%dx%d" % (pad * 2, pad),
                                    "-bordercolor", LINE, "-border", "2", "PNG24:" + out]
    try:
        subprocess.run(["convert", "-respect-parentheses"] + cmd[1:], check=True, timeout=20)
    finally:
        if timg and os.path.exists(timg):
            os.unlink(timg)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--corner", default="tr", choices=["tl", "tr", "bl", "br"])
    ap.add_argument("--size", default="m", choices=list(SIZES))
    ap.add_argument("--geometry", help="WxH+X+Y — kafelek w polu siatki")
    ap.add_argument("--area", help="WxH+X+Y — monitor, w którego rogu stoi nakładka")
    ap.add_argument("--preview", help="zapisz sam obrazek do pliku PNG i zakończ")
    ap.add_argument("--style", choices=STYLES, help="wygląd (domyślnie z clock.json)")
    a = ap.parse_args()
    if a.preview:
        st = a.style or read_style()
        if st in ANIM:
            preview_anim(st, time.localtime(), a.preview)
        else:
            render(a.preview, time.localtime(), 64, 18, None, None, st)
        return
    import tkinter as tk

    root = tk.Tk()
    root.configure(cursor="none")   # bez kursora myszy na ekranie kiosku
    root.overrideredirect(True)
    root.configure(bg=BG)
    sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
    ox = oy = 0
    if a.area:
        try:
            awh, ox, oy = a.area.split("+")[0], int(a.area.split("+")[1]), int(a.area.split("+")[2])
            sw, sh = map(int, awh.split("x"))
        except (ValueError, IndexError):
            ox = oy = 0
    box = None
    if a.geometry:
        wh, x, y = a.geometry.split("+", 1)[0], *map(int, a.geometry.split("+")[1:3])
        w, h = map(int, wh.split("x"))
        box = (w, h)
        pt_time = int(min(w * 0.26, h * 0.34))
        pt_date = max(12, int(pt_time * 0.22))
    else:
        pt_time = int(sh * SIZES[a.size])
        pt_date = max(12, int(pt_time * 0.33))
    margin = int(sh * 0.025)
    holder = tk.Frame(root, bg=BG, highlightthickness=0, borderwidth=0, cursor="none")
    holder.pack()
    state = {"gen": 0, "style": None, "img": None, "minute": None}

    def place(w, h):
        if box:
            root.geometry("%dx%d+%d+%d" % (w, h, x, y))
        else:
            gx = ox + (margin if a.corner in ("tl", "bl") else sw - w - margin)
            gy = oy + (margin if a.corner in ("tl", "tr") else sh - h - margin)
            root.geometry("%dx%d+%d+%d" % (w, h, gx, gy))

    def weather_key():
        try:
            return os.stat(WEATHER_CACHE).st_mtime
        except OSError:
            return None

    def start(style):
        """Nowy wygląd w tym samym oknie — okno nie znika, więc nie widać logo pod spodem."""
        state["gen"] += 1
        gen = state["gen"]
        alive = lambda: state["gen"] == gen
        for w in holder.winfo_children():
            w.destroy()
        state["minute"] = None
        if style in ANIM:
            aw, ah = ASPECT[style]
            cw, chh = box if box else (int(pt_time * 4.6), int(pt_time * 4.6 * ah / aw))
            run_anim(tk, holder, root, style, cw, chh, place, alive)
            return
        label = tk.Label(holder, borderwidth=0, highlightthickness=0, bg=BG)
        label.pack()

        def tick():
            if not alive():
                return
            t = time.localtime()
            key = (t.tm_year, t.tm_yday, t.tm_hour, t.tm_min, weather_key())
            if key != state["minute"]:
                fd, png = tempfile.mkstemp(suffix=".png", prefix="kiosk-clock-")
                os.close(fd)
                try:
                    render(png, t, pt_time, pt_date, box, read_weather(), style)
                    img = tk.PhotoImage(file=png)
                finally:
                    os.unlink(png)
                label.configure(image=img)
                state["img"], state["minute"] = img, key
                place(img.width(), img.height())
            root.after(1000, tick)
        tick()

    def watch():
        st = a.style or read_style()
        if st.startswith("lcd"):
            st += ":" + read_lcd_color()     # zmiana podświetlenia LCD = nowy wygląd
        if st != state["style"]:
            state["style"] = st
            start(st.split(":")[0])
        if not box:
            root.lift()     # nakładka w rogu nad kamerami/stroną; pełny ekran nie przykrywa ikon stanu
        root.after(1000, watch)

    watch()
    root.mainloop()


if __name__ == "__main__":
    main()
