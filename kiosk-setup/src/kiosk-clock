# --- oczy: para oczu, które rozglądają się i mrugają (eyes — z godziną pod spodem, eyes_only — same oczy)
EYE = {"white": "#F2EFE6", "iris": "#2FA3C4", "iris2": "#1B6F87", "pupil": "#0A0D10", "lid": "#1A2129",
       "line": "#05070A", "shine": "#FFFFFF"}


def eyes_geometry(style, W, H):
    """Środki i promienie obu oczu oraz pole na godzinę (eyes)."""
    eh = H * (0.62 if style == "eyes" else 0.92)
    rx = min(W * 0.20, eh * 0.42)
    ry = rx * 1.12
    cy = (H * 0.06 + ry) if style == "eyes" else H / 2.0
    gap = rx * 0.42
    cxs = (W / 2.0 - gap / 2.0 - rx, W / 2.0 + gap / 2.0 + rx)
    return cxs, cy, rx, ry


def eye_parts(cx, cy, rx, ry, gx, gy, lid, dil=1.0):
    """Kształty jednego oka: [(rodzaj, punkty/prostokąt, kolor)]. gx, gy w -1..1, lid 0 (otwarte)..1 (zamknięte)."""
    ri = min(rx, ry) * 0.48
    rp = ri * 0.48 * dil
    ix = cx + gx * (rx - ri) * 0.80
    iy = cy + gy * (ry - ri) * 0.80
    out = [("oval", (cx - rx, cy - ry, cx + rx, cy + ry), EYE["white"]),
           ("oval", (ix - ri, iy - ri, ix + ri, iy + ri), EYE["iris2"]),
           ("oval", (ix - ri * 0.82, iy - ri * 0.82, ix + ri * 0.82, iy + ri * 0.82), EYE["iris"]),
           ("oval", (ix - rp, iy - rp, ix + rp, iy + rp), EYE["pupil"]),
           ("oval", (ix - ri * 0.42 - rp * 0.32, iy - ri * 0.42 - rp * 0.32, ix - ri * 0.42 + rp * 0.32, iy - ri * 0.42 + rp * 0.32), EYE["shine"])]
    n = 24
    top = []
    edge = []
    for i in range(n + 1):
        u = -1 + 2.0 * i / n
        h = math.sqrt(max(0.0, 1 - u * u))
        top.append((cx + u * rx, cy - ry * h))
        edge.append((cx + u * rx, cy + (-1 + 2 * lid) * ry * h))
    poly = top + edge[::-1]
    out.append(("poly", [c for pt in poly for c in pt], EYE["lid"]))
    out.append(("line", [c for pt in edge for c in pt], EYE["line"]))
    out.append(("ring", (cx - rx, cy - ry, cx + rx, cy + ry), EYE["line"]))
    return out


class Eyes:
    """Ruch oczu: skoki spojrzenia w losowe miejsca, mruganie, zerknięcie na zegar przy zmianie minuty."""

    def __init__(self, with_clock):
        import random
        self.r = random.Random()
        self.with_clock = with_clock
        self.gx = self.gy = 0.0
        self.tx = self.ty = 0.0
        self.next_look = 0.0
        self.lid = 0.08
        self.blink_at = time.time() + 2.0
        self.blink_t0 = None
        self.double = False
        self.minute = time.localtime().tm_min
        self.dil = 1.0

    def update(self, now):
        r = self.r
        t = time.localtime(now)
        if self.with_clock and t.tm_min != self.minute:
            self.minute = t.tm_min
            self.tx, self.ty = 0.0, 0.95          # zerknij na godzinę
            self.next_look = now + 2.2
            self.blink_at = min(self.blink_at, now + 0.6)
        if now >= self.next_look:
            if r.random() < 0.25:
                self.tx, self.ty = r.uniform(-0.15, 0.15), r.uniform(-0.1, 0.15)
            else:
                self.tx, self.ty = r.uniform(-1, 1), r.uniform(-0.85, 0.85)
            self.next_look = now + r.uniform(0.7, 3.2)
        k = 0.32                                    # szybki skok, potem spoczynek
        self.gx += (self.tx - self.gx) * k
        self.gy += (self.ty - self.gy) * k
        self.dil = 1.0 + 0.10 * math.sin(now * 0.7)
        if self.blink_t0 is None and now >= self.blink_at:
            self.blink_t0 = now
        if self.blink_t0 is not None:
            p = (now - self.blink_t0) / 0.22       # 0..1 zamykanie i otwieranie
            if p >= 1:
                self.blink_t0 = None
                self.lid = 0.08
                if not self.double and r.random() < 0.18:
                    self.double = True
                    self.blink_at = now + 0.12
                else:
                    self.double = False
                    self.blink_at = now + r.uniform(2.5, 6.5)
            else:
                self.lid = 0.08 + 0.92 * (1 - abs(1 - 2 * p))
        return self.gx, self.gy, self.lid, self.dil


def eyes_clock_texts(t):
    return time.strftime("%H:%M", t), date_text(t)


def preview_eyes(style, t, out, width=360):
    aw, ah = ASPECT[style]
    W, H = width, int(width * ah / aw)
    mvg = ["stroke none"]
    cxs, cy, rx, ry = eyes_geometry(style, W, H)
    for i, cx in enumerate(cxs):
        for kind, pts, col in eye_parts(cx, cy, rx, ry, 0.35, 0.25, 0.12):
            if kind == "oval":
                x0, y0, x1, y1 = pts
                mvg += ["fill '%s'" % col, "stroke none", "ellipse %.1f,%.1f %.1f,%.1f 0,360" % ((x0 + x1) / 2, (y0 + y1) / 2, (x1 - x0) / 2, (y1 - y0) / 2)]
            elif kind == "poly":
                mvg += ["fill '%s'" % col, "stroke none", "polygon " + " ".join("%.1f,%.1f" % (pts[j], pts[j + 1]) for j in range(0, len(pts), 2))]
            elif kind == "line":
                mvg += ["fill none", "stroke '%s'" % col, "stroke-width %.1f" % max(1.5, rx * 0.06),
                        "polyline " + " ".join("%.1f,%.1f" % (pts[j], pts[j + 1]) for j in range(0, len(pts), 2))]
            else:
                x0, y0, x1, y1 = pts
                mvg += ["fill none", "stroke '%s'" % col, "stroke-width %.1f" % max(1.5, rx * 0.07),
                        "ellipse %.1f,%.1f %.1f,%.1f 0,360" % ((x0 + x1) / 2, (y0 + y1) / 2, (x1 - x0) / 2, (y1 - y0) / 2)]
    if style == "eyes":
        tm, dt = eyes_clock_texts(t)
        fs = int(H * 0.20)
        mvg += ["stroke none", "fill '%s'" % INK, "font '%s'" % FONT_BOLD, "font-size %d" % fs, "gravity north",
                "text 0,%d '%s'" % (int(H * 0.66), tm), "fill '%s'" % MUTED, "font '%s'" % FONT,
                "font-size %d" % int(H * 0.065), "text 0,%d '%s'" % (int(H * 0.66 + fs * 1.05), dt)]
    _png(["convert", "-size", "%dx%d" % (W, H), "xc:" + BG, "-draw", "\n".join(mvg), "PNG24:" + out])


def preview_anim(style, t, out, width=360):
    """Statyczny kadr do podglądu w panelu (ImageMagick)."""
    if style in ("eyes", "eyes_only"):
        preview_eyes(style, t, out, width)
        return
    if style in ("seg7", "volt", "analog"):
        render(out, t, 64, 18, None, None, style)
        return
    if style in ("lcd1602", "lcd2004"):
        draw_lcd(style, t, width, out)
        return
    aw, ah = ASPECT[style]
    if style in ("snake", "platform"):
        sc = max(1, width // aw)
        if style == "snake":
            g = Snake()
            g.length = 12
            g.pos = 20
            g.apple = 30
            rects = g.background() + g.rects(t)
            bg = SNK["bg"]
        else:
            g = Platform()
            g.shown = list(g.digits(t))
            g.hx, g.hy = g.bx[3] + 3, -9
            rects = g.background() + g.blocks() + g.hero()
            bg = PLT["sky"]
        mvg = ["stroke none"]
        for x, y, w, h, c in rects:
            gap = 1 if style == "snake" and sc >= 4 else 0
            mvg += ["fill '%s'" % c, "rectangle %d,%d %d,%d" % (x * sc, y * sc, (x + w) * sc - 1 - gap, (y + h) * sc - 1 - gap)]
        _png(["convert", "-size", "%dx%d" % (aw * sc, ah * sc), "xc:" + bg, "-draw", "\n".join(mvg), "PNG24:" + out])
        return
    W, H = width, int(width * ah / aw)
    if style == "c64":
        b = int(W * 0.06)
        fs = max(8, int((W - 2 * b) / 40 * 1.75))
        mvg = ["fill '%s'" % C64["screen"], "rectangle %d,%d %d,%d" % (b, b, W - b, H - b),
               "fill '%s'" % C64["ink"], "font '%s'" % MONO_BOLD, "font-size %d" % fs]
        for i, ln in enumerate(c64_lines(t, True)):
            if ln:
                mvg.append("text %d,%d '%s'" % (b + 4, b + (i + 1) * fs * 1.12, ln.replace("'", "")))
        _png(["convert", "-size", "%dx%d" % (W, H), "xc:" + C64["border"], "-draw", "\n".join(mvg), "PNG24:" + out])
        return
    mvg = ["fill '%s'" % BSOD["ink"]]
    y = H * 0.04
    for txt, size, _ in bsod_texts(t):
        fs = max(8, int(H * size))
        mvg += ["font '%s'" % (FONT_BOLD if size > 0.12 else FONT), "font-size %d" % fs,
                "text %d,%d '%s'" % (W * 0.08, y + fs, txt.replace("'", ""))]
        y += fs * 1.25
    _png(["convert", "-size", "%dx%d" % (W, H), "xc:" + BSOD["bg"], "-draw", "\n".join(mvg), "PNG24:" + out])


