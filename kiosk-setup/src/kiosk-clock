SNK = {"bg": "#0B140E", "grid": "#122017", "digit": "#7BD88F", "snake": "#3DDC84", "head": "#C8FAD6",
       "apple": "#FF4D2E"}


class Snake:
    W, H = ASPECT["snake"]

    def __init__(self):
        import random
        self.rnd = random.Random()
        ring = [(x, 1) for x in range(1, self.W - 1)] + [(self.W - 2, y) for y in range(2, self.H - 1)] + \
               [(x, self.H - 2) for x in range(self.W - 3, 0, -1)] + [(1, y) for y in range(self.H - 3, 1, -1)]
        self.ring = ring
        self.pos = 0
        self.length = 6
        self.apple = self.rnd.randrange(len(ring))

    def step(self):
        self.pos = (self.pos + 1) % len(self.ring)
        if self.pos == self.apple:
            self.length += 3
            if self.length > 40:
                self.length = 6
            self.apple = (self.pos + self.rnd.randrange(12, len(self.ring) - 4)) % len(self.ring)

    def rects(self, t):
        out = []
        txt = time.strftime("%H:%M", t)
        tw = text_width(txt, 1)
        out += font_rects(txt, (self.W - tw) // 2, (self.H - 7) // 2, 1, SNK["digit"])
        ax, ay = self.ring[self.apple]
        out.append((ax, ay, 1, 1, SNK["apple"]))
        for i in range(self.length):
            x, y = self.ring[(self.pos - i) % len(self.ring)]
            out.append((x, y, 1, 1, SNK["head"] if i == 0 else SNK["snake"]))
        return out

    def background(self):
        return [(x, y, 1, 1, SNK["grid"]) for x in range(self.W) for y in range(self.H)]


# --- platformówka
PLT = {"sky": "#0E1622", "star": "#3B4B63", "brick": "#7A3E1E", "brick2": "#5C2D15", "mortar": "#2A160B",
       "block": "#2E7D8C", "block_hi": "#4FB3C2", "block_lo": "#1B4E58", "digit": "#F3F5F7"}


class Platform:
    W, H = ASPECT["platform"]
    GROUND = 56
    BW, BH, BY = 16, 20, 12

    def __init__(self):
        import random
        self.rnd = random.Random()
        xs, x = [], 9
        for i in range(4):
            xs.append(x)
            x += self.BW + (12 if i == 1 else 4)
        self.bx = xs
        self.colon_x = xs[1] + self.BW + 4
        self.shown = None
        self.queue = []
        self.hx, self.hy, self.vy = 4.0, 0.0, 0.0
        self.face = 1
        self.target = 40.0
        self.bump = [0, 0, 0, 0]
        self.hit_done = False
        self.idle_t = time.time() + 3

    def digits(self, t):
        return time.strftime("%H%M", t)

    def update(self, t):
        d = self.digits(t)
        if self.shown is None:
            self.shown = list(d)
        changed = [i for i in range(4) if self.shown[i] != d[i] and i not in self.queue]
        for i in sorted(changed, reverse=True):     # od minut: najczęściej zmienia się ostatnia cyfra
            self.queue.append(i)
        if self.queue:
            self.target = self.bx[self.queue[0]] + self.BW / 2.0 - 5
        elif time.time() > self.idle_t:
            self.target = float(self.rnd.randrange(2, self.W - 12))
            self.idle_t = time.time() + self.rnd.uniform(3, 8)
        on_ground = self.hy >= 0 and self.vy == 0
        if on_ground:
            dx = self.target - self.hx
            if abs(dx) > 0.6:
                self.face = 1 if dx > 0 else -1
                self.hx += 0.6 * self.face
            elif self.queue:
                self.vy, self.hit_done = -3.6, False
            elif self.rnd.random() < 0.004:
                self.vy, self.hit_done = -2.2, True
        else:
            self.hy += self.vy
            self.vy += 0.22
            head = self.GROUND - 11 + self.hy
            if self.queue and not self.hit_done and self.vy < 0 and head <= self.BY + self.BH:
                i = self.queue.pop(0)
                self.shown[i] = d[i]
                self.bump[i] = 6
                self.hit_done = True
                self.vy = 0.8
            if self.hy >= 0:
                self.hy, self.vy = 0.0, 0.0
        self.bump = [max(0, b - 1) for b in self.bump]

    def background(self):
        out = []
        for i in range(26):
            out.append(((i * 37) % self.W, (i * 23) % (self.GROUND - 30), 1, 1, PLT["star"]))
        for y in range(self.GROUND, self.H, 4):
            off = 0 if (y // 4) % 2 == 0 else 4
            out.append((0, y, self.W, 4, PLT["mortar"]))
            for x in range(-off, self.W, 8):
                out.append((x, y, 7, 3, PLT["brick"] if (x // 8) % 3 else PLT["brick2"]))
        return out

    def blocks(self):
        out = []
        for i, x in enumerate(self.bx):
            y = self.BY - (2 if self.bump[i] > 2 else (1 if self.bump[i] else 0))
            out += [(x, y, self.BW, self.BH, PLT["block_lo"]), (x, y, self.BW - 1, self.BH - 1, PLT["block_hi"]),
                    (x + 1, y + 1, self.BW - 2, self.BH - 2, PLT["block"])]
            for cx, cy in ((1, 1), (self.BW - 3, 1), (1, self.BH - 3), (self.BW - 3, self.BH - 3)):
                out.append((x + cx + 0.5, y + cy + 0.5, 1, 1, PLT["block_lo"]))
            out += font_rects(self.shown[i] if self.shown else "0", x + 3, y + 3, 2, PLT["digit"])
        for cy in (self.BY + 6, self.BY + 13):
            out.append((self.colon_x, cy, 2, 2, PLT["digit"]))
        return out

    def hero(self):
        out = []
        top = self.GROUND - 11 + int(round(self.hy))
        left = int(round(self.hx))
        for ry, row in enumerate(HERO):
            for rx, ch in enumerate(row):
                if ch != ".":
                    x = rx if self.face > 0 else len(row) - 1 - rx
                    out.append((left + x, top + ry, 1, 1, HERO_C[ch]))
        return out


