#!/bin/bash
# Jak działa ekran kiosku (wywołuje pakiet i "sudo kiosk-mode session ...").
#   kiosk-session-mode kiosk   UŻYTKOWNIK  - cały komputer jako kiosk: tryb tekstowy,
#                                            autologin na tty1 i startx (bez pulpitu)
#   kiosk-session-mode desktop UŻYTKOWNIK  - pulpit (XFCE) na monitorze głównym,
#                                            kiosk na drugim wyjściu
#   kiosk-session-mode autologin yes|no UŻYTKOWNIK
#                                          - pulpit: automatyczne logowanie (kiosk
#                                            startuje sam) albo ekran logowania z hasłem
#   kiosk-session-mode desktop-session NAZWA|auto UŻYTKOWNIK
#                                          - który pulpit (sesja X11 z /usr/share/xsessions:
#                                            cinnamon, xfce, plasma, …); auto = ostatnio używany
#   kiosk-session-mode list-sessions       - zainstalowane pulpity (nazwa<TAB>opis)
set -e
[ "$EUID" -eq 0 ] || { echo "Uruchom jako root." >&2; exit 1; }
XS=/usr/share/xsessions
if [ "${1:-}" = list-sessions ]; then
    for f in "$XS"/*.desktop; do
        [ -e "$f" ] || continue
        printf '%s\t%s\n' "$(basename "$f" .desktop)" "$(sed -n 's/^Name=//p' "$f" | head -n 1)"
    done
    exit 0
fi
AUTO=""; DESK=""
if [ "${1:-}" = autologin ]; then
    case "${2:-}" in yes|no) AUTO=$2 ;; *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;; esac
    U=${3:-}; MODE=""
elif [ "${1:-}" = desktop-session ]; then
    DESK=${2:-}
    if [ "$DESK" != auto ] && { ! [[ "$DESK" =~ ^[A-Za-z0-9._-]+$ ]] || [ ! -f "$XS/$DESK.desktop" ]; }; then
        echo "Nie ma pulpitu '$DESK'. Zainstalowane: $(ls "$XS" 2>/dev/null | sed 's/\.desktop$//' | tr '\n' ' ')" >&2
        exit 1
    fi
    U=${3:-}; MODE=""
else
    MODE=${1:-}; U=${2:-}
fi
case "$MODE" in kiosk|desktop|"") ;; *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;; esac
id "$U" >/dev/null 2>&1 || { echo "Nie ma użytkownika '$U'." >&2; exit 1; }
H=$(getent passwd "$U" | cut -d: -f6)
G=$(id -gn "$U")

DM=""
[ -r /etc/X11/default-display-manager ] && DM=$(basename "$(cat /etc/X11/default-display-manager)")
KIOSK_SESSION=kiosk; KIOSK_AUTOLOGIN=yes; KIOSK_DESKTOP=""
[ -r /etc/kiosk-setup/session.conf ] && . /etc/kiosk-setup/session.conf
if [ -z "$KIOSK_DESKTOP" ]; then
    # Starsze wersje: pulpit ustawiony ręcznie w pliku LightDM zostaje.
    KIOSK_DESKTOP=$(sed -n 's/^autologin-session=//p' /etc/lightdm/lightdm.conf.d/50-kiosk-setup.conf 2>/dev/null | head -n 1)
    KIOSK_DESKTOP=${KIOSK_DESKTOP:-auto}
fi
[ -n "$DESK" ] && KIOSK_DESKTOP=$DESK
[ -n "$MODE" ] || MODE=$KIOSK_SESSION
[ -n "$AUTO" ] || AUTO=$KIOSK_AUTOLOGIN
[ "$AUTO" = no ] || AUTO=yes
if [ "$MODE" = desktop ] && [ -z "$DM" ]; then
    echo "UWAGA: brak menedżera logowania (LightDM/GDM/SDDM) — pulpit niedostępny, zostaje pełny kiosk." >&2
    echo "       Zainstaluj pulpit (np. sudo apt install xubuntu-core) i wybierz tryb ponownie." >&2
    MODE=kiosk
fi

mkdir -p /etc/kiosk-setup
printf 'KIOSK_SESSION=%s\nKIOSK_AUTOLOGIN=%s\nKIOSK_DESKTOP=%s\n' "$MODE" "$AUTO" "$KIOSK_DESKTOP" > /etc/kiosk-setup/session.conf
chmod 0644 /etc/kiosk-setup/session.conf

BP="$H/.bash_profile"
AUTOSTART="$H/.config/autostart/kiosk-setup.desktop"
GETTY=/etc/systemd/system/getty@tty1.service.d/override.conf

LDM=/etc/lightdm/lightdm.conf.d/50-kiosk-setup.conf
SDDM=/etc/sddm.conf.d/50-kiosk-setup.conf
GDM=/etc/gdm3/custom.conf

# Pulpit do automatycznego logowania: wybrany, albo ostatnio używany przez
# użytkownika (AccountsService / ~/.dmrc), albo pierwszy znany zainstalowany.
pick_session() {
    local s=""
    if [ "$KIOSK_DESKTOP" != auto ] && [ -f "$XS/$KIOSK_DESKTOP.desktop" ]; then echo "$KIOSK_DESKTOP"; return; fi
    s=$(sed -n 's/^XSession=//p' "/var/lib/AccountsService/users/$U" 2>/dev/null | head -n 1)
    [ -n "$s" ] || s=$(sed -n 's/^Session=//p' "$H/.dmrc" 2>/dev/null | head -n 1)
    if [ -n "$s" ] && [ -f "$XS/$s.desktop" ]; then echo "$s"; return; fi
    for s in cinnamon xubuntu xfce plasmax11 plasma mate lxqt; do
        [ -f "$XS/$s.desktop" ] && { echo "$s"; return; }
    done
    ls "$XS" 2>/dev/null | sed -n 's/\.desktop$//p' | head -n 1
}

# Automatyczne logowanie do pulpitu (kiosk wstaje sam po włączeniu prądu)
# albo zwykły ekran logowania z hasłem.
set_autologin() {
    local on=$1 SESSION="" s
    rm -f "$LDM" "$SDDM"
    [ -f "$GDM" ] && sed -i "/^AutomaticLoginEnable=true$/d;/^AutomaticLogin=$U$/d" "$GDM"
    if [ "$on" != yes ]; then
        echo "    Pulpit: ekran logowania z hasłem (kiosk ruszy po zalogowaniu $U)"
        return 0
    fi
    SESSION=$(pick_session)
    case "$DM" in
        lightdm)
            mkdir -p "$(dirname "$LDM")"
            {
                echo "# kiosk-setup: autologin do pulpitu (tryb pulpit + kiosk)"
                echo "[Seat:*]"
                echo "autologin-user=$U"
                echo "autologin-user-timeout=0"
                [ -n "$SESSION" ] && echo "autologin-session=$SESSION"
            } > "$LDM"
            getent group autologin >/dev/null && usermod -aG autologin "$U"
            echo "    LightDM: automatyczne logowanie $U${SESSION:+ (sesja $SESSION)}" ;;
        gdm3)
            if [ -f "$GDM" ]; then
                grep -q '^\[daemon\]' "$GDM" || echo "[daemon]" >> "$GDM"
                sed -i "/^\[daemon\]/a AutomaticLoginEnable=true\nAutomaticLogin=$U" "$GDM"
                echo "    GDM: automatyczne logowanie $U"
            fi ;;
        sddm)
            mkdir -p "$(dirname "$SDDM")"
            printf '[Autologin]\nUser=%s\n%s' "$U" "${SESSION:+Session=$SESSION.desktop
}" > "$SDDM"
            echo "    SDDM: automatyczne logowanie $U" ;;
        *)  echo "    UWAGA: nieznany menedżer logowania '$DM' — włącz automatyczne logowanie $U ręcznie." >&2 ;;
    esac
}

if [ "${1:-}" = autologin ] || [ "${1:-}" = desktop-session ]; then
    if [ "$MODE" = desktop ]; then set_autologin "$AUTO"; else echo "    Zapisano (zadziała w trybie pulpit + kiosk)."; fi
    if [ "${1:-}" = desktop-session ] && [ "$AUTO" != yes ]; then
        echo "    Przy logowaniu z hasłem pulpit wybierasz na ekranie logowania."
    fi
    echo "    Zmiana zadziała po ponownym uruchomieniu komputera (sudo reboot)."
    exit 0
fi

if [ "$MODE" = desktop ]; then
    echo "==> Pulpit na monitorze głównym, kiosk na drugim wyjściu"
    # Bez autologinu na tty1 i bez startx z .bash_profile.
    rm -f "$GETTY"; rmdir /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true
    if [ -f "$BP" ] && grep -q 'startx -- -quiet' "$BP"; then
        rm -f "$BP"
        if [ -f "$H/.bash_profile.przed-kioskiem" ]; then
            mv "$H/.bash_profile.przed-kioskiem" "$BP"
            echo "    Przywrócono Twój wcześniejszy ~/.bash_profile."
        fi
    fi
    # Kiosk startuje razem z sesją pulpitu.
    install -d -o "$U" -g "$G" "$H/.config" "$H/.config/autostart"
    cat > "$AUTOSTART" <<'EOF'
[Desktop Entry]
Type=Application
Name=Kiosk (drugi monitor)
Comment=kiosk-setup: kamery / strona na drugim monitorze
Exec=/usr/local/bin/kiosk-session
X-GNOME-Autostart-enabled=true
Hidden=false
NoDisplay=false
EOF
    chown "$U:$G" "$AUTOSTART"
    set_autologin "$AUTO"
    systemctl set-default graphical.target
    systemctl enable "$DM" >/dev/null 2>&1 || true
else
    echo "==> Cały komputer jako kiosk (bez pulpitu)"
    mkdir -p /etc/systemd/system/getty@tty1.service.d
    cat > "$GETTY" <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin $U --noclear --nonewline --noissue %I \$TERM
TTYVTDisallocate=no
EOF
    # Własny ~/.bash_profile użytkownika odkładamy (wraca po przejściu na pulpit).
    if [ -f "$BP" ] && ! grep -q 'startx -- -quiet' "$BP" && [ ! -e "$H/.bash_profile.przed-kioskiem" ]; then
        mv "$BP" "$H/.bash_profile.przed-kioskiem"
    fi
    cat > "$BP" <<'EOF'
[ -f ~/.profile ] && . ~/.profile
if [ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
    # Pętla: po awarii X lub "sudo kiosk-mode restart" kiosk wstaje sam.
    while true; do
        startx -- -quiet > /dev/null 2>&1
        sleep 2
    done
fi
EOF
    chown "$U:$G" "$BP"
    rm -f "$AUTOSTART" "$LDM" "$SDDM"
    [ -f "$GDM" ] && sed -i "/^AutomaticLoginEnable=true$/d;/^AutomaticLogin=$U$/d" "$GDM"
    systemctl set-default multi-user.target
fi
systemctl daemon-reload
echo "    Zmiana zadziała po ponownym uruchomieniu komputera (sudo reboot)."
